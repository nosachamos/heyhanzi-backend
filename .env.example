# Optional local overrides; make dev-up creates .env if missing.
# Separate local ports allow sibling projects to run together.
BACKEND_PORT=8002
POSTGRES_PORT=5433
# Host Python/Alembic connection. Compose always uses its own postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/heyhanzi-dev?sslmode=disable
DATABASE_NAME=heyhanzi-dev
APP_BASE_URL=https://local.heyhanzi.com:3002
# Additional exact origins, comma separated; no wildcard with credentials.
CORS_ORIGINS=https://localhost:3002,http://localhost:3002
HEYHANZI_DB_POOL_SIZE=2
HEYHANZI_DB_MAX_OVERFLOW=1
LOG_LEVEL=INFO

# make dev-up / make env generates three unique AUTH_* keys in the ignored .env.
# Never reuse these application keys between local development and production.
# AUTH_SECRET_KEY, AUTH_AUDIT_HASH_SECRET, AUTH_TOKEN_ENCRYPTION_KEY

# Auth cookies need frontend/API hosts on the same site.
BACKEND_URL=https://local-api.heyhanzi.com:8002
EMAIL_PROVIDER=smtp_capture
SMTP_HOST=localhost
SMTP_PORT=1026
EMAIL_FROM_EMAIL=no-reply@heyhanzi.com
EMAIL_FROM_NAME=HeyHanzi

# Configure separate provider applications and exact /auth/{provider}/callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# HeyHanzi-only Stripe credentials. Never reuse another app's billing configuration.
STRIPE_SECRET_KEY=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# Backend-only Turnstile. Production always requires verification and ignores Enabled=false.
TURNSTILE_SITE_KEY=0x4AAAAAAFXDb-7GCpI0KVvd
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=heyhanzi.com
# Local DEV/TEST defaults to disabled; use a separate test widget to exercise it.
TURNSTILE_ENABLED=false

# Verified accounts with the shared admin role for all development dashboards.
# Comma-separated emails; empty disables admin access.
ADMIN_EMAILS=
