            "kind": "production",
            "response": "spoken",
            "prompt": "Mediate the familiar request for help. Clarify what is requested, restate each concern and propose a next step that does not pretend the disagreement has vanished.",
            "promptLanguage": "en",
            "context": "A asks a companion to explain a message today, worrying that an unanswered message will be misunderstood. B worries that the task may require knowledge they lack and has not agreed. It is unclear which part needs explaining. Clarify the request, restate both concerns, and propose checking that part first; no agreement to complete the whole task exists.\nFamiliar meanings available: occasion; setting; to call; to address as; to request help; to appeal; explanation; to explain.",
            "contextLanguage": "en",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I clarified the actual request and both concerns."
              },
              {
                "id": "r2",
                "text": "My proposal addresses the concerns and acknowledges what remains unresolved."
              }
            ]
          }
        ],
        "sequential": true
      }
