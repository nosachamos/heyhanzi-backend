        "blocks": [
          {
            "text": "节 counts class periods or segments. It measures a lesson period rather than the people attending it.",
            "examples": [
              {
                "text": "今天有三节课。",
                "pinyin": "jīntiān yǒu sān jié kè 。",
                "meaning": "There are three class periods today.",
                "audio": "35be8576228740bde22fed20a53c9b483f54a54146a18f997a2f36a0a27ef0cd"
              },
              {
                "text": "下一节课是中文课。",
                "pinyin": "xià yī jié kè shì Zhōngwén kè 。",
                "meaning": "The next class period is Chinese.",
