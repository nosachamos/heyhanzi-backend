        "kind": "teach",
        "title": "alternative + 也好",
        "blocks": [
          {
            "text": "也好 accepts an option as workable without necessarily preferring it. Paired options lead to the same following conclusion.",
            "examples": [
              {
                "text": "明天去也好。",
                "pinyin": "míngtiān qù yěhǎo 。",
                "meaning": "Going tomorrow would be all right too.",
                "audio": "1074d501e7a2fc728349239825c5c679bcf4f7b2d02a84defe235dfed52bdb74"
              },
              {
                "text": "你去也好，我去也好，都可以。",
                "pinyin": "nǐ qù yěhǎo ， wǒ qù yěhǎo ， dōu kěyǐ 。",
                "meaning": "Whether you go or I go, either is fine.",
                "audio": "acbd7e7d838111eb48e5ce5443f342046baee3da9f5f4068f0dc78bef03574ce"
              }
            ]
