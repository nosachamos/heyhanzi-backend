    "id": "ACT-GRAM",
    "revision": 6,
    "title": "Say how long it lasts",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-duration-teach",
        "kind": "teach",
        "title": "Say how long it lasts",
        "blocks": [
          {
            "text": "Put a duration after the action. A time point says when; a duration says how long. When naming an object, use a clear pattern such as repeating the verb.",
            "examples": [
              {
                "text": "我等了一个小时。",
                "pinyin": "wǒ děng le yī gè xiǎoshí 。",
                "meaning": "I waited for an hour.",
                "audio": "c91986dea4e2deee5c5780cb500d24583d44cd0cb45238d92958968240e675a8"
              },
              {
                "text": "我看书看了一个小时。",
                "pinyin": "wǒ kàn shū kàn le yī gè xiǎoshí 。",
                "meaning": "I read for an hour.",
                "audio": "76411ef236fc5287ab54b4792c76c118d88b369ca57854a5ffe6fddd102f58ba"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "多久",
                "pinyin": "duōjiǔ",
                "meaning": "how long?",
                "singleWord": true,
