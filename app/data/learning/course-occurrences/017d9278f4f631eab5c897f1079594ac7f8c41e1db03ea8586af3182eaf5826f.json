  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-23-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "An attempt and its outcome · 1",
    "context": "Use the selected vocabulary and constructions to reconstruct an attempt, a complication and the resulting change.",
    "steps": [
      {
        "id": "EX-CORE-U3-23-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-23-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "An attempt and its outcome · 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "班里准备表演，老师让我写下参加的人的名字。第一次问大家的时候，有六个人愿意参加。我把他们的名字写在笔记本上，以为名单已经写好了。\n\n第二天，一个同学说要照顾生病的爸爸，不能来了。我在他的名字旁边写了不能来，告诉大家他不能来。一个同学这时说想参加。\n\n我在后面写了新同学的名字，又问他是不是已经看过要表演什么。他说看过，也愿意来。我告诉大家现在也是六个人，但是有一个人不一样了。\n\n老师看见名单，问为什么和昨天一样多。我给他看笔记，告诉他谁不能来、谁后来要来。老师说，只看多少人会看不见这些变化，写清楚很好。\n\n表演那天，我根据新名单等大家，来的六个人都在新名单上。我明白了，笔记不是写一次就可以了，知道新的事情以后，还要把变化写进去。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
              {
                "id": "r2",
                "text": "I connected a real condition or constraint to the result."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
    "summary": "Your results distinguish checked answers from self-reviewed practice. Unsampled material and unassessed proficiency remain separate.",
