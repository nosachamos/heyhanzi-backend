    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-pronoun-plural-teach",
        "kind": "teach",
        "title": "Refer to groups and understood participants",
        "blocks": [
          {
            "text": "Use the learned whole pronouns 我们, 你们 and 他们 for groups of people. 们 is not a general noun plural ending and does not follow an exact count of people.",
            "examples": [
              {
                "text": "我们学中文。",
                "pinyin": "wǒmen xué Zhōngwén 。",
                "meaning": "We study Chinese.",
                "audio": "636053cd754b12b640478c158e9e081ffc44230114e6416bb0db8abe08eb924e"
              },
              {
                "text": "你们也学中文吗？",
                "pinyin": "nǐmen yě xué Zhōngwén ma ？",
                "meaning": "Do you study Chinese too, as a group?",
                "audio": "f278582172dd5e9d8dae572d802213ae2e5cf4d9184123aeaaa8ce7447562d3e"
              },
              {
                "text": "他们也学中文。",
                "pinyin": "tāmen yě xué Zhōngwén 。",
                "meaning": "They study Chinese too.",
                "audio": "a9544fed8135075b9e07b8e1c1070307857b5e8c593ee938e0ce05a4daff1ac1"
              }
