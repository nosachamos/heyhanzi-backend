  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-17-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A change in the surroundings · 1",
    "context": "Use the selected vocabulary and constructions to connect an observation about a place or environment with a practical decision.",
    "steps": [
      {
        "id": "EX-CORE-U3-17-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-17-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A change in the surroundings · 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "去年冬天，我和朋友去公园，河上有冰，公园很冷。我们在那里照相，后来一直没有再去。现在天气不那么冷了，我想再去看看。\n\n朋友说公园我们已经看过，不用再去。我给他看冬天的照片，问现在是不是和冬天一样。他想了想，说可以去看河边的树。\n\n到了公园，河上没有冰了，草地上有了花。草地上有人坐着看书，也有人带孩子玩。我们没有马上照相，先在河边走了一会儿。\n\n走累了，我们在河边坐下。朋友拿出以前的照片，找到以前照相的地方，让我站在旁边。他照相以后说，现在的照片不能让人知道冬天的公园有多冷。\n\n回家时，他说下个月还想再来。我说不用每次都去新的地方，有时候在一个地方多看几次，才知道它什么时候有冰，什么时候有花。我们把两次的照片放好，等下个月再看。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
              {
                "id": "r2",
                "text": "I connected a real condition or constraint to the result."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
