    "steps": [
      {
        "id": "EX-GRAM-G-location-existence-teach",
        "kind": "teach",
        "title": "Distinguish where it is from what is there",
        "blocks": [
          {
            "text": "Use known thing + 在 + place to locate it. Use place + 有 + thing to introduce what is present there.",
            "examples": [
              {
                "text": "书在学校。",
                "pinyin": "shū zài xuéxiào 。",
                "meaning": "The book is at school.",
                "audio": "895d623bbab25207e7430f35c8b9054e709b4f3e27b0fc3ba380100fb0412920"
              },
              {
                "text": "学校有书。",
                "pinyin": "xuéxiào yǒu shū 。",
                "meaning": "There are books at the school.",
                "audio": "507e1cdf96fe2120f7fde0f4288a75b2957fc6f6b617a4f822f9a05431169991"
