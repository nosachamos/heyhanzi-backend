        "kind": "teach",
        "title": "好像 + proposition",
        "blocks": [
          {
            "text": "好像 introduces an impression based on appearances. The speaker does not claim direct certainty.",
            "examples": [
              {
                "text": "他好像很累。",
                "pinyin": "tā hǎoxiàng hěn lèi 。",
                "meaning": "He seems tired.",
                "audio": "7a3d799e4db27329d6f0da6d6b21ef9c6d716605b84d812de1e198b679d7f1bc"
              },
              {
                "text": "外面好像下雨了。",
                "pinyin": "wàimiàn hǎoxiàng xiàyǔ le 。",
                "meaning": "It seems to be raining outside.",
                "audio": "9268ca8ffdf94e600665daec53a3d40eb06c2dd195144a0404cb4fc59577ce52"
              }
            ]
