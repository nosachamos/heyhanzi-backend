    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-time-p06-teach",
        "kind": "teach",
        "title": "刚刚 + predicate",
        "blocks": [
          {
            "text": "刚刚 means just a moment ago and commonly precedes the predicate. It locates a recent event, rather than promising an imminent action.",
            "examples": [
              {
                "text": "我刚刚到家。",
                "pinyin": "wǒ gānggāng dào jiā 。",
                "meaning": "I arrived home just now.",
                "audio": "e0982703c21e8d2ba6bc43f40e5b3669be30edcb600fd94542b6cdfd8c4243bc"
              },
              {
                "text": "她刚刚给我打电话。",
                "pinyin": "tā gānggāng gěi wǒ dǎdiànhuà 。",
                "meaning": "She called me just a moment ago.",
                "audio": "a3be2daca8c09e95b7c1a48005fdc6d9402955f744b6695ce8200c91708e92f4"
              }
            ]
          },
