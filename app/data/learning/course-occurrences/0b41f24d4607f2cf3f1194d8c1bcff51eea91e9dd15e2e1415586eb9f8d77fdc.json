        "id": "EX-GRAM-G-hsk5-stance-p16-teach",
        "kind": "teach",
        "title": "白 + action",
        "blocks": [
          {
            "text": "白 before an action means the effort was in vain or without the expected return. It is not the color adjective here. 白 can also mean without payment; the predicate and context distinguish this from doing something in vain.",
            "examples": [
              {
                "text": "我白等了一天。",
                "pinyin": "wǒ bái děng le yī tiān 。",
                "meaning": "I waited an entire day in vain.",
                "audio": "7747023e39cca8581a8668684d9e949d42795e097b0539d02c39800511570a00"
              },
              {
                "text": "这次我白跑了。",
                "pinyin": "zhè cì wǒ bái pǎo le 。",
                "meaning": "I made this trip for nothing.",
                "audio": "a91cbcf60c1ff1dc894726a616881b62f53476e6fd2d6fc696ad29856cb1ad58"
              },
              {
                "text": "这本书是他白送给我的。",
                "pinyin": "zhè běn shū shì tā bái sòng gěi wǒ de 。",
                "meaning": "He gave me this book free of charge.",
                "audio": "113e0a82e3c11bcba1e3b02ea7a1623a8a5ce828c4d8037d0a4f37002c54e676"
              }
            ]
