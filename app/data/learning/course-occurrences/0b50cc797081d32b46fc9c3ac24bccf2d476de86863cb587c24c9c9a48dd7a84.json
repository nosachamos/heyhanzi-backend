        "blocks": [
          {
            "text": "支 counts certain slender objects such as pens. Learn the pairing rather than treating it as interchangeable with every long-object classifier.",
            "examples": [
              {
                "text": "我有一支笔。",
                "pinyin": "wǒ yǒu yī zhī bǐ 。",
                "meaning": "I have a pen.",
