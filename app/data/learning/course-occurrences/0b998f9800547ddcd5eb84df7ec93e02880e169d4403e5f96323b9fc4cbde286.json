    "steps": [
      {
        "id": "EX-GRAM-G-hsk1-sentence-types-teach",
        "kind": "teach",
        "title": "State, ask and react",
        "blocks": [
          {
            "text": "A statement can become a 吗 question or an affirmative-negative question. Question words ask for missing information. Commands and short replies may omit a clear subject.",
            "examples": [
              {
                "text": "你看书吗？",
                "pinyin": "nǐ kàn shū ma ？",
                "meaning": "Do you read books?",
                "audio": "535b58a2937c187882eadcad6b859af71ace62812b38a191fd5f1a6b13585582"
              },
              {
                "text": "你看不看书？",
                "pinyin": "nǐ kàn bù kàn shū ？",
                "meaning": "Do you read books?",
                "audio": "03003d33430e724619e3b9128e98c5ca3a872cff57bb53b9b94387f487168b64"
              },
              {
                "text": "你看什么？",
                "pinyin": "nǐ kàn shénme ？",
                "meaning": "What do you read?",
                "audio": "b174631d863015859d1dabcff896b11e435f837508c1e3eb4fec30ad7ad05446"
              },
              {
                "text": "请看。",
                "pinyin": "qǐng kàn 。",
                "meaning": "Please look.",
                "audio": "fe84b63eda62007ac2fcbd1b0f04bdb9cfce70f1cffa5102b1fa22ad5ff9b3f2"
              },
              {
                "text": "太好！",
