        "id": "EX-GRAM-G-noun-modifier-teach",
        "kind": "teach",
        "title": "Describe a noun with a modifier",
        "blocks": [
          {
            "text": "Put a description before the noun it describes. Some short familiar combinations omit 的; longer descriptions often use it. A describing phrase is not yet a whole statement.",
            "examples": [
              {
                "text": "好学生。",
                "pinyin": "hǎo xuéshēng 。",
                "meaning": "A good student.",
                "audio": "73e8d4d300b93a02af2117508147f3080af5939d7b257ae5f1b0c8e9cbad05ff"
              },
              {
                "text": "好的学校。",
                "pinyin": "hǎo de xuéxiào 。",
                "meaning": "A good school.",
