    "revision": 5,
    "title": "Choose who you mean",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-pronouns-teach",
        "kind": "teach",
        "title": "Choose who you mean",
        "blocks": [
          {
            "text": "我 means the speaker and 你 means the listener. 他 and 她 distinguish written reference, but both are pronounced tā. The pronoun does not change the verb.",
            "examples": [
              {
                "text": "我学中文，你也学中文。",
                "pinyin": "wǒ xué Zhōngwén ， nǐ yě xué Zhōngwén 。",
                "meaning": "I study Chinese, and you do too.",
                "audio": "cfb023befdb355c8722f8a8a0a28af508cebb3fff63212cd2bfb3a6577515c58"
              },
              {
                "text": "他学中文，她也学中文。",
                "pinyin": "tā xué Zhōngwén ， tā yě xué Zhōngwén 。",
                "meaning": "He studies Chinese, and she does too.",
                "audio": "3a2dea4facd4cd4cf6efb0bec6fa5ce979331edc154846acd7d2cc4d3e988ae5"
              }
            ]
          },
          {
