    "steps": [
      {
        "id": "EX-CORE-U5-02-skill-K-HSK5-compose-teach",
        "kind": "teach",
        "title": "HSK 5: compose",
        "blocks": [
          {
            "text": "Structure a shared-decision account around the issue, reason and conclusion. Make the connection explicit and distinguish the group’s decision from a personal preference.",
            "examples": [
              {
                "text": "成员",
                "pinyin": "chéngyuán",
                "meaning": "member",
                "singleWord": true,
                "audio": "9cb9a6a445cda6b3f8c7e42d15baeb3c4de831d3cb9fc52e5bb5e621056e9076"
              },
              {
                "text": "伙伴",
                "pinyin": "huǒbàn",
                "meaning": "companion; pal",
                "singleWord": true,
                "audio": "c5236ac47f77eb8246a4c9c4a5034b2dd1e9220a6ac1ac8b81596537893be335"
              },
              {
                "text": "因此",
                "pinyin": "yīncǐ",
                "meaning": "thus; consequently",
                "singleWord": true,
                "audio": "02855ac61a23c3d23ee6d04e765f0804df5c818a90a0a7bb84cd35fa3b96aa66"
              },
              {
                "text": "但是",
                "pinyin": "dànshì",
                "meaning": "but; however",
                "singleWord": true,
                "audio": "1fac104a345a55d1bf1705e3cb2765411e111844ef0ed8389208c90fc1d31949"
              }
            ]
          },
          {
            "text": "Two members proposed today because their partner could attend; another proposed tomorrow because a different partner could attend. The group finally agreed on tomorrow and agreed to explain the discussion personally to the absent member. Write that decision and reason; one member still prefers today.\nFamiliar meanings available: member; companion; pal; thus; consequently; but; however."
          }
        ]
      },
      {
        "id": "EX-CORE-U5-02-skill-K-HSK5-compose-perform",
        "kind": "check",
