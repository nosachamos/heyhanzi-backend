    "steps": [
      {
        "id": "EX-GRAM-G-hsk6-degree-complement-teach",
        "kind": "teach",
        "title": "Express thoroughness or extreme degree",
        "blocks": [
          {
            "text": "The complement follows a compatible feeling or description and expresses an extreme degree. It is not literal movement through an object. With a cognitive action, 透 can mean reaching thorough understanding or seeing through it, a completion reading rather than merely a high degree of emotion.",
            "examples": [
              {
                "text": "他失望透了。",
                "pinyin": "tā shīwàng tòu le 。",
                "meaning": "He is utterly disappointed.",
                "audio": "e5d53432c0522d30f90cc29b0485a74536e46e4baabdad771c11370eb7197194"
              },
              {
                "text": "我把这个问题想透了。",
                "pinyin": "wǒ bǎ zhè gè wèntí xiǎng tòu le 。",
                "meaning": "I thought this problem through completely.",
                "audio": "74f104c1e5be22a66c4204dbcfd9eaaa226816868f1d3a207fefe46a49a6e162"
              }
            ]
          },
          {
