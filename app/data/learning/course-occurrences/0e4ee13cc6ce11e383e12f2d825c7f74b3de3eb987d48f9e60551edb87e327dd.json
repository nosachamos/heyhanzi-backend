  "fingerprint": "ae1ed6fe474c7e332895d79dc23fea303b32df39a90bdd89ac1b00d928cbb0b4",
  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-04-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A room that works · 1",
    "context": "Use the selected vocabulary and constructions to compare arrangements for a living space and resolve a practical problem.",
    "steps": [
      {
        "id": "EX-CORE-U4-04-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-04-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A room that works · 1: Explain the situation to someone who heard only the initial account. Clarify what changed, give a supported reason, and distinguish the participants’ stated intentions from assumptions.",
            "promptLanguage": "en",
            "context": "我和朋友想在外地租房间住一个月，房东带我们看了院子旁边的一间。里面有两张床，离学校也近，我们觉得适合两个人住，就问房租一个月要多少钱。\n\n房东说了多少钱，我以为是这个房间，朋友却以为是一个人要给的钱。我们没有马上在表格上写名字，先问房东，两个人住一个月，一共需要给多少。\n\n房东说是这个房间，不是每个人都给那么多。朋友听了放心了。房东又说，两个人都要在表格上写名字，不能只写来问房子的人。\n\n我把自己的名字写好，就把表格给朋友。他问为什么要写两个，我说虽然房租是一个房间的，但住的人是两个，这两件事要分开看。\n\n我们又问什么时候可以搬来，房东说星期一，放好两个人的东西以后就可以去学校。我们把这个时间写在本子上，记住今天看了房间，还不能马上住进来。\n\n星期一，我们到了房间，房东已经在门口等我们。我和朋友进去以后，先看表格，再看房间。房间、住几个人、多少钱和时间都说清楚，才没有只记住房租就做决定。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I retained the change or contrast that matters to the outcome."
              },
              {
                "id": "r2",
                "text": "I kept stated intentions separate from my assumptions."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
