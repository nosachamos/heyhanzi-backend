      {
        "id": "EX-CORE-WU01-skill-K-WARMUP-speak-teach",
        "kind": "teach",
        "title": "Warm-up: speak",
        "blocks": [
          {
            "text": "A short greeting and an identification are enough for a first turn. Keep the learned words and their tones intact; short natural phrases are preferable to adding untaught material.",
            "examples": [
              {
                "text": "你好",
                "pinyin": "nǐhǎo",
                "meaning": "hello; hi",
                "singleWord": true,
                "audio": "ba138555ea5e79f104066baccd5d743c996b1b7f150a3101dfe0b2e3eefda145"
              },
              {
                "text": "我",
                "pinyin": "wǒ",
                "meaning": "I; me",
                "singleWord": true,
                "audio": "364fba3bd2447ba14bf6e73be5f61e90209a109abbfe24e2f287e738f69f1113"
              },
              {
                "text": "是",
                "pinyin": "shì",
                "meaning": "be",
                "singleWord": true,
                "audio": "7940c81ffb1e91957744588fa3aeea82d09d9d422020f67f6e9d7f3b4ed610b8"
              }
            ]
          },
          {
            "text": "A familiar partner hears you arrive and asks whether it is you. Greet them and confirm that you are the person they expected. Use the already taught short identity reply; no personal name or nationality is needed.\nFamiliar meanings available: hello; hi; I; me; be."
          }
        ]
      },
