    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-connectors-p03-teach",
        "kind": "teach",
        "title": "noun phrase + 与 + noun phrase",
        "blocks": [
          {
            "text": "与 joins noun phrases in formal language. Do not use nominal conjunction 与 to connect any two complete clauses indiscriminately.",
            "examples": [
              {
                "text": "老师与学生都来了。",
                "pinyin": "lǎoshī yǔ xuéshēng dōu lái le 。",
                "meaning": "The teachers and students have all arrived.",
                "audio": "521bc2a1ee28f666c84dc0bfcc15f31e820107f75d167d8fb65b67a9f1f446e1"
              },
              {
                "text": "这是我与他的书。",
                "pinyin": "zhè shì wǒ yǔ tā de shū 。",
                "meaning": "This is the book belonging to him and me.",
                "audio": "de920c05fbc84ab21d6f98f884f1fa7c71bd8600601761f7983ae2a3ddd07573"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
