  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-03-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Sharing responsibilities · 3",
    "context": "Use the selected vocabulary and constructions to agree who will help whom after a change of circumstances.",
    "steps": [
      {
        "id": "EX-CORE-U4-03-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-03-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Sharing responsibilities · 3: Explain the situation to someone who heard only the initial account. Clarify what changed, give a supported reason, and distinguish the participants’ stated intentions from assumptions.",
            "promptLanguage": "en",
            "context": "我刚到一个新公司，电脑上的字有很多看不懂。一位同事每天教我几个词，我很感谢他，觉得自己一直在让对方帮忙，却没有什么可以做的。\n\n有一天，同事说要给孩子买中文书，不知道怎么选。我以前在学校教过孩子，知道有些书虽然字少，孩子却不一定有兴趣。我说可以一起去看看。\n\n我们没有马上去书店，先问孩子喜欢什么。他喜欢动物，自己会读一些字，也喜欢让爸爸读给他听。我告诉同事，可以选一本他们能一起看的。\n\n到了书店，同事先选了一本有很多字的书，觉得可以看很久。我请孩子打开试读，他不太想看。后来他找到一本写动物的书，马上让爸爸和他读。\n\n同事对我说谢谢，我说他已经帮过我很多次了。他说不用每次都看谁帮谁多，在不同的事情上，每个人都有会的，也都有需要问人的。\n\n回到公司，同事又帮我读电脑上的词，我也告诉他怎样和孩子一起读书。我知道需要帮助不等于什么都不会，两个人可以在不同的事情上帮助对方。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I retained the change or contrast that matters to the outcome."
              },
              {
                "id": "r2",
                "text": "I kept stated intentions separate from my assumptions."
              }
            ]
          }
        ],
        "sequential": true
      }
