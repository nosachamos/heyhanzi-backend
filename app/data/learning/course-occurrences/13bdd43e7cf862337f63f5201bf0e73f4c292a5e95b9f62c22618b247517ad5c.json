        "kind": "teach",
        "title": "沿着 + route",
        "blocks": [
          {
            "text": "沿 着 introduces a route followed by movement. Learn the route phrase as a path, not a destination.",
            "examples": [
              {
                "text": "我们沿着这条路走。",
                "pinyin": "wǒmen yán zhe zhè tiáo lù zǒu 。",
                "meaning": "We walk along this road.",
                "audio": "ab326bbee50ead9a37efa89c0dd2b1307935dc9d3135a99b85d8dff654d9dd8a"
              },
              {
                "text": "他沿着河跑步。",
                "pinyin": "tā yán zhe hé pǎobù 。",
                "meaning": "He runs along the river.",
                "audio": "63b4d6faf6c5136d59f7f7cab6e4704a841cfe31a7692f9890db5e8ada4bd4de"
              }
            ]
