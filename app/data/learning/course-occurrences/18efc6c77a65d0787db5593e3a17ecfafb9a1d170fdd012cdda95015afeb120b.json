    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-numbers-p01-teach",
        "kind": "teach",
        "title": "来 / 大约: Use number+来+classifier, 大约, 左右 or 前后 for an estimate",
        "blocks": [
          {
            "text": "来 after a round number, or 大约/左右/前后 around a quantity, gives an estimate. Keep each marker in its learned position rather than stacking all of them.",
            "examples": [
              {
                "text": "十来个人来了。",
                "pinyin": "shí lái gè rén lái le 。",
                "meaning": "About ten people came.",
                "audio": "a2d33803695e04ad32634d4270c47af7f7b2a3c42159e487729276c9c9b8d7bc"
              },
              {
                "text": "大约三十人。",
                "pinyin": "dàyuē sān shí rén 。",
                "meaning": "About thirty people.",
                "audio": "21e607db553ff488b5cb3cec632bdc3554fba4bf0e4a38b5e00128af74775061"
              },
              {
                "text": "三点左右来。",
                "pinyin": "sān diǎn zuǒyòu lái 。",
                "meaning": "Come at about three.",
                "audio": "447efce1b6739e0f5b461757991bee41856a7b8b364448e128da586b634e5c5b"
              },
              {
                "text": "三点前后都可以。",
                "pinyin": "sān diǎn qiánhòu dōu kěyǐ 。",
                "meaning": "Around three is fine.",
                "audio": "3402b6f09f96060ea3c306d07c3956dbb71c98e344905624f33b69b4d410fb44"
              }
            ]
