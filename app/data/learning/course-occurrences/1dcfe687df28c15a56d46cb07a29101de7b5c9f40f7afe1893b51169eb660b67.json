    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-weak-degree-teach",
        "kind": "teach",
        "title": "Soften a negative evaluation with 不怎么",
        "blocks": [
          {
            "text": "不怎么 before a gradable predicate softens the negative to not very or not much. It is not an open question about manner.",
            "examples": [
              {
                "text": "我不怎么忙。",
                "pinyin": "wǒ bù zěnme máng 。",
                "meaning": "I am not very busy.",
                "audio": "b0ffb7b87140983bab25030f518e8ab8a1f2d81ab8a4aac63a68a8234a53cdad"
              },
              {
                "text": "这本书不怎么贵。",
                "pinyin": "zhè běn shū bù zěnme guì 。",
                "meaning": "This book is not very expensive.",
                "audio": "82e81885a4e4597446ea1cf6decd04a85cb991c070242d3d7394222895919b75"
              }
