  "definition": {
    "id": "ACT-GRAM",
    "revision": 5,
    "title": "Who ends up affected?",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk6-impact-p01-teach",
        "kind": "teach",
        "title": "Who ends up affected?",
        "blocks": [
          {
            "text": "The head phrase identifies the person on whom responsibility or trouble falls. It is figurative, not a physical object landing on the head.",
            "examples": [
              {
                "text": "他没有完成任务，责任却落到我头上了。",
                "pinyin": "tā méiyǒu wánchéng rènwu ， zérèn què luò dào wǒ tóu shàng le 。",
                "meaning": "He did not finish the task, yet the responsibility fell on me.",
                "audio": "d016ec0bafa2b4526ed521b9b70c371267e9d6bf496cf08fbb783d3ffaeb3134"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "到",
                "pinyin": "dào",
                "meaning": "to; arrive",
                "singleWord": true,
