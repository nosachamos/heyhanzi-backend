    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-stance-p02-teach",
        "kind": "teach",
        "title": "必须 + action",
        "blocks": [
          {
            "text": "必须 expresses a requirement. Having no requirement is different from being forbidden to do something. 不需要 denies a requirement; 不能 can prohibit an act. Do not negate 必须 by simply adding 不 directly before it.",
            "examples": [
              {
                "text": "你必须来。",
                "pinyin": "nǐ bìxū lái 。",
                "meaning": "You must come.",
                "audio": "1541fc7387d0ffc251adda4379107e713e9ef28f317e357662ccc01bcd728d09"
              },
              {
                "text": "我必须完成工作。",
                "pinyin": "wǒ bìxū wánchéng gōngzuò 。",
                "meaning": "I must finish the work.",
                "audio": "6a67d1776a41753bcd3d342d0e2da83acea842ada47d3b9a9d5e5926351ea526"
              },
              {
                "text": "你不需要来。",
                "pinyin": "nǐ bù xūyào lái 。",
                "meaning": "You do not need to come.",
                "audio": "1b62c6e974d6e22ddd130d527ee35bbde5ead359187d284effa30f0bf557c805"
              },
              {
                "text": "你不能在这里看书。",
                "pinyin": "nǐ bùnéng zài zhèlǐ kàn shū 。",
                "meaning": "You are not allowed to read here; this is a prohibition.",
                "audio": "ae856efbf2fc82cc78afd15289ba59dd39cc3078e0cebf6edd448ed97925e4ef"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "必须",
                "pinyin": "bìxū",
                "meaning": "must; to have to",
