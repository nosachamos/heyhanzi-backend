    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-time-p05-teach",
        "kind": "teach",
        "title": "刚 + predicate",
        "blocks": [
          {
            "text": "刚 before a verb places the event just before the reference time. It is an adverb, not a free time noun after a preposition.",
            "examples": [
              {
                "text": "他刚走。",
                "pinyin": "tā gāng zǒu 。",
                "meaning": "He has just left.",
                "audio": "e886a5b9863279f825c5e416b07cf00620e8384d723c289e87c1400cde4da38b"
              },
              {
                "text": "我刚吃完饭。",
                "pinyin": "wǒ gāng chī wán fàn 。",
                "meaning": "I have just finished eating.",
                "audio": "0cd591eb665bf76991d1b7696bc0791a9ed8ae9ebd84f428411b54b48c85f9b2"
              }
            ]
          },
          {
