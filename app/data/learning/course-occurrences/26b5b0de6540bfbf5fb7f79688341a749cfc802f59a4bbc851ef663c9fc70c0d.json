    "steps": [
      {
        "id": "EX-GRAM-G-hsk6-particles-p01-teach",
        "kind": "teach",
        "title": "An unexpected development",
        "blocks": [
          {
            "text": "First establish what was expected, then introduce a contrasting actual development. This reports surprise at something that happened, rather than a hypothetical possibility.",
            "examples": [
              {
                "text": "我以为今天会下雨，不料天气很好。",
                "pinyin": "wǒ yǐwéi jīntiān huì xiàyǔ ， bùliào tiānqì hěn hǎo 。",
                "meaning": "I thought it would rain today, but unexpectedly the weather is very good.",
                "audio": "84735d5c3b721b6c93f6601c12f1ba291ce3c5a3ac2afaac27f705fc8a6426fe"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "不料",
                "pinyin": "bùliào",
                "meaning": "unexpectedly; to one's surprise",
                "singleWord": true,
