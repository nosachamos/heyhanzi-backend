        "questions": [
          {
            "id": "EX-CORE-U23-P01-compose-draft",
            "kind": "production",
            "response": "written",
            "prompt": "Comparing and noticing change · preparation 1: Write a connected update for someone who missed the event. Include the situation, what happened or is planned, and a supported reason or next action.",
            "promptLanguage": "en",
            "context": "我和朋友看两个房间。一个在三楼，一个在四楼。三楼的房间比四楼的大，两个房间的桌子一样大。\n\n朋友喜欢三楼的房间，说：“房间大，两个人在里面看书很好。”我说：“四楼的也很好，里面有花。”\n\n两个房间一样贵。我说：“两个房间一样贵，我想住三楼。房间大，我们可以一起在里面看书。”朋友说：“好，桌子也很好。”",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I preserved the event status and participants."
              },
              {
                "id": "r2",
                "text": "My update connects the account to a relevant reason or next action."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
