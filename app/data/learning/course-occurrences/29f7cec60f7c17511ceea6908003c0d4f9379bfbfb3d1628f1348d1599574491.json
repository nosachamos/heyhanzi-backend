    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U16-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Experiences and occasions",
    "context": "Discuss previous experiences and distinguish occasions from complete repetitions.",
    "steps": [
      {
        "id": "EX-CORE-U16-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U16-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Experiences and occasions: Give an absent partner a short account of the situation. Identify the people, what happened or is planned, and a relevant time or reason supported by the source.",
            "promptLanguage": "en",
            "context": "以前我去过一次中国。第一次我和爸爸、妈妈去中国。我那时候很小，不会开车，只会坐在车里看外边。\n\n今天我和朋友去中国看老师。我会开车了。爸爸、妈妈今天工作，没有和我们去。朋友很高兴。\n\n朋友没有去过中国。他问：“你去过吗？”我说：“我去过一次。这次我和你去。”他说：“好，我们去吧。”",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I preserved who acted and whether the event happened or is planned."
              },
              {
                "id": "r2",
                "text": "My time or reason is supported by the source rather than invented."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
