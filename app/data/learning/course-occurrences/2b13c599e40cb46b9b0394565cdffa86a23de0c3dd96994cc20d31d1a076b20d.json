        "kind": "teach",
        "title": "自 + starting point",
        "blocks": [
          {
            "text": "自 introduces a starting point in concise formal language. A starting point is different from a destination.",
            "examples": [
              {
                "text": "他自北京来。",
                "pinyin": "tā zì Běijīng lái 。",
                "meaning": "He comes from Beijing.",
                "audio": "2ae6635af108b1da74d2cd6fa5cf2a4a1ddef5bf9c0f153e26d826f49eb8a989"
              },
              {
                "text": "自今天起，我每天读书。",
                "pinyin": "zì jīntiān qǐ ， wǒ měi tiān dú shū 。",
                "meaning": "Starting today, I read every day.",
                "audio": "e06fb13af97a17538cfc92f52d299113b9844613702c0407fd9225ae45e074c8"
              }
            ]
          },
