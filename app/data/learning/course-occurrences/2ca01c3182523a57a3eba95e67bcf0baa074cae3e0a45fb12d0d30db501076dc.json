              },
              {
                "text": "还是",
                "pinyin": "háishi",
                "meaning": "or (in alternative questions); had better (preference); still (despite an alternative)",
                "singleWord": true,
                "audio": "3c2edca87b1a73acbf9b0e2f2c7009544425f420845b75508abd1e4f1f1359b3"
              },
