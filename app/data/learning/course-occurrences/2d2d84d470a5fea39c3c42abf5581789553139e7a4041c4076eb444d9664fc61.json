  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U3-24-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "A practical problem solved · 2",
    "context": "Use the selected vocabulary and constructions to explain what someone tried and why the result differed from the intention.",
    "steps": [
      {
        "id": "EX-CORE-U3-24-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U3-24-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "A practical problem solved · 2: Write a practical explanation for someone joining the situation late. State the problem, a supported reason or constraint, and a clear proposed next step.",
            "promptLanguage": "en",
            "context": "学校准备办运动会。老师让我发邮件，告诉同学星期六去外面的球场。邮件里写清楚了时间和地点，我发出去以后，就觉得事情办好了。\n\n星期五刮大风，老师说星期六在体育馆里面，不去外面的球场。我在自己的本子上写了新地点，准备第二天带着本子去。\n\n朋友问我是不是已经告诉同学。我这才发现，自己知道新的地点，不是大家都知道。我把新地点写进一封新邮件，说时间和以前一样，地点换了。\n\n我发完邮件，又看谁已经回答。两个同学没有回答，我就给他们打电话。有人以为运动会不办了，我说要办，但是在里面。\n\n星期六大家穿着运动的衣服到了体育馆，外面风很大，里面可以打球。老师说，换了地点就要再告诉大家，不能以为发过一封邮件，以后就一直一样。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The problem, constraint and next step connect coherently."
              },
              {
                "id": "r2",
                "text": "I distinguished the source facts from my proposal."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
