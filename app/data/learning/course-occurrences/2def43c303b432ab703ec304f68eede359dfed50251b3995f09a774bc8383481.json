        "kind": "teach",
        "title": "小 + familiar personal name",
        "blocks": [
          {
            "text": "小 before a familiar surname creates a familiar way to address someone. Learn the complete name; it need not describe physical size.",
            "examples": [
              {
                "text": "我叫小王。",
                "pinyin": "wǒ jiào xiǎowáng 。",
                "meaning": "My name is Xiao Wang.",
                "audio": "4e1b083b1ec149bf9a8e4d8122811faf4316cd6bc5a6043b559b033ad0f7e820"
              },
              {
                "text": "小王是我的朋友。",
                "pinyin": "xiǎowáng shì wǒ de péngyou 。",
                "meaning": "Xiao Wang is my friend.",
