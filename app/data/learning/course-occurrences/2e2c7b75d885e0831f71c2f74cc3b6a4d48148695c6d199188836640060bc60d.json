    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-connectors-p18-teach",
        "kind": "teach",
        "title": "modifier + 之 + noun",
        "blocks": [
          {
            "text": "之 can connect a modifier and noun in formal fixed or established expressions. It is not a universal conversational replacement for 的.",
            "examples": [
              {
                "text": "学习之路很长。",
                "pinyin": "xuéxí zhī lù hěn cháng 。",
                "meaning": "The road of learning is long.",
                "audio": "5c1d82f561d1e9302fa612ceba1eab34db4665957686abe66178b33230e84178"
              },
              {
                "text": "这是成功之路。",
                "pinyin": "zhè shì chénggōng zhī lù 。",
                "meaning": "This is the road to success.",
                "audio": "52fd39bde237371aa6f3f65a1cf4c57da2b5299ad19755748e025d80d7488403"
              }
            ]
          },
