    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-prepositions-p03-teach",
        "kind": "teach",
        "title": "Use 由 for an origin or responsible participant",
        "blocks": [
          {
            "text": "由 introduces a source or the participant assigned responsibility. The following predicate clarifies whether it is origin or agency. 由 + time + 起 can mark a formal starting point in time.",
            "examples": [
              {
                "text": "这件事由我负责。",
                "pinyin": "zhè jiàn shì yóu wǒ fùzé 。",
                "meaning": "I am responsible for this matter.",
                "audio": "90a155d93d7f0886f293d3a30b0fafd3c3948aa05b0b665ba90179411dbbaba2"
              },
              {
                "text": "火车由北京开往上海。",
                "pinyin": "huǒchē yóu Běijīng kāi wǎng Shànghǎi 。",
                "meaning": "The train runs from Beijing toward Shanghai.",
                "audio": "b4e72e8fdf7925a27dedb24c49a637e21940d3c3818dd7eb57fb5f204e1d373e"
              },
              {
                "text": "由明天起，我们在这里上课。",
                "pinyin": "yóu míngtiān qǐ ， wǒmen zài zhèlǐ shàngkè 。",
                "meaning": "Starting tomorrow, we will have class here. A formal announcement.",
                "audio": "9a27a34770e1a18f6038185f63ac6c8437ee10bcf75a874a86364f4faaf87863"
              }
            ]
          },
