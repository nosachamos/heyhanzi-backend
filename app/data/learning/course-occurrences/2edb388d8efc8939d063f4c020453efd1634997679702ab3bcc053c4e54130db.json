        "kind": "teach",
        "title": "Warm-up: listen",
        "blocks": [
          {
            "text": "Track who is speaking before interpreting a pronoun. The same-sounding pronouns for he and she need visible context; sound alone cannot identify the written gender.",
            "examples": [
              {
                "text": "我",
                "pinyin": "wǒ",
                "meaning": "I; me",
                "singleWord": true,
                "audio": "364fba3bd2447ba14bf6e73be5f61e90209a109abbfe24e2f287e738f69f1113"
              },
              {
                "text": "你",
                "pinyin": "nǐ",
                "meaning": "you",
                "singleWord": true,
                "audio": "b316ac0dd167bd8bef2048818a93b55be5371efb0af3024556cf9b5c93799d4d"
              },
              {
                "text": "你好",
                "pinyin": "nǐhǎo",
                "meaning": "hello; hi",
                "singleWord": true,
                "audio": "ba138555ea5e79f104066baccd5d743c996b1b7f150a3101dfe0b2e3eefda145"
              }
            ]
          },
          {
            "text": "Listen to the complete recording. Work out what is said and how many turns occur from the audio.\nFamiliar meanings available: I; me; you; hello; hi."
          }
        ]
