    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-numbers-p05-teach",
        "kind": "teach",
        "title": "倍: Express multiples with 倍",
        "blocks": [
          {
            "text": "是…的N倍 states a total multiple. 比…多N倍 states an increase, so the total is N+1 times the baseline.",
            "examples": [
              {
                "text": "他的钱是我的两倍。",
                "pinyin": "tā de qián shì wǒ de liǎng bèi 。",
                "meaning": "He has twice as much money as I do.",
                "audio": "44c712ee114bb68a9b2bcd06a2f550ae4fc34092d124679e76a7b92c7bff1597"
              },
              {
                "text": "他的钱比我多一倍。",
                "pinyin": "tā de qián bǐ wǒ duō yī bèi 。",
                "meaning": "He has one hundred percent more money than I do.",
                "audio": "c695b2d107c9ba1606f9187b6378549cb35b25855ee4072472bf83a64d0b8e68"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "倍",
                "pinyin": "bèi",
                "meaning": "-fold; times",
                "singleWord": true,
                "audio": "a829272e0c2d067ba0541d51f0c557cf5f2e2901b8e8ce77369be134fbd4a050"
              }
