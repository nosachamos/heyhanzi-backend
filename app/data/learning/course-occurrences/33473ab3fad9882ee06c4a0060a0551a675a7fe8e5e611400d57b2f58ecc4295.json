        "id": "EX-GRAM-G-hsk2-duration-teach",
        "kind": "teach",
        "title": "Measure an extent with an adjective complement",
        "blocks": [
          {
            "text": "A dimension adjective followed by a measurement states an absolute extent. It is not automatically a difference in comparison or a duration of action.",
            "examples": [
              {
                "text": "桌子长三米。",
                "pinyin": "zhuōzi cháng sān mǐ 。",
                "meaning": "The table is three meters long.",
                "audio": "8f6c161e5120b78e27ae8a5d7ed5937a73fd65b3e785d348c001ecc2ef833a66"
              },
              {
                "text": "那张桌子长一米。",
                "pinyin": "nà zhāng zhuōzi cháng yī mǐ 。",
                "meaning": "That table is one meter long.",
