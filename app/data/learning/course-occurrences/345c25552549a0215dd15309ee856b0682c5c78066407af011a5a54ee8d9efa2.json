        "title": "一同 + action",
        "blocks": [
          {
            "text": "一同 describes participants sharing an action. Simultaneous unrelated actions do not count as joint participation.",
            "examples": [
              {
                "text": "我们一同出发。",
                "pinyin": "wǒmen yītóng chūfā 。",
                "meaning": "We set off together.",
                "audio": "a824e1bd613009fe752183073609e43a901811e29517ce7f380f035cafed2a1f"
              },
              {
                "text": "他与我一同工作。",
                "pinyin": "tā yǔ wǒ yītóng gōngzuò 。",
                "meaning": "He works together with me.",
