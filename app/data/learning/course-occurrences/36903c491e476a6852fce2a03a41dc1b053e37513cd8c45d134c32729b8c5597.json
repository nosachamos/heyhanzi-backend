        "kind": "teach",
        "title": "特意 + purposeful action",
        "blocks": [
          {
            "text": "特意 emphasizes a deliberate choice made for a purpose. It contrasts intention with accident.",
            "examples": [
              {
                "text": "我特意早点儿来。",
                "pinyin": "wǒ tèyì zǎo diǎnr lái 。",
                "meaning": "I deliberately came a little early.",
                "audio": "fffb72a9dc056383613078db2812a1742196ce66def91729a2ab98ab36f88d90"
              },
              {
                "text": "他特意给我留了位置。",
                "pinyin": "tā tèyì gěi wǒ liú le wèizhì 。",
                "meaning": "He intentionally saved me a place.",
                "audio": "a524ddd816913722551986acce269b40058f7de84dc7decc47405688650fe6d4"
              }
            ]
          },
