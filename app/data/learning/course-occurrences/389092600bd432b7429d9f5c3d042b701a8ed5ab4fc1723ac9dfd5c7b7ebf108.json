        "kind": "teach",
        "title": "Point to people, objects and places",
        "blocks": [
          {
            "text": "这 and 那 point to nearby and more distant things; 这些 and 那些 refer to sets. 有的 and 有些 can mean some, rather than possession.",
            "examples": [
              {
                "text": "这是我的书。",
                "pinyin": "zhè shì wǒ de shū 。",
                "meaning": "This is my book.",
                "audio": "4edd16c5c5cd02fcb9dbc7b2ca2aed692e5d866bbe40a86d2d2113bf811b854f"
              },
              {
                "text": "那些人在那里。",
                "pinyin": "nàxiē rén zài nàlǐ 。",
                "meaning": "Those people are there.",
                "audio": "cc4d6ad45e10560d80d2cb241288e6959dfc9b333548c543913a03e2356a8f1f"
              },
              {
                "text": "有的人是学生，有的人是老师。",
                "pinyin": "yǒude rén shì xuéshēng ， yǒude rén shì lǎoshī 。",
                "meaning": "Some people are students, and others are teachers.",
                "audio": "07e30af76f6d249894afd775019795d6d1f993e77c42f119a25e3c0a0e9bc31a"
              }
            ]
