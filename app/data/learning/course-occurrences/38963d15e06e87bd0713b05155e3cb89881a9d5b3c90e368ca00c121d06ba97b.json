    "steps": [
      {
        "id": "EX-GRAM-G-a-not-a-teach",
        "kind": "teach",
        "title": "Ask whether something is true",
        "blocks": [
          {
            "text": "A positive–negative pair can ask a yes–no question. For 有, use 有没有, with 没有 as the negative form. Use the pair without adding 吗 to the same neutral question.",
            "examples": [
              {
                "text": "这是不是你的书？",
                "pinyin": "zhè shì bù shì nǐ de shū ？",
                "meaning": "Is this your book?",
                "audio": "fc3216563694899bb523207e9506f9f790e1adfdb43edd798cceb57ebc0993d2"
              },
              {
                "text": "你有没有书？",
                "pinyin": "nǐ yǒuméiyǒu shū ？",
                "meaning": "Do you have any books?",
                "audio": "bb8e3b6f5e3d1cecc5cca9657d8373f9de9010f47b5b24e99a77cf31edb43df2"
              }
            ]
          },
          {
