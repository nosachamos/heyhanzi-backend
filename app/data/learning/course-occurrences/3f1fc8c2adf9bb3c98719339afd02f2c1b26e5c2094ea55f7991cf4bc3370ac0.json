    "steps": [
      {
        "id": "EX-GRAM-G-hsk5-conditions-p01-teach",
        "kind": "teach",
        "title": "一旦 / 就: 一旦…就 introduces a triggering condition",
        "blocks": [
          {
            "text": "一旦…就 treats an event as the trigger for a consequence. It does not by itself claim that the condition has already occurred.",
            "examples": [
              {
                "text": "一旦下雨，我们就回家。",
                "pinyin": "yīdàn xiàyǔ ， wǒmen jiù huí jiā 。",
                "meaning": "Once it rains, we will go home.",
                "audio": "b763228315468abeb13db2dea2ec94e64a0d238275f24d8f12c5c7d2cd6a4261"
              },
              {
                "text": "一旦开始，就不能停。",
                "pinyin": "yīdàn kāishǐ ， jiù bù néng tíng 。",
                "meaning": "Once we start, we cannot stop.",
                "audio": "4a316df6dfb086318196fcc483cb373ece58ace73b1bba353cfe94ea1bb0dbcb"
              }
            ]
          },
          {
