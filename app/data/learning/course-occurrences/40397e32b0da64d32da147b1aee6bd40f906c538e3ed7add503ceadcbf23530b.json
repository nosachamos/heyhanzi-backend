    "steps": [
      {
        "id": "EX-CORE-U03-skill-K-HSK1-pragmatics-teach",
        "kind": "teach",
        "title": "HSK 1: pragmatics",
        "blocks": [
          {
            "text": "Choose an address for the relationship and situation. The familiar polite and everyday forms are alternatives with social context; thanking someone and requesting repetition have different purposes.",
            "examples": [
              {
                "text": "您",
                "pinyin": "nín",
                "meaning": "you, used respectfully",
                "singleWord": true,
                "audio": "f16b233bd9075387fbef9b385417347443ced956f316fe0b7a7253d5e84e8a20"
              },
              {
                "text": "你",
                "pinyin": "nǐ",
                "meaning": "you",
                "singleWord": true,
                "audio": "b316ac0dd167bd8bef2048818a93b55be5371efb0af3024556cf9b5c93799d4d"
              },
              {
                "text": "老师",
                "pinyin": "lǎoshī",
                "meaning": "teacher",
                "singleWord": true,
                "audio": "310e6b5e11de6adedbeb20515e73ec6357cf47c84ba79ce43f7858f24ded0eb2"
              },
              {
                "text": "谢谢",
                "pinyin": "xièxie",
                "meaning": "thank you",
                "singleWord": true,
                "audio": "77c9dcfb11bca11b415da7602e960e26a88db99372c35891d5ceccad29b06263"
              },
              {
                "text": "请再说一遍",
                "pinyin": "qǐngzàishuōyībiàn",
                "meaning": "please say it once more",
                "singleWord": true,
                "audio": "d067378704cc216bbf96aa487b12844cc687e51a9f702cca94f1f73fa0921d5e"
              }
            ]
          },
          {
            "text": "You first need your teacher’s attention, then a peer’s attention. Each helps you. Thank them. You miss the peer’s next reply; use the already taught repetition-request chunk and wait.\nFamiliar meanings available: you, used respectfully; you; teacher; thank you; please say it once more."
          }
        ]
