    "steps": [
      {
        "id": "EX-CORE-U4-02-skill-K-HSK4-interact-teach",
        "kind": "teach",
        "title": "HSK 4: interact",
        "blocks": [
          {
            "text": "Acknowledge a request or criticism before responding. Distinguish an apology for an action from agreement with every claim; confirm what is actually being agreed.",
            "examples": [
              {
                "text": "答应",
                "pinyin": "dāying",
                "meaning": "to answer; to respond",
                "singleWord": true,
                "audio": "4608e0f0b4f8363386cb9209617e7d2d9df4f6957f56f0972d71ba895a51cb19"
              },
              {
                "text": "道歉",
                "pinyin": "dàoqiàn",
                "meaning": "to apologize",
                "singleWord": true,
                "audio": "8f1988618cc935b453148cae7f9146a0cf0cc6989a03424dafe1e4ca86586f06"
              },
              {
                "text": "批评",
                "pinyin": "pīpíng",
                "meaning": "to criticize; criticism",
                "singleWord": true,
                "audio": "22f416f338994c36f3daad678d81071e495273ef50977f2c084eca41b9704a2c"
              },
              {
                "text": "对不起",
                "pinyin": "duìbuqǐ",
                "meaning": "sorry",
                "singleWord": true,
                "audio": "70793902a26c9a6674a77d286ad9de4025f3b0b0b7c66447408967470dd22456"
              },
              {
                "text": "同意",
                "pinyin": "tóngyì",
                "meaning": "to agree; to consent",
                "singleWord": true,
                "audio": "cf7ebab054c4582cc5b298c38c5b62f5fb3eb71a9e8d00535ef463cb62751b30"
              }
            ]
          },
          {
            "text": "A partner criticizes you for not coming at the agreed time and asks you to come tomorrow. You acknowledge the missed meeting and apologize. You agree to tomorrow, but the time tomorrow is not yet agreed. Respond to the criticism and clarify that remaining detail; no other fault has been alleged.\nFamiliar meanings available: to answer; to respond; to apologize; to criticize; criticism; sorry; to agree; to consent."
          }
        ]
      },
