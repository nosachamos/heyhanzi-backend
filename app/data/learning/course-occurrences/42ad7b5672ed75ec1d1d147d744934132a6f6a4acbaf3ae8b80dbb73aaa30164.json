    "id": "ACT-GRAM",
    "revision": 10,
    "title": "Concede a circumstance and contrast formally",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-contrast-teach",
        "kind": "teach",
        "title": "Concede a circumstance and contrast formally",
        "blocks": [
          {
            "text": "尽管 acknowledges a circumstance before a contrasting claim with 但是/可是. 然而 introduces a more formal contrast between clauses.",
            "examples": [
              {
                "text": "尽管下雨，但是我还要去。",
                "pinyin": "jǐnguǎn xiàyǔ ， dànshì wǒ hái yào qù 。",
                "meaning": "Although it is raining, I still have to go.",
                "audio": "ecfaccdd2643d9a5e405425f5ba8aa32ba25f2a2fc3f764189b9cc4eaed1d8f9"
              },
              {
                "text": "他很忙，然而每天都来。",
                "pinyin": "tā hěn máng ， rán'ér měi tiān dōu lái 。",
                "meaning": "He is busy; nevertheless, he comes every day.",
                "audio": "03709b1657da3e9868e01b97d075676ca7cdb345a34f25ba6c0c00bf16343077"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "尽管",
                "pinyin": "jǐnguǎn",
                "meaning": "despite; although",
                "singleWord": true,
                "audio": "ecfe7d419b107524640feeeade7d3ee6e5d335fe03833c464279c9b984479521"
              },
              {
                "text": "但是",
                "pinyin": "dànshì",
                "meaning": "but; however",
                "singleWord": true,
                "audio": "1fac104a345a55d1bf1705e3cb2765411e111844ef0ed8389208c90fc1d31949"
              },
              {
                "text": "可是",
                "pinyin": "kěshì",
                "meaning": "but; however",
                "singleWord": true,
                "audio": "28ba7391df09339378bb933882f6cdb4a38149dc549b83f41c00b0d4f6869246"
              },
              {
                "text": "然而",
                "pinyin": "rán'ér",
                "meaning": "however; but",
                "singleWord": true,
                "audio": "2978ce1e8e63983d6bf94adc8446410a1b9591fcccfdf097aa05a8d46ff0f5c1"
              }
            ]
          }
        ]
