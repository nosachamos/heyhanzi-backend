        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U21-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "Can I finish it, and how well?: Write a connected update for someone who missed the event. Include the situation, what happened or is planned, and a supported reason or next action.",
            "promptLanguage": "en",
            "context": "老师让我读一本中文书。我看得懂这本书，读得太快，朋友听不懂。朋友说：“请你不要读得太快。”\n\n我说：“这些字我都认识。我可以再读一次，你听听吧。”老师说：“好，你读，让朋友听听。我们都听听。”\n\n我再读一次，这次读得不快。朋友说：“这次我听懂了。”我看得懂，也能让朋友听懂。朋友让我再读一次，他也想学。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I preserved the event status and participants."
              },
              {
                "id": "r2",
                "text": "My update connects the account to a relevant reason or next action."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
