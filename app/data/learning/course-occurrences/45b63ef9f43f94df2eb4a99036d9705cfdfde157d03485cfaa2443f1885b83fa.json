    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-complements-teach",
        "kind": "teach",
        "title": "Describe extreme degree and elapsed time",
        "blocks": [
          {
            "text": "得很 and 极了 intensify compatible predicates; 坏了 can express an extreme, often adverse result. A later time phrase can measure the interval since an action ended.",
            "examples": [
              {
                "text": "这里安静得很。",
                "pinyin": "zhèlǐ ānjìng de hěn 。",
                "meaning": "It is very quiet here.",
                "audio": "12a5d54f9ce077f7234b09122ad03d95d5ea99227451cd84bb63896dd7ce23c1"
              },
              {
                "text": "我高兴极了。",
                "pinyin": "wǒ gāoxìng jí le 。",
                "meaning": "I am extremely happy.",
                "audio": "687e5ef51aba2ce5ea4ee4de79ef255cac84105ead8cad37dc9b65b3ab8bb930"
              },
              {
                "text": "孩子饿坏了。",
                "pinyin": "háizi è huài le 。",
                "meaning": "The child is terribly hungry.",
                "audio": "252c34a32f9d1024e8d53d1fd64f5af9b3d7394b989285df89a604c53800bbd1"
              },
              {
                "text": "他走了三天了。",
                "pinyin": "tā zǒu le sān tiān le 。",
                "meaning": "It has been three days since he left.",
                "audio": "670c1a00c68edabadcf81a9e8db1ef62eeeec5117f1bfa2b6263525715d6c86e"
              }
            ]
          },
