    "steps": [
      {
        "id": "EX-GRAM-G-continuing-duration-teach",
        "kind": "teach",
        "title": "How long up to now?",
        "blocks": [
          {
            "text": "An ongoing duration can use 了 after the verb and another 了 at the end. The final 了 makes the duration relevant now; do not add two automatically to every past action.",
            "examples": [
              {
                "text": "我在这里等你，等了一个小时了。",
                "pinyin": "wǒ zài zhèlǐ děng nǐ ， děng le yī gè xiǎoshí le 。",
                "meaning": "I am waiting for you here; I have been waiting for an hour now.",
                "audio": "f5f21779faaa12ef488a683d9a45f50a48077b35ea00ab939c24eefafb7b83c2"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
