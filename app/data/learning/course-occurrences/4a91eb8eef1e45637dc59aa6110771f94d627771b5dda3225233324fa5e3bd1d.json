  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-01-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A guest joins the group · 1",
    "context": "Use the selected vocabulary and constructions to welcome someone, establish relationships and resolve a misunderstanding about who is involved.",
    "steps": [
      {
        "id": "EX-CORE-U3-01-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-01-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A guest joins the group · 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "今天我和朋友去看奶奶的一位朋友。我小时候就认识她，每次都叫她奶奶。朋友听了，以为她也是我的奶奶，问我为什么有两个。\n\n我说：“我小时候就认识她，常常来她家，也叫她奶奶。她是我奶奶的朋友，不是我的家人，比我大很多。”朋友明白了，和我一起走进去。\n\n她的爱人也在家，我们叫他爷爷。他拿出一个本子，里面有我小时候写的字。我以前常来，他们一直把这个本子放好，没有拿走。\n\n朋友是第一次来，不知道我以前怎么写字。他看了以后笑了，说现在比以前好看多了。我又在本子上写了自己的名字，让他们看。\n\n走的时候，我又叫她奶奶，说下次有时间再来。朋友这次不再觉得我们一定是家人。他说，这样叫一个人，不是说一定是家人，也要先听那个人怎么介绍。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
              {
                "id": "r2",
                "text": "I connected a real condition or constraint to the result."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
