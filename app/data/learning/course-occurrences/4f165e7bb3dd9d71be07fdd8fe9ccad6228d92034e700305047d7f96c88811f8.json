  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-25-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Different readings of a work · 1",
    "context": "Use the selected vocabulary and constructions to compare interpretations of a cultural object or performance and support a reading with a detail.",
    "steps": [
      {
        "id": "EX-CORE-U4-25-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-25-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Different readings of a work · 1: A partner objects using only the initial account. Acknowledge the relevant concern, explain the later evidence or change, and clarify what action can actually be agreed.",
            "promptLanguage": "en",
            "context": "我和朋友看了一场表演，讲一个年轻人离开家去学习。最后他站在车站，看了看手里的信，没有说话。我觉得他很难过，朋友却觉得他正在准备新的生活。\n\n我们走出门时，都想让对方同意自己。后来朋友问，表演里有没有说他不想走。我想了想，没有。我这样想是因为他一直看着信，不是因为他说过不想去。\n\n朋友说，自己注意到年轻人最后还是走向了车，所以觉得有希望，这个动作我也看见了。我们看的表演一样，注意的地方不同，想法也就不一样。\n\n我们又看了介绍，作者写的是离开家时不一样的心情，没有说不能有两种感觉。一个人可以不想离开家，也可以想去学习，不一定只能有一种感觉。\n\n回去的路上，我没有再问谁看得对。我问朋友最记得哪一件事，他也问我为什么一直记着那封信。说起这些，我们比刚出来时更明白对方在看什么。\n\n后来有同学想看这场表演，我没有先说他应该有什么感觉，只告诉他我们看到了什么。等他看完再一起说说，可能还能注意到我们两个人都没看见的地方。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I acknowledged the concern without misrepresenting it."
              },
              {
                "id": "r2",
                "text": "My proposed agreement preserves the later evidence and remaining limitation."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
