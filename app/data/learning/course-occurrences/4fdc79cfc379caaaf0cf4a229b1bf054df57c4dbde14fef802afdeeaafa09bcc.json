    "title": "Describe a quality",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-adjective-predicate-teach",
        "kind": "teach",
        "title": "Describe a quality",
        "blocks": [
          {
            "text": "Put the quality directly after the subject, usually with lightly stressed 很 in a neutral description. Do not insert 是. 很 does not always mean strongly very.",
            "examples": [
              {
                "text": "大学很大。",
                "pinyin": "dàxué hěn dà 。",
                "meaning": "The university is big.",
                "audio": "6d46b9bc25c8e49fbb25bccd658e1d93e0963c8d4cfa85dbaff37afcc6718935"
              },
              {
                "text": "小学很小。",
                "pinyin": "xiǎoxué hěn xiǎo 。",
                "meaning": "The primary school is small.",
                "audio": "472d79feaa4284a571bed5c2cec5f87e43bef99e660a08164bafeee6c214dbb1"
              }
            ]
