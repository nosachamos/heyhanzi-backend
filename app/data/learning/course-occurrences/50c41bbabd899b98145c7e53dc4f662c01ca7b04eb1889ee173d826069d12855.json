    "revision": 1,
    "title": "Learn a communication strategy",
    "subtitle": "Learning and people around me · preparation 1",
    "context": "Use this subset of the reference vocabulary and constructions in a short self-contained situation, preparing for U02. Say who learns, reads, speaks and listens; connect people and shared activities.",
    "steps": [
      {
        "id": "EX-CORE-U02-skill-K-HSK1-compose-teach",
        "kind": "teach",
        "title": "HSK 1: compose",
        "blocks": [
          {
            "text": "In a personal message, make the person or group explicit before giving their role. A plural pronoun and a role statement serve different jobs; retain both when the group matters.",
            "examples": [
              {
                "text": "我们",
                "pinyin": "wǒmen",
                "meaning": "we; us",
                "singleWord": true,
                "audio": "6a0551f103146a14f85b981e69edca6a37e63489b6c933b5d8103e9428ca1467"
              },
              {
                "text": "学生",
                "pinyin": "xuéshēng",
                "meaning": "student; schoolchild",
                "singleWord": true,
                "audio": "3a595882d466c8b7a59f2ff0b72dbf61cb896d106d43e5462367c735b4260cbb"
              },
              {
                "text": "老师",
                "pinyin": "lǎoshī",
                "meaning": "teacher",
                "singleWord": true,
                "audio": "310e6b5e11de6adedbeb20515e73ec6357cf47c84ba79ce43f7858f24ded0eb2"
              },
              {
                "text": "是",
                "pinyin": "shì",
                "meaning": "be",
                "singleWord": true,
                "audio": "7940c81ffb1e91957744588fa3aeea82d09d9d422020f67f6e9d7f3b4ed610b8"
              }
            ]
          },
          {
            "text": "You and the classmates receiving this message are students. The teacher is a teacher, separate from your group. Write a group identification that preserves those two roles.\nFamiliar meanings available: we; us; student; schoolchild; teacher; be."
          }
        ]
      },
      {
        "id": "EX-CORE-U02-skill-K-HSK1-compose-perform",
        "kind": "check",
        "title": "Use the skill in context",
        "questions": [
