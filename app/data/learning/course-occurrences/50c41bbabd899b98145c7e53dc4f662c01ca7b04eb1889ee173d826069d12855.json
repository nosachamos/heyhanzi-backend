            "kind": "production",
            "response": "written",
            "prompt": "Write a short identification for a group of students and distinguish the teacher from that group.",
            "promptLanguage": "en",
            "context": "You and the classmates receiving this message are students. The teacher is a teacher, separate from your group. Write a group identification that preserves those two roles.\nFamiliar meanings available: we; us; student; schoolchild; teacher; be.",
            "contextLanguage": "en",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My message identifies the group and its role."
              },
              {
                "id": "r2",
                "text": "The teacher and students are not assigned the same role by accident."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
