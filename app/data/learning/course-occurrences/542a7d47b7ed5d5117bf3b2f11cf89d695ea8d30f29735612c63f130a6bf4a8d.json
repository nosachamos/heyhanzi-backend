  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-15-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "The intention was different · 1",
    "context": "Use the selected vocabulary and constructions to distinguish an expressed attitude from an assumption and repair a misunderstanding.",
    "steps": [
      {
        "id": "EX-CORE-U3-15-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-15-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "The intention was different · 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "我做了晚饭，请朋友来吃。他坐在桌子旁边，只吃了一点儿。我有点儿难过，以为做的饭不好吃。他说饭很好，是自己不太想吃。\n\n我再问，他说妈妈今天坐飞机来，现在还没有到。他不知道妈妈在哪里，心里着急。我明白了，他怕找不到妈妈，不是对晚饭不满意。\n\n我们给他妈妈打电话。她说飞机晚了，她还没有上飞机，身体很好，让我们放心。朋友听到她自己说，才不那么急了。\n\n他把手机放下，又吃了一点儿，说终于觉得饿了。我也开心了，没有再问他是不是不喜欢我做的饭。他说下次有事会先告诉我。\n\n吃完以后，我们一起等妈妈到。她一到机场，就给朋友打电话。朋友去见她，我把桌子上的东西放好。今天先听朋友说清楚，比一直让他多吃好。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
              {
                "id": "r2",
                "text": "I connected a real condition or constraint to the result."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
