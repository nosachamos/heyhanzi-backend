    "steps": [
      {
        "id": "EX-GRAM-G-addition-extended-teach",
        "kind": "teach",
        "title": "Add connected points and qualities",
        "blocks": [
          {
            "text": "而且 adds a further true point. 不但…而且… explicitly pairs not only with but also. 又…又… can combine two compatible qualities or actions. These connect predicates or clauses; they are not interchangeable with 和 joining nouns.",
            "examples": [
              {
                "text": "他会唱歌，而且会跳舞。",
                "pinyin": "tā huì chàng gē ， érqiě huì tiàowǔ 。",
                "meaning": "He can sing and can also dance.",
                "audio": "c03db26d73b8371619b8d06723179deeba25d12ff33eb2873e2d512a5eb2c879"
              },
              {
                "text": "他不但会唱歌，而且会跳舞。",
                "pinyin": "tā bùdàn huì chàng gē ， érqiě huì tiàowǔ 。",
                "meaning": "He can not only sing but also dance.",
                "audio": "e7c7ce7344fc89018b635f60425c2d6a729f3e0df92028db69a1c815c326454f"
              },
              {
                "text": "这本书又新又好。",
                "pinyin": "zhè běn shū yòu xīn yòu hǎo 。",
                "meaning": "This book is both new and good.",
                "audio": "1f5a5f6bc23e8f26891a3ffd65d4c29c7b58c2e8c34de656bbacefc717b6aebb"
              }
            ]
          },
