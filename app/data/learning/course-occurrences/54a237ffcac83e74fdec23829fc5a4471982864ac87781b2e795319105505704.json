  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-10-P01-speak",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Choosing what fits · 1 · preparation 1",
    "context": "Use this subset of the shopping vocabulary and constructions in a short self-contained situation, preparing for U4-10. Use the selected vocabulary and constructions to compare quantity, suitability and price before making a purchase.",
    "steps": [
      {
        "id": "EX-CORE-U4-10-P01-speak-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-10-P01-speak-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Choosing what fits · 1 · preparation 1: Explain the situation to someone who heard only the initial account. Clarify what changed, give a supported reason, and distinguish the participants’ stated intentions from assumptions.",
            "promptLanguage": "en",
            "context": "我和朋友准备请八个人来学校读书，每个人吃一个面包。我去买面包，店里的人拿来两包。我以为他听错了，告诉他是八个人，不是两个人。\n\n他把一包打开，让我看里面有四个面包。两包就是八个，每人一个，不多不少。我这才知道自己只听见两，没有注意后面说的是包，不是个。\n\n我给朋友打电话，说已经买好了。朋友问拿了几个，我没有只说两包，也说一包四个、两包八个。这样他知道要来的人每个都有，不用再去买。\n\n到了学校，一个同学先拿了一包，想把里面的都给自己。我告诉他，每个人拿一个，包只是放面包用的，不是说每个人分一包。他听完就把其他三个放好。\n\n大家来了以后，面包分完了，没有人少拿，也没有人多拿。我把放过面包的包收起来，发现买东西时先问里面有多少，比只听买了几包更有用。\n\n下次我们要请更多人，我会先看需要几个，再看一包里有几个。买的包一样多，里面的面包不一定一样多，不能因为今天两包八个，就觉得每一次都这样。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I retained the change or contrast that matters to the outcome."
              },
              {
                "id": "r2",
                "text": "I kept stated intentions separate from my assumptions."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
