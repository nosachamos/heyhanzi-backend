    "id": "ACT-GRAM",
    "revision": 6,
    "title": "Have you ever?",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-experience-guo-teach",
        "kind": "teach",
        "title": "Have you ever?",
        "blocks": [
          {
            "text": "Put 过 after the action to describe an experience at some time. Use 没有…过 to say it has never happened; this differs from reporting one particular completed event.",
            "examples": [
              {
                "text": "我去过中国。",
                "pinyin": "wǒ qù guo Zhōngguó 。",
                "meaning": "I have been to China.",
                "audio": "8e6b03f5a58ff11fc8da7c8d14a5275d79ee38a3e152accc8a304207ecb51a2c"
              },
              {
                "text": "我没有在中国住过。",
                "pinyin": "wǒ méiyǒu zài Zhōngguó zhù guo 。",
                "meaning": "I have never lived in China.",
                "audio": "4ce75116c6591f3581ac3a82e6a30b761b752fd006d90dbce163fab5867012ae"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "过",
                "pinyin": "guo",
                "meaning": "marks previous experience",
                "singleWord": true,
                "audio": "47b33150ea6ef1b0d9d76a6afbaee7189b8b305a44e66a2e2534940f1a68b04d"
              },
              {
                "text": "曾经",
