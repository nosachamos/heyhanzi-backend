        "kind": "teach",
        "title": "于 + time or place",
        "blocks": [
          {
            "text": "于 marks a concise written time or place relation, sometimes following a compatible verb. It does not permit arbitrary conversational word order.",
            "examples": [
              {
                "text": "会议于今天开始。",
                "pinyin": "huìyì yú jīntiān kāishǐ 。",
                "meaning": "The meeting begins today.",
                "audio": "d8ee3c261292d4687321eb642562146eb985ae4f81f08fe0bf6bae95b404844a"
              },
              {
                "text": "他出生于北京。",
                "pinyin": "tā chūshēng yú Běijīng 。",
                "meaning": "He was born in Beijing.",
