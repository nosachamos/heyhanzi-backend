        "id": "EX-GRAM-G-topic-omission-teach",
        "kind": "teach",
        "title": "Leave out what is already clear",
        "blocks": [
          {
            "text": "A shared topic can be stated first, then described. Omit a subject or object only when the conversation makes its identity clear; a short answer is not a new unknown subject.",
            "examples": [
              {
                "text": "这本书，我看过。",
                "pinyin": "zhè běn shū ， wǒ kàn guo 。",
                "meaning": "This book, I have read.",
                "audio": "3028002aa9692618902ccc8c7d4912ae2f8c696b6e9da8747d1f3c5d9c07e283"
              },
              {
                "text": "你喝茶吗？喝。",
                "pinyin": "nǐ hē chá ma ？ hē 。",
                "meaning": "Do you drink tea? Yes, I do.",
                "audio": "45d8052087196c4737b028f340acc4a705e7dd76b539d09bac40ee0486fa864f"
              }
            ]
