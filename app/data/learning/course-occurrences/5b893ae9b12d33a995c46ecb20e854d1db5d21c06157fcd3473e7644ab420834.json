    "steps": [
      {
        "id": "EX-GRAM-G-possessive-de-teach",
        "kind": "teach",
        "title": "Say whose something is",
        "blocks": [
          {
            "text": "Put the possessor before 的 and the possessed thing after it. With a pronoun and a noun naming a close family or personal relationship, 的 is often omitted: 我妈妈 means my mother, and 我朋友 means my friend. This omission does not make 的 unnecessary in every ownership phrase.",
            "examples": [
              {
                "text": "我的书",
                "pinyin": "wǒ de shū",
                "meaning": "My book.",
                "audio": "44efd9654ab7dee69ed50816004fbe85fd1260ae83f23cfed5c58ef1865b7a97"
              },
              {
                "text": "朋友的书",
                "pinyin": "péngyou de shū",
                "meaning": "A friend’s book.",
                "audio": "840ee284644e3a638e8e29f4482fff99450fbe363666c52d1581ff3ed1266df2"
              },
