    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-comparison-frames-teach",
        "kind": "teach",
        "title": "Frame comparisons and evaluations",
        "blocks": [
          {
            "text": "Repeated classifier comparisons show a progression. 在…方面 frames a domain; 拿…来说 selects an example. 够…的 can praise or evaluate a high degree, rather than sufficiency.",
            "examples": [
              {
                "text": "孩子一个比一个高。",
                "pinyin": "háizi yī gè bǐ yī gè gāo 。",
                "meaning": "Each child is taller than the last.",
                "audio": "2a40b50edd0661d426e47e5ad2fb8065bae13f75d3ab0e6110e1ea6e1deae317"
              },
              {
                "text": "在学习方面，他很努力。",
                "pinyin": "zài xuéxí fāngmiàn ， tā hěn nǔlì 。",
                "meaning": "He works hard in his studies.",
                "audio": "a1bf9db8e56eb52c4cd7477c0966dbee269310f4813d67dcb5ed6b61eb4e1113"
              },
              {
                "text": "拿我来说，我喜欢茶。",
                "pinyin": "ná wǒ láishuō ， wǒ xǐhuan chá 。",
                "meaning": "Take me, for example: I like tea.",
                "audio": "ee9c421321a2b4da836e616f44030dd93dc17e34de0a58866e4a9c7f403d0d9e"
              },
              {
                "text": "他够忙的。",
                "pinyin": "tā gòu máng de 。",
                "meaning": "He really is quite busy.",
                "audio": "b95648772c6ff3a59922ce72ba7d41d377cebf321566cf6faadef01e5fa0985a"
              }
            ]
