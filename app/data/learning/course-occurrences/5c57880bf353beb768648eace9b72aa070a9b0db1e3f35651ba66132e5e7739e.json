  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-16-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Different readings of a work · 1",
    "context": "Use the selected vocabulary and constructions to compare interpretations of a cultural object or performance and support a reading with a detail.",
    "steps": [
      {
        "id": "EX-CORE-U3-16-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-16-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Different readings of a work · 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "过节的时候，我和爷爷去他以前住的地方。他小时候常去的书店还在，我想进去买一本书。爷爷站在门口，看了很长时间，没有马上进去。\n\n我问他在看什么。他说以前和一个朋友总在这里见面，一起看书，后来朋友去了外地。今天看见门口，就想起两个人小时候的事。\n\n我想买了书就走，听了以后没有再急。我们坐在门口，我请他说一说那个朋友。他说他们以前喜欢一样的书，常常一起读。\n\n回家以后，我把爷爷说的写在本子上。妈妈问买了什么书，我说今天还听到了书里没有的故事。爷爷看着本子，又告诉我几个以前没有说的事。\n\n下次我还想和爷爷出去，不一定每次都去新的地方。一个地方看过了，不一定知道爷爷为什么喜欢它。今天没有买很多东西，我们都很高兴。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
              {
                "id": "r2",
                "text": "I connected a real condition or constraint to the result."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
    "summary": "Your results distinguish checked answers from self-reviewed practice. Unsampled material and unassessed proficiency remain separate.",
