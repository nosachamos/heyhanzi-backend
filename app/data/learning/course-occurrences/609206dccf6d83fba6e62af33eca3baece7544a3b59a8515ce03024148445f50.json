    "steps": [
      {
        "id": "EX-CORE-U27-skill-K-HSK3-interact-teach",
        "kind": "teach",
        "title": "HSK 3: interact",
        "blocks": [
          {
            "text": "Check agreement rather than assuming it. Restate the partner’s proposal, correct a mistaken assumption and leave a clear question for the partner.",
            "examples": [
              {
                "text": "同意",
                "pinyin": "tóngyì",
                "meaning": "to agree; to consent",
                "singleWord": true,
                "audio": "cf7ebab054c4582cc5b298c38c5b62f5fb3eb71a9e8d00535ef463cb62751b30"
              },
              {
                "text": "不同意",
                "pinyin": "bùtóngyì",
                "meaning": "disagree",
                "singleWord": true,
                "audio": "3c9b8c0809ae71a8d1b0680dfa307f8ddf061bcbeddea6a3b22b5d512944f00c"
              },
              {
                "text": "以为",
                "pinyin": "yǐwéi",
                "meaning": "think or assume, often with a mistaken belief",
                "singleWord": true,
                "audio": "f0e85a30ea9f6cadd59af8dfb0097b9907e1f4eb7a2eec08d9f57050e02e4ab5"
              },
              {
                "text": "建议",
                "pinyin": "jiànyì",
                "meaning": "suggest; suggestion",
                "singleWord": true,
                "audio": "6e8866f6aba3b867a01c96b6d25cd25d858bebe123fb3d9c086adb1df9a019dc"
              }
            ]
          },
          {
            "text": "A partner suggests meeting today and assumes you agree. You do not agree to today; you suggest tomorrow instead. The partner’s availability tomorrow is unknown. Correct the assumption and ask about that missing detail.\nFamiliar meanings available: to agree; to consent; disagree; think or assume, often with a mistaken belief; suggest; suggestion."
          }
        ]
      },
