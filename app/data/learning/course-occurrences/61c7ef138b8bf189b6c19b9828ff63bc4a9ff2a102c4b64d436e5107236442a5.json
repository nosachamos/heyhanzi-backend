    "steps": [
      {
        "id": "EX-GRAM-G-willingness-teach",
        "kind": "teach",
        "title": "Want to agree, not merely be able",
        "blocks": [
          {
            "text": "愿意 + action says that a person is willing to do it. 不愿意 denies willingness. Ability, permission, and a free schedule are different questions.",
            "examples": [
              {
                "text": "我愿意和你一起去。",
                "pinyin": "wǒ yuànyì hé nǐ yīqǐ qù 。",
                "meaning": "I am willing to go with you.",
                "audio": "7ab666d2b3c33bab417723d1e255da6e2d6332cea9172cd55a1ff0488a72f04b"
              },
              {
                "text": "我不愿意一个人去那里。",
                "pinyin": "wǒ bù yuànyì yī gè rén qù nàlǐ 。",
                "meaning": "I am not willing to go there alone.",
                "audio": "96bcadbcd32dcbb322a6646bc82ca015b67a8e82ad272a748df07149bf0327c7"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
