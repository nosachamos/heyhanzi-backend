        "kind": "teach",
        "title": "替 + beneficiary + action",
        "blocks": [
          {
            "text": "替 introduces the person benefited or replaced by an action. That person need not be the action's actual agent.",
            "examples": [
              {
                "text": "我替你去。",
                "pinyin": "wǒ tì nǐ qù 。",
                "meaning": "I will go in your place.",
                "audio": "b36f9699cc1d001ee25c97a9f2af9e28d6622f638f885e33f5509cb29d48b55d"
              },
              {
                "text": "请替我问他好。",
                "pinyin": "qǐng tì wǒ wèn tā hǎo 。",
                "meaning": "Please give him my regards.",
