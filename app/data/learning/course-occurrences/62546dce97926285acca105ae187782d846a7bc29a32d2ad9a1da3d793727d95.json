    "id": "ACT-GRAM",
    "revision": 8,
    "title": "Express indefinite and approximate quantities",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk2-quantities-p05-teach",
        "kind": "teach",
        "title": "Express indefinite and approximate quantities",
        "blocks": [
          {
            "text": "几 + classifier gives an unspecified small number; 好多 gives a vague large amount. After a round number, 多 precedes the classifier for an excess above that number.",
            "examples": [
              {
                "text": "我有几本书。",
                "pinyin": "wǒ yǒu jǐ běn shū 。",
                "meaning": "I have a few books.",
                "audio": "029b282396b8b7bfb78a22bfff888d88c634e725c808c9db5edcfb51e2464436"
              },
              {
                "text": "这里有好多人。",
                "pinyin": "zhèlǐ yǒu hǎoduō rén 。",
                "meaning": "There are lots of people here.",
                "audio": "3b046817513adcd2372a265494963bba5114f3ca61d1068e6fb375041ed9bdb8"
              },
              {
                "text": "二十多个人来了。",
                "pinyin": "èr shí duō gè rén lái le 。",
                "meaning": "More than twenty people came.",
                "audio": "239f7d38e9d6f7c1de616cdb462c49180a9bab4cda5f037a52ccf06eb39e29ea"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "多",
                "pinyin": "duō",
                "meaning": "more than; a little over (after a number or measured quantity)",
                "singleWord": true,
                "audio": "4c051f4d5d3dba36e6303ac51e1e5417829287acc8c1b984d49ecfb5fd649a5a"
              },
              {
                "text": "几",
