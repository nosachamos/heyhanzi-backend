  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U5-20-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Two explanations · 2",
    "context": "Use the selected vocabulary and constructions to compare accounts of a learning problem and identify a useful clarification.",
    "steps": [
      {
        "id": "EX-CORE-U5-20-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U5-20-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Two explanations · 2: A partner favors a different response to this situation. Ask which source detail supports their view, acknowledge the relevant point, and explain your response without overstating the evidence.",
            "promptLanguage": "en",
            "context": "我准备写一篇文章，讲自己在学习中经历的事情。老师给了我们一份参考材料。里面的作者讲自己怎样解决学习中遇到的问题，我觉得写得很好，想按照它的顺序写。\n\n同学提醒我，材料里的方法可以参考，经历却是作者自己的。我遇到的问题和他不同，不能直接按照他的顺序写，否则重要的内容反而可能放错地方。\n\n我把自己的经历先写下来，再看参考材料用了什么方法。我发现，它先说明困难，再用学习中发生的一件事解释为什么改变方法，这种方法比每个句子的位置更有用。\n\n于是，我留下适合自己经历的顺序，没有为了和参考材料一样，增加没有发生过的事情。老师读完以后，也能看出我为什么改变了学习方法。\n\n讨论时，一位同学问，是不是和参考材料越不同越好。老师说，也不是。重要的是内容是否符合实际、清楚好懂，和参考材料相同或者不同，都不能直接证明文章好坏。\n\n我明白了，参考文章要先看懂作者的方法为什么有用，再想怎样解决自己的问题。既不用把文章写得完全一样，也不必故意写得不同，符合实际才重要。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My clarification targets the partner’s reason."
              },
              {
                "id": "r2",
                "text": "My response addresses that reason and preserves the source’s limits."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
