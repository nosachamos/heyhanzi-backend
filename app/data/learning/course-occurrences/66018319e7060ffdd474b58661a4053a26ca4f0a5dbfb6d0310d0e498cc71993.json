        "questions": [
          {
            "id": "EX-CORE-U17-P01-compose-draft",
            "kind": "production",
            "response": "written",
            "prompt": "How long things last · preparation 1: Write a connected update for someone who missed the event. Include the situation, what happened or is planned, and a supported reason or next action.",
            "promptLanguage": "en",
            "context": "我在学校等朋友。他想来和我看书。我的书在这里，他的书在家里。学生在外边吃饭，我在这里等朋友。\n\n老师看见我，问：“你在做什么？不去吃饭吗？”我说：“我正在等朋友。我喜欢看书，他也喜欢。”\n\n朋友来了。他说：“你在这里等我一下吧。我的书还在家里，我现在想回家去。”我说：“你看我的书吧，我有两本。”他说：“好，谢谢！”",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I preserved the event status and participants."
              },
              {
                "id": "r2",
                "text": "My update connects the account to a relevant reason or next action."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
