    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-imminent-teach",
        "kind": "teach",
        "title": "Say an event is about to happen",
        "blocks": [
          {
            "text": "Use 要…了, 快/快要…了 or 就要…了 for an imminent event, not a completed one. A stated future time can go with 就要…了; choose a frame that fits the intended time context.",
            "examples": [
              {
                "text": "要下雨了。",
                "pinyin": "yào xiàyǔ le 。",
                "meaning": "It is about to rain.",
                "audio": "dd98badc809028e097ae310c3f8679d9cc7183c8ff6c7e2071e65028b4196d06"
              },
              {
                "text": "我们快要到了。",
                "pinyin": "wǒmen kuàiyào dào le 。",
                "meaning": "We are about to arrive.",
                "audio": "7012048a561db04333301293565f0ef6fef4cdef48510873faeb102c37cba9df"
              },
              {
                "text": "明天就要上课了。",
                "pinyin": "míngtiān jiùyào shàngkè le 。",
                "meaning": "Classes are about to start tomorrow.",
                "audio": "db822b0e81695464f2ef1845b4c6490aac3e496c17c453e58b3ca0f13a3675d2"
              }
            ]
          },
          {
