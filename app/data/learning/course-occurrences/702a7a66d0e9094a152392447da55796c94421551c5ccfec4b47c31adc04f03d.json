    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-existence-teach",
        "kind": "teach",
        "title": "Describe appearance and disappearance",
        "blocks": [
          {
            "text": "A location followed by an arrival or disappearance event introduces what appeared or left there. Use a suitable verb and an indefinite quantified entity. An existential-presentative frame can also introduce disappearance or departure from a location, rather than only arrival.",
            "examples": [
              {
                "text": "学校来了一位老师。",
                "pinyin": "xuéxiào lái le yī wèi lǎoshī 。",
                "meaning": "A teacher has arrived at the school.",
                "audio": "8a93b36a30f75a6a1edbb00f471e7923478d6e101f91f5c678df4de4e0938894"
              },
              {
                "text": "门口走进来一个人。",
                "pinyin": "ménkǒu zǒu jìn lái yī gè rén 。",
                "meaning": "A person walks in through the doorway.",
                "audio": "fe5da3ed3a0a264af238f20cac2a40cbe54d3f81143a2757ff57117b1af15d4e"
              },
              {
                "text": "学校走了两个老师。",
                "pinyin": "xuéxiào zǒu le liǎng gè lǎoshī 。",
                "meaning": "Two teachers have left the school.",
                "audio": "da9769acefa7edaa47d7cd9db8b137fef1ef4f64289d70be53c814052a9141bc"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
