        "blocks": [
          {
            "text": "刻 is a quarter of an hour. In clock time, 点 + 一刻 names fifteen minutes past the hour.",
            "examples": [
              {
                "text": "现在八点一刻。",
                "pinyin": "xiànzài bā diǎn yī kè 。",
                "meaning": "It is a quarter past eight.",
                "audio": "e069835cf7ae49fec0a2fd36d6ffddc79c805dc1667692ab711a5b8d2c1dd340"
              },
              {
                "text": "我等了一刻。",
                "pinyin": "wǒ děng le yī kè 。",
                "meaning": "I waited a quarter of an hour.",
                "audio": "5bbe26d8ece811a940da7cea8a6d3a63cd484c33872c7e0dfaa3deb7d810bdde"
