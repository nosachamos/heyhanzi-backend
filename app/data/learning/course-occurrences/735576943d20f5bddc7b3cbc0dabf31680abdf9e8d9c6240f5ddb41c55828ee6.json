    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-prepositions-p09-teach",
        "kind": "teach",
        "title": "由于 + cause",
        "blocks": [
          {
            "text": "由于 introduces the cause of a situation. It explains what produced the result, rather than what someone hopes to achieve.",
            "examples": [
              {
                "text": "由于下雨，比赛取消了。",
                "pinyin": "yóuyú xiàyǔ ， bǐsài qǔxiāo le 。",
                "meaning": "The match was canceled because of the rain.",
                "audio": "70bb1aa6ca025297b377d82a1363751b92e4486854df23939cd940c5223a3647"
              },
              {
                "text": "由于工作忙，他没来。",
                "pinyin": "yóuyú gōngzuò máng ， tā méi lái 。",
                "meaning": "He did not come because he was busy with work.",
                "audio": "485464119a8144a0b6e90fde3d5e6a540741ef4f3c200bfd22f9bcf55d7bb092"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "由于",
                "pinyin": "yóuyú",
                "meaning": "due to; as a result of",
