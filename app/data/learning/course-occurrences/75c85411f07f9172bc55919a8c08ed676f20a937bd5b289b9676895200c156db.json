    "steps": [
      {
        "id": "EX-GRAM-G-hsk2-direction-r5-03-teach",
        "kind": "teach",
        "title": "Compound inward and outward motion",
        "blocks": [
          {
            "text": "Combine a path with 来 or 去, as in 进来 or 出去. With a destination, place that destination before the final 来 or 去; object order is not freely interchangeable. With a destination, place the location before the final 来/去: 进学校来, not 进来学校.",
            "examples": [
              {
                "text": "他进来了，我出去了。",
                "pinyin": "tā jìnlái le ， wǒ chūqù le 。",
                "meaning": "He came in; I went out.",
                "audio": "a70b3e82292136456624769fda1e2a76e6473513aca0da02e4ea4d5e3522996e"
              },
              {
                "text": "他进学校来了。",
                "pinyin": "tā jìn xuéxiào lái le 。",
                "meaning": "He came into the school, toward the speaker inside.",
                "audio": "2017aad525b0029aadaa1a9bf02481097b86543eff4296a3abbe52d3b4a89c03"
              },
              {
                "text": "他出学校去了。",
                "pinyin": "tā chū xuéxiào qù le 。",
                "meaning": "He went out of the school, away from the speaker inside.",
                "audio": "17eb53d1261d4b95fd0f535d101a160103a971015f95a6b41b7c6088b2998891"
              }
            ]
