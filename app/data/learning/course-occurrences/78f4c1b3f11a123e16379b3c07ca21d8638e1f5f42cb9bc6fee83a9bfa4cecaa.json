        "kind": "teach",
        "title": "特地 + purposeful action",
        "blocks": [
          {
            "text": "特地 emphasizes that an action was specially arranged for a purpose, rather than occurring by coincidence.",
            "examples": [
              {
                "text": "他特地来看我。",
                "pinyin": "tā tèdì lái kàn wǒ 。",
                "meaning": "He made a special trip to see me.",
                "audio": "a97fc65dc5005e592d2acd0de3e7201ecc72fa1e2e8fc38c09d4af82d3dd7017"
              },
              {
                "text": "我特地给你买了书。",
                "pinyin": "wǒ tèdì gěi nǐ mǎi le shū 。",
                "meaning": "I bought the book especially for you.",
                "audio": "aee3eb4ec3665b0e588a782100ae9bc8c85807ab8ad7019c6e05ac63b6123b03"
              }
            ]
          },
          {
