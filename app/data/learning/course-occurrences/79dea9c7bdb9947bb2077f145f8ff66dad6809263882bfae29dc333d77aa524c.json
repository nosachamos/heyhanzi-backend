    "steps": [
      {
        "id": "EX-CORE-U27-skill-K-HSK3-compose-teach",
        "kind": "teach",
        "title": "HSK 3: compose",
        "blocks": [
          {
            "text": "A practical explanation needs a viewpoint and a relevant reason. Keep the reason connected to the decision instead of listing unrelated sentences.",
            "examples": [
              {
                "text": "认为",
                "pinyin": "rènwéi",
                "meaning": "to believe; to think",
                "singleWord": true,
                "audio": "cb6fec095e11769414fd90d687de1cd4adc5a3c7f78407502416584a9885e0a5"
              },
              {
                "text": "原因",
                "pinyin": "yuányīn",
                "meaning": "reason; cause",
                "singleWord": true,
                "audio": "d18d6d18d7cb9cfdd3fd3940144951f44cc062d227301e5d202ee09a3eb93310"
              },
              {
                "text": "因为",
                "pinyin": "yīnwèi",
                "meaning": "because; owing to",
                "singleWord": true,
                "audio": "9f45c18a9e0e1057de861448bc1f80a947cfae6803d918333f62b3c109d066ba"
              },
              {
                "text": "所以",
                "pinyin": "suǒyǐ",
                "meaning": "therefore; as a result",
                "singleWord": true,
                "audio": "1ffe974a6ff1a915af3cda6324f105e1fabeeeebe4f9a536c4b9fc919b2faba3"
              }
            ]
          },
          {
            "text": "Two partners discussed meeting today or tomorrow. Today one partner has no free time; both have free time tomorrow. They decided to meet tomorrow for that reason. Explain this decision to the absent third partner.\nFamiliar meanings available: to believe; to think; reason; cause; because; owing to; therefore; as a result."
          }
        ]
      },
