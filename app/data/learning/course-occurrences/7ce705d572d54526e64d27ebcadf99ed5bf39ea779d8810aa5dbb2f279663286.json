  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U32-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "Bridge: combining explanations and repair",
    "context": "Transfer the early HSK 3 constructions into connected explanations before extending the level vocabulary; this is an intermediate bridge, not the HSK 3 boundary.",
    "steps": [
      {
        "id": "EX-CORE-U32-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U32-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "Bridge: combining explanations and repair: Write a practical explanation for someone joining the situation late. State the problem, a supported reason or constraint, and a clear proposed next step.",
            "promptLanguage": "en",
            "context": "今天我去医院见医生。医生昨天让我带药来，我准备好了，药还在家里的桌子上。到了医院，我打开书包，里面有一本书，没有药。\n\n我以为药已经放进书包里了，到了医院才发现还在家里的桌子上。我给正在我家里等我的朋友打电话，对他说：“如果你有时间，请把桌子上的药拿来，我在医院门口等你。你要是不能来，就先告诉我，我自己回家拿。”\n\n朋友说他有时间，可以送来。他问：“医院是不是在商店旁边？”我说：“不是，医院在学校旁边。你不要去商店，来医院。”\n\n朋友拿到了药，先去学校，再找旁边的医院。我在医院门口等他。他把药给我，说：“这次不要再忘记了。”我把药放好，给医生看。\n\n我把药给医生看，也告诉他是朋友把忘在家里的药送来的。朋友帮我解决了没有带药的问题，我谢谢他，也记住了下次出门前先看看书包。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The problem, constraint and next step connect coherently."
              },
              {
                "id": "r2",
                "text": "I distinguished the source facts from my proposal."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
