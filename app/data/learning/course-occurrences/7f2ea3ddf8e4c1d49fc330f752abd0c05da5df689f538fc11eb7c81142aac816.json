        "kind": "teach",
        "title": "同 + participant + relational predicate",
        "blocks": [
          {
            "text": "同 introduces the other participant in a relationship, often formally. It is not the adjective identical in this use.",
            "examples": [
              {
                "text": "我同他一起工作。",
                "pinyin": "wǒ tóng tā yīqǐ gōngzuò 。",
                "meaning": "I work together with him.",
                "audio": "85bd7d4a34bce17e879562cae38fb6dfcf78ea4788390de623ad952d0d9c4cdc"
              },
              {
                "text": "这件事同我有关。",
                "pinyin": "zhè jiàn shì tóng wǒ yǒuguān 。",
                "meaning": "This matter concerns me.",
                "audio": "51b5366fab66a39f6c271e0bd33d9bb7c86e8d57a8a247f517f0977e77c8c489"
              }
