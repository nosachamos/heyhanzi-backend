  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U3-18-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "A tool behaves unexpectedly · 1",
    "context": "Use the selected vocabulary and constructions to describe a technical problem, compare explanations and choose a next step.",
    "steps": [
      {
        "id": "EX-CORE-U3-18-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U3-18-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "A tool behaves unexpectedly · 1: Write a practical explanation for someone joining the situation late. State the problem, a supported reason or constraint, and a clear proposed next step.",
            "promptLanguage": "en",
            "context": "我准备坐三个小时的火车，想在路上看电子书。朋友让我带一本纸做的书，但我说手机里有很多书，不带纸做的书，就可以用小一点儿的书包。\n\n上车以后，我先看了一会儿节目，再听音乐。用耳机听，旁边的人听不见声音，我自己听得很清楚。后来手机没有电了，电子书也看不了。\n\n我在书包里找到了朋友放进去的书，里面还有一张纸，写着让我在路上看。我把手机放好，打开书，是我一直想看的故事。\n\n我看了一个多小时，火车到了。我没有看完，把那张纸放在看到的地方，下次打开就知道从哪里看。到家以后，我用家里的电话给朋友打电话说谢谢。\n\n下次坐车，我会先看看手机有没有电，也会带一本小一点儿的书。电子书在手机里，手机没电时，纸做的书也能看。两种办法让我在路上都可以看书。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The problem, constraint and next step connect coherently."
              },
              {
                "id": "r2",
                "text": "I distinguished the source facts from my proposal."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
