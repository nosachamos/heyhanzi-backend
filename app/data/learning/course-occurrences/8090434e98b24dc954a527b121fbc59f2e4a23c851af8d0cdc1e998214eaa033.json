        "blocks": [
          {
            "text": "刚好 marks an exact fit or coincidence. It does not mean approximate or just recently in this use.",
            "examples": [
              {
                "text": "我刚好有时间。",
                "pinyin": "wǒ gānghǎo yǒu shíjiān 。",
                "meaning": "I happen to have time.",
                "audio": "6ebaa9eec2ebc6bfc7461d2ef9810d529cf37dc28ad1bc3819231fcaf82c6f3a"
              },
              {
                "text": "钱刚好够。",
                "pinyin": "qián gānghǎo gòu 。",
