    "steps": [
      {
        "id": "EX-GRAM-G-hsk2-direction-r5-04-teach",
        "kind": "teach",
        "title": "Compound vertical and crossing motion",
        "blocks": [
          {
            "text": "Compound directional complements combine a path with a viewpoint. In 站起来, 起来 describes rising to a standing position; its final 来 does not require movement toward the speaker.",
            "examples": [
              {
                "text": "我在楼上，你走上来吧。",
                "pinyin": "wǒ zài lóu shàng ， nǐ zǒu shànglái ba 。",
                "meaning": "I am upstairs; walk up here.",
                "audio": "7bcc98d4ebea5c084a35aa0d5d1903bd66a723436304b84cc3bf202333f2dda6"
              },
              {
                "text": "他从楼上走下去了。",
                "pinyin": "tā cóng lóu shàng zǒu xiàqù le 。",
                "meaning": "He walked down from upstairs, away from this viewpoint.",
                "audio": "5510768875395094dd88355fb9d66fa93d94d4ebfe7c3f905be50d34d84a7f96"
              },
              {
                "text": "请站起来。",
                "pinyin": "qǐng zhàn qǐlái 。",
                "meaning": "Please stand up, regardless of where the speaker is.",
                "audio": "04c980899b31f442b653428f2375a55c4a653f8f7420cd8b80475800a9c8e68e"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
