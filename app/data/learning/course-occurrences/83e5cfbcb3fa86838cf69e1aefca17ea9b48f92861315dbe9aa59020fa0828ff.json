        "id": "EX-GRAM-G-hsk3-frames-r5-03-teach",
        "kind": "teach",
        "title": "Say whose perspective matters",
        "blocks": [
          {
            "text": "对 + person + 来说 frames the following evaluation from that person’s perspective. 来说 is part of this frame; the person need not be literally coming over to speak.",
            "examples": [
              {
                "text": "对我来说，这件事需要时间。",
                "pinyin": "duì wǒ láishuō ， zhè jiàn shì xūyào shíjiān 。",
                "meaning": "For me, this takes time.",
                "audio": "9048c3bb4ee3ed4d46e577a831f0e559a61af32fe41b0d4415b04668a859ff8f"
              }
            ]
          },
