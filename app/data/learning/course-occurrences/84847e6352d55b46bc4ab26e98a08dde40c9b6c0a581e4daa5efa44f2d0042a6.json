    "steps": [
      {
        "id": "EX-CORE-U16-skill-K-HSK2-speak-teach",
        "kind": "teach",
        "title": "HSK 2: speak",
        "blocks": [
          {
            "text": "Anchor a particular event in its occasion; describe experience only when that is the intended claim. Use a time detail or reason already taught rather than adding unrelated vocabulary.",
            "examples": [
              {
                "text": "旅游",
                "pinyin": "lǚyóu",
                "meaning": "travel; go on a trip",
                "singleWord": true,
                "audio": "249bf6122d33e3fe2101c11868ec196ec95e762e1d260d3db56a50b139dea203"
              },
              {
                "text": "北京",
                "pinyin": "Běijīng",
                "meaning": "Beijing",
                "singleWord": true,
                "audio": "031e9030f2277b69198b22fb99e00302da83a1075aca1d561cbb2c43a61a1a7c"
              },
              {
                "text": "曾经",
                "pinyin": "céngjīng",
                "meaning": "previously; once",
                "singleWord": true,
                "audio": "8110e9bb0a9036407c22745b5bb3004f0d8091d13ebbf224eff3186f143147d7"
              }
            ]
          },
          {
            "text": "You have visited Beijing before; this is an experience claim, with no date supplied. Your partner went to Beijing yesterday; that is a particular event. Tell the partner about your own prior experience and distinguish it from their dated trip.\nFamiliar meanings available: travel; go on a trip; Beijing; previously; once."
          }
        ]
      },
