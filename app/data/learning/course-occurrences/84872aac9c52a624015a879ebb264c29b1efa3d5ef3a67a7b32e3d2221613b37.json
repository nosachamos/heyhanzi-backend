    "steps": [
      {
        "id": "EX-GRAM-G-hsk6-phrases-r5-04-teach",
        "kind": "teach",
        "title": "算了 and 得了",
        "blocks": [
          {
            "text": "This conversational response closes a matter or abandons an attempt. Tone can convey acceptance, disappointment or dismissal; it does not refer to calculating. 得了 déle can dismiss a claim or stop an unwelcome action in informal conversation. It may sound brusque; it is not the compositional meaning obtained.",
            "examples": [
              {
                "text": "太晚了，算了，明天再去。",
                "pinyin": "tài wǎn le ， suànle ， míngtiān zài qù 。",
                "meaning": "It is too late. Never mind; we will go tomorrow.",
                "audio": "adbdf9537550f79d241257f2fce001a468a24736ec48b063e94ce2801f2fe830"
              },
              {
                "text": "得了，别再说了。",
                "pinyin": "déle ， bié zài shuō le 。",
                "meaning": "Enough; stop talking. An informal, potentially brusque dismissal.",
                "audio": "196a184cfe6d185cc813ab761814652fa73ace7577d0b28fa13bc23fb32f7fdb"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
