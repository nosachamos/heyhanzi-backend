    "steps": [
      {
        "id": "EX-GRAM-G-preferences-teach",
        "kind": "teach",
        "title": "Express liking and preference",
        "blocks": [
          {
            "text": "Put a thing or an activity after 喜欢. 更喜欢 expresses a relative preference: connect it to the alternative being compared, rather than treating 更 as just very.",
            "examples": [
              {
                "text": "我喜欢苹果。",
                "pinyin": "wǒ xǐhuan píngguǒ 。",
                "meaning": "I like apples.",
                "audio": "ce6f04e97c180ae2076d170d510eeaa717f2fb74341e8f79c77ac7855f580acb"
              },
              {
                "text": "我喜欢喝茶。",
                "pinyin": "wǒ xǐhuan hē chá 。",
                "meaning": "I enjoy drinking tea.",
                "audio": "a387a9dfb6b49efd7f7d1c44eb73966b504ecc6c699d5b025eaf4c753749d65b"
              },
              {
                "text": "我喜欢茶，更喜欢牛奶。",
                "pinyin": "wǒ xǐhuan chá ， gèng xǐhuan niúnǎi 。",
                "meaning": "I like tea, but I like milk even more.",
                "audio": "53a29208d11d77e3e1607a9363b9ccdb34ba57a7ecb7f47b22a4708087a1eb96"
              }
            ]
          },
