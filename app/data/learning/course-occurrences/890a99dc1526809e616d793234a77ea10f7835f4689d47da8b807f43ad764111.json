    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-already-still-teach",
        "kind": "teach",
        "title": "Say already and still",
        "blocks": [
          {
            "text": "已经 marks an attained state; 还 marks continuation. 还没 means not yet, whereas 不再 means no longer.",
            "examples": [
              {
                "text": "他已经来了。",
                "pinyin": "tā yǐjīng lái le 。",
                "meaning": "He has already arrived.",
                "audio": "d3be4653b4c61cd5e081dcbfc9561f1c2ef76f1f8694c7617bbb09243ddc188d"
              },
              {
                "text": "他还没来。",
                "pinyin": "tā hái méi lái 。",
                "meaning": "He has not arrived yet.",
                "audio": "35d789a57873159a56aabd2c23c1e27c8dbd67578e9e54d43cfbb472569c4bce"
              },
              {
                "text": "他还在这里。",
                "pinyin": "tā hái zài zhèlǐ 。",
                "meaning": "He is still here.",
                "audio": "cb20351ad1055aa823fa0d6b25b5cd4796efcbf61776a85bda2bbfe593bfa26d"
              }
            ]
          },
          {
