        "blocks": [
          {
            "text": "立刻 demands or describes action with virtually no delay after a trigger. It is stronger than a vague soon.",
            "examples": [
              {
                "text": "他立刻站起来。",
                "pinyin": "tā lìkè zhàn qǐlái 。",
                "meaning": "He stood up immediately.",
