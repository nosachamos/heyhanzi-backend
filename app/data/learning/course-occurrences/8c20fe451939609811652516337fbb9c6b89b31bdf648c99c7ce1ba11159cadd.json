    "steps": [
      {
        "id": "EX-GRAM-G-hsk6-stance-p08-teach",
        "kind": "teach",
        "title": "倒是 + proposition",
        "blocks": [
          {
            "text": "倒是 concedes a point while retaining a contrast or reservation. It does not describe physically turning something over.",
            "examples": [
              {
                "text": "书倒是很好，就是贵了点儿。",
                "pinyin": "shū dàoshì hěn hǎo ， jiùshì guì le diǎnr 。",
                "meaning": "The book is good, admittedly; it is just a bit expensive.",
                "audio": "75674d8ebb70ec1c75c28b351287f78c633f3691177dce34a01eeddab079fa79"
              },
              {
                "text": "我倒是想去，可是没时间。",
                "pinyin": "wǒ dàoshì xiǎng qù ， kěshì méi shíjiān 。",
                "meaning": "I would like to go, but I have no time.",
                "audio": "300ead42aa62e7c71be29f76742aa7acca7c2917d75a1e3ce0765bdf4a5b388e"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
