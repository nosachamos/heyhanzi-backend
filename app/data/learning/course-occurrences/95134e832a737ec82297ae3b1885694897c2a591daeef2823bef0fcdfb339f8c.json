        "kind": "teach",
        "title": "群: measure compatible referents",
        "blocks": [
          {
            "text": "群 counts groups, not individual members. A group can contain many people or animals.",
            "examples": [
              {
                "text": "一群孩子来了。",
                "pinyin": "yī qún háizi lái le 。",
                "meaning": "A group of children came.",
                "audio": "2274af8c0ec0d472273a33786edabba61e1aa904ae40d2ff42b20872669379ef"
              },
              {
                "text": "那里有一群羊。",
                "pinyin": "nàlǐ yǒu yī qún yáng 。",
                "meaning": "There is a flock of sheep there.",
                "audio": "fa7965192c319cc35d8af51ccc41a48dfc96f270251f046cc393cf33e4dada87"
              }
            ]
          },
