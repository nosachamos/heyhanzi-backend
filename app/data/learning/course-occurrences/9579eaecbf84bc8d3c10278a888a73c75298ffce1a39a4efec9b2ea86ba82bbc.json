    "steps": [
      {
        "id": "EX-GRAM-G-hsk5-time-p04-teach",
        "kind": "teach",
        "title": "连忙 + response action",
        "blocks": [
          {
            "text": "连忙 describes a hurried response to a newly encountered situation. It normally narrates a response rather than giving a neutral schedule.",
            "examples": [
              {
                "text": "看到老师，他连忙站起来。",
                "pinyin": "kàn dào lǎoshī ， tā liánmáng zhàn qǐlái 。",
                "meaning": "Seeing the teacher, he hurriedly stood up.",
                "audio": "5528998efc59e19ef83ff2a5b2a409290ad7a794120763e9f0e8128c372bd8dc"
              },
              {
                "text": "我连忙给他打电话。",
                "pinyin": "wǒ liánmáng gěi tā dǎdiànhuà 。",
                "meaning": "I hurriedly called him.",
                "audio": "b8bd9f21c3e62a1b6e9c89e795665d1b99dbb03f4537cbbd84d888911bb14f0a"
              }
            ]
          },
