        "title": "急忙 + action",
        "blocks": [
          {
            "text": "急忙 describes hurried conduct caused by urgency. It concerns the participant's response, not simply a scheduled quick event.",
            "examples": [
              {
                "text": "他急忙跑出去。",
                "pinyin": "tā jímáng pǎo chūqù 。",
                "meaning": "He hurriedly ran out.",
                "audio": "2c1d2e28db7143535afd310b52bac828318b98d1cd5ec5a1c9c6e6b9fd874b45"
              },
              {
                "text": "她急忙关上门。",
                "pinyin": "tā jímáng guān shàng mén 。",
                "meaning": "She hurriedly closed the door.",
                "audio": "0287b0101e3fd6f4938e94051ebd11e24b0c739d7023ba292e1cbfb01fc085af"
              }
            ]
