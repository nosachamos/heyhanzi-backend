    "steps": [
      {
        "id": "EX-GRAM-G-hsk1-classifiers-p04-teach",
        "kind": "teach",
        "title": "口: measure compatible referents",
        "blocks": [
          {
            "text": "口 counts members of a household in a family-size expression. It is not the general polite classifier for people everywhere.",
            "examples": [
              {
                "text": "我家有三口人。",
                "pinyin": "wǒ jiā yǒu sān kǒu rén 。",
                "meaning": "There are three people in my family.",
                "audio": "e6cdf0a3777aa2907e1b3feb5d4c9bbdc477c737f0a252df7d3a4846d4d23950"
              },
              {
                "text": "他家有五口人。",
                "pinyin": "tā jiā yǒu wǔ kǒu rén 。",
                "meaning": "There are five people in his family.",
                "audio": "d4ed2eb63d9da7bbccaa973744d12179cef488c4961e56bc0dd904e294862ca8"
              }
            ]
          },
