  "definition": {
    "id": "ACT-GRAM",
    "revision": 8,
    "title": "Give, help and ask someone to act",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-give-help-cause-teach",
        "kind": "teach",
        "title": "Give, help and ask someone to act",
        "blocks": [
          {
            "text": "With 给 meaning give, put the recipient before the item. 帮 introduces someone being helped to act. With 让 or 叫, distinguish the person giving the instruction from the person who performs the following action.",
            "examples": [
              {
                "text": "我给妈妈一杯水。",
                "pinyin": "wǒ gěi māma yī bēi shuǐ 。",
                "meaning": "I give Mom a cup of water.",
                "audio": "3696bbc01442555e1de97805dda518d1ece8dc87b0baa16ccc414d2a2e65027b"
              },
              {
                "text": "我帮他学中文。",
                "pinyin": "wǒ bāng tā xué Zhōngwén 。",
                "meaning": "I help him study Chinese.",
                "audio": "83e42113ec5415ca9899749f01787996107c8eb6c96033b189e2097d5ae216b6"
              },
              {
                "text": "老师让我来。",
                "pinyin": "lǎoshī ràng wǒ lái 。",
                "meaning": "The teacher asks me to come.",
                "audio": "2bd59bd0d0610ec7ad1c115b5424fcad5b97962600b8eeb0f51e3b7d7ea173bd"
              },
              {
                "text": "妈妈叫我来。",
                "pinyin": "māma jiào wǒ lái 。",
                "meaning": "Mom tells me to come.",
                "audio": "2abc577540543e4bdc29c59399a099608143b2757f6992458fe48991101e59ba"
              }
            ]
          },
