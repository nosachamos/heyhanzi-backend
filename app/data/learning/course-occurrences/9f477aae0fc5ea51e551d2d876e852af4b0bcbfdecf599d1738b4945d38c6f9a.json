    "steps": [
      {
        "id": "EX-GRAM-G-hsk1-classifiers-p09-teach",
        "kind": "teach",
        "title": "Distinguish cups from cupfuls",
        "blocks": [
          {
            "text": "杯 before a drink counts cupfuls. It tells the amount, rather than naming the cup as an object. 杯 counts cupfuls of a substance; 个 counts individual cups as objects.",
            "examples": [
              {
                "text": "一杯水",
                "pinyin": "yī bēi shuǐ",
                "meaning": "a cup of water",
                "audio": "51690b6c6fb7fcc55ead1d9a032c3d5556504cfaf02a04d35d4fe8ac5876a419"
              },
              {
                "text": "两杯水",
                "pinyin": "liǎng bēi shuǐ",
                "meaning": "two cups of water",
                "audio": "6feafb296743a2b9fe1d00e6bbf6a5b76b5135a1f982c55a625b9972a7e2fc9f"
              },
              {
                "text": "两个杯子",
                "pinyin": "liǎng gè bēizi",
                "meaning": "two cups as objects",
                "audio": "3bb2f062f45d0c652c4d4f0b4425a105f6893c5e24f589fad669153385525a30"
              }
