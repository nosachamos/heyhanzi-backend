    "id": "ACT-GRAM",
    "revision": 5,
    "title": "Say where and what",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-warmup-here-teach",
        "kind": "teach",
        "title": "Say where and what",
        "blocks": [
          {
            "text": "Use 在 before a place. To add an action, put the place before that action. 看 refers to reading or looking; 说 refers to speaking.",
            "examples": [
              {
                "text": "她在这。",
                "pinyin": "tā zài zhè 。",
                "meaning": "She is here.",
                "audio": "c85a0501061b5ef1dc3e9cd58feb6d4f1ebf14d35aca919f91f6dbc08eaa31be"
              },
              {
                "text": "我在这看中文。",
                "pinyin": "wǒ zài zhè kàn Zhōngwén 。",
                "meaning": "I read Chinese here.",
                "audio": "fdbfe81ede2f488d093f9594a2ec4b09a043b55b2834a9314831966d0f67580f"
              },
              {
                "text": "他说中文。",
                "pinyin": "tā shuō Zhōngwén 。",
                "meaning": "He speaks Chinese.",
                "audio": "f694e473bd08edb888193767c4c948f212f0b9e87a6201fb290282581ae20bd0"
              }
            ]
          },
