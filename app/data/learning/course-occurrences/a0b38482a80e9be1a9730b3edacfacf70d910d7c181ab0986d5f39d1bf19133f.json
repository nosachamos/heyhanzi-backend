  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-14-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A project changes direction · 1",
    "context": "Use the selected vocabulary and constructions to allocate responsibilities, identify a constraint and explain a revised decision.",
    "steps": [
      {
        "id": "EX-CORE-U3-14-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-14-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A project changes direction · 1: A partner proposes acting immediately on the first part of this account. Explain the later information they need, ask one clarification, and negotiate a suitable next step.",
            "promptLanguage": "en",
            "context": "经理让我选一个时间开会，问问同事哪天有时间。我先问了三个人，他们都说星期二下午可以。我以为大家都有时间，就准备告诉经理。\n\n同事说，还有两个人星期二要去外地，不能开会。我把他们的时间也写下来。为了让大家都能来，我需要再想一个方法，不能只问坐在身边的人。\n\n我把星期二和星期三写在纸上，让每个人选能来的时间。根据大家写的，星期三下午每个人都在办公室，星期二不行。\n\n我向经理说了这件事，给他看那张纸。他说选星期三，我再告诉同事。有人问为什么不在星期二，我说是为了让去外地的同事也能来。\n\n星期三开会时，大家都到了。经理说这个方法很好。我也明白了，关于大家的事，应该先问清楚每个人的时间，再决定，不是我觉得可以就可以。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My reply uses the later information instead of simply repeating the first claim."
              },
              {
                "id": "r2",
                "text": "My clarification and proposed next step address the practical constraint."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
