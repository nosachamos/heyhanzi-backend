  "definition": {
    "id": "ACT-GRAM",
    "revision": 7,
    "title": "Put events in order",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-event-order-teach",
        "kind": "teach",
        "title": "Put events in order",
        "blocks": [
          {
            "text": "先 marks an action before another; 再 or 然后 introduces what follows. 一…就… links an event closely to the next one, rather than giving a calendar date.",
            "examples": [
              {
                "text": "我先吃饭，再去学校。",
                "pinyin": "wǒ xiān chī fàn ， zài qù xuéxiào 。",
                "meaning": "I eat first, then go to school.",
                "audio": "76ea1fa2c4171b0fb7749441b6d8343b82d306d30284524e6ad8e37ca977d9b6"
              },
              {
                "text": "我一到家就看书。",
                "pinyin": "wǒ yī dào jiā jiù kàn shū 。",
                "meaning": "As soon as I get home, I read.",
                "audio": "5e8c79a1fd511be1321840f558634245d3373967ffd84fd8866a871001d1d31d"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
