        "id": "EX-GRAM-G-hsk1-prepositions-teach",
        "kind": "teach",
        "title": "Add place, time and participants",
        "blocks": [
          {
            "text": "Place a time, location or companion phrase before the action. 对 introduces the person toward whom an attitude is directed; 和 can mean with, not just and.",
            "examples": [
              {
                "text": "我在家看书。",
                "pinyin": "wǒ zài jiā kàn shū 。",
                "meaning": "I read at home.",
                "audio": "c467d3f4ed9941821be635f56ccc0bccefab465b9e4ad94241535f5cd2d014e6"
              },
              {
                "text": "我和他在学校学习。",
                "pinyin": "wǒ hé tā zài xuéxiào xuéxí 。",
                "meaning": "I study at school with him.",
                "audio": "3a88dfa49d48ccad384e18c565b37410a7ff0d028d02240f6c9451d1fcd5363a"
              },
              {
                "text": "他对我很好。",
                "pinyin": "tā duì wǒ hěn hǎo 。",
                "meaning": "He treats me well.",
                "audio": "25ce389df57c35f7cf1aae13feb33da284fd750ebb924931ac3860b126bbe3ae"
              }
            ]
          },
