  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U28-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "Solving a practical problem",
    "context": "Describe actions affecting particular objects and events affecting people.",
    "steps": [
      {
        "id": "EX-CORE-U28-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U28-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "Solving a practical problem: Write a practical explanation for someone joining the situation late. State the problem, a supported reason or constraint, and a clear proposed next step.",
            "promptLanguage": "en",
            "context": "我和朋友在学校学习。我们都带了电脑，我的大一点儿，他的小一点儿。下课以后，朋友先走了，我准备把电脑放进书包。\n\n我发现桌子上是他的电脑。我的电脑被他拿走了。我认为他可能拿错了，不是想要我的电脑。我给他打电话。\n\n朋友看了看书包，说：“对不起，我把你的电脑拿回家了。我现在给你送来，你先别走。”我说：“好，我在学校等你。”\n\n朋友到了学校以后，把我的电脑放在桌子上。我看了看，然后把他的电脑给了他。他说：“这次看一下，我的是小的，你的是大的。”\n\n问题解决了，我们都拿到了自己的电脑。我没有因为拿错东西说朋友不好，朋友也没有说是我的问题。我们最后又看了一次，再一起走出学校。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The problem, constraint and next step connect coherently."
              },
              {
                "id": "r2",
                "text": "I distinguished the source facts from my proposal."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
