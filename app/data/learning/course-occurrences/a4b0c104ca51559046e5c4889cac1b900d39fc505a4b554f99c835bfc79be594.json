        "id": "EX-GRAM-G-hsk5-stance-p18-teach",
        "kind": "teach",
        "title": "可 + assertion",
        "blocks": [
          {
            "text": "可 before an assertion gives emphatic, often corrective force. It is not permission or the contrast conjunction 可是.",
            "examples": [
              {
                "text": "我可没说。",
                "pinyin": "wǒ kě méi shuō 。",
                "meaning": "I certainly did not say that.",
                "audio": "e648212ecef5ede2cb8faff5554eef8c361dab7b6a2532ef6101e32d8123bcda"
              },
              {
                "text": "这可是真的。",
                "pinyin": "zhè kě shì zhēn de 。",
                "meaning": "This really is true, you know.",
                "audio": "03996995969fa8d5b23ea53c44cf893c6ee54554ee9163ad797c2b31b3f79465"
              }
            ]
