    "steps": [
      {
        "id": "EX-GRAM-G-clock-time-teach",
        "kind": "teach",
        "title": "Use clock times and calendar expressions",
        "blocks": [
          {
            "text": "Put the hour before 点 and place the time before the action. A clock time tells when; it is not how long an action lasts. Put the day before the clock time. 从…到… can frame a time range.",
            "examples": [
              {
                "text": "现在七点。",
                "pinyin": "xiànzài qī diǎn 。",
                "meaning": "It is seven now.",
                "audio": "3510c34ff95cd4f5f40661d809ceacb8a247b776fbbdd30a2fc1f438555bc287"
              },
              {
                "text": "现在八点半。",
                "pinyin": "xiànzài bā diǎn bàn 。",
                "meaning": "It is half past eight now.",
                "audio": "9a9b13636f309e5bb98f90501e62361560bb59bae3528a14c98fbdc5d494552f"
              },
              {
                "text": "我明天三点来。",
                "pinyin": "wǒ míngtiān sān diǎn lái 。",
                "meaning": "I will come tomorrow at three.",
                "audio": "9a2c31b68e4da36f61b5bd9f326a4e1f11fbaf3f4aa123d72ec9523577467391"
              },
              {
                "text": "从三点到五点",
                "pinyin": "cóng sān diǎn dào wǔ diǎn",
                "meaning": "from three until five",
                "audio": "751f2b5888985cb48c3d196a42a59a6dd0aa3151bf41af993745dfb09a3f1e4a"
              }
            ]
          },
