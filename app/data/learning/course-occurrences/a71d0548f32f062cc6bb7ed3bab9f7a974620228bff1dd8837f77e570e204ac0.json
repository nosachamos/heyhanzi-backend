    "steps": [
      {
        "id": "EX-GRAM-G-no-need-prohibition-teach",
        "kind": "teach",
        "title": "Separate not necessary from not allowed",
        "blocks": [
          {
            "text": "不用 and 不必 before an action say it is unnecessary, and can reassure someone that they need not do it. 不可以 or a prohibitive 不能 says an action is not permitted. Practical inability is different again: an unnecessary action is neither automatically forbidden nor impossible.",
            "examples": [
              {
                "text": "你不用去。",
                "pinyin": "nǐ bùyòng qù 。",
                "meaning": "You do not need to go.",
                "audio": "9f7bce6663214bcaad25874dba676ff2bc11969dcee13d50c3a5285ebdcfdf15"
              },
              {
                "text": "你不必去。",
                "pinyin": "nǐ bùbì qù 。",
                "meaning": "You need not go.",
                "audio": "50dede357bd0d26eb01180ccdc8287c010367a11aa191a090ef4c46becbbea32"
              },
              {
                "text": "你不可以去。",
                "pinyin": "nǐ bùkěyǐ qù 。",
                "meaning": "You may not go.",
                "audio": "a5383b7a02fee20b93309e93066839174ab7d07db4d4d1efd3d9b6c450760acc"
              },
              {
                "text": "我没时间，不能去。",
                "pinyin": "wǒ méi shíjiān ， bù néng qù 。",
                "meaning": "I have no time, so I cannot go.",
                "audio": "89f5a73597486da7c06b9f9c6f545fd2bc13d0d537d0d67b772dc37916c9f97f"
