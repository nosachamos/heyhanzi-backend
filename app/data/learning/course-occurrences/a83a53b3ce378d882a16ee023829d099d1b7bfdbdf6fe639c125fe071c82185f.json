    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-stance-p14-teach",
        "kind": "teach",
        "title": "只好 + action",
        "blocks": [
          {
            "text": "只好 selects a less preferred action because the alternatives are unavailable. It differs from freely choosing the best option.",
            "examples": [
              {
                "text": "下雨了，我只好在家。",
                "pinyin": "xiàyǔ le ， wǒ zhǐhǎo zài jiā 。",
                "meaning": "It is raining, so I have no choice but to stay home.",
                "audio": "c2ea36bb5e569de41fb3a5b83fe6366647b7bc17770e6b0de78663e5b0269bde"
              },
              {
                "text": "没有车，我们只好走。",
                "pinyin": "méiyǒu chē ， wǒmen zhǐhǎo zǒu 。",
                "meaning": "There is no vehicle, so we have to walk.",
                "audio": "d5e747ebbffb0e70c7aa2c1d04019b39abb240ac3361436297ca80359aa5db6d"
              }
            ]
          },
          {
