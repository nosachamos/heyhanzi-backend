  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-20-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Two explanations · 2",
    "context": "Use the selected vocabulary and constructions to compare accounts of a learning problem and identify a useful clarification.",
    "steps": [
      {
        "id": "EX-CORE-U4-20-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-20-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Two explanations · 2: A partner objects using only the initial account. Acknowledge the relevant concern, explain the later evidence or change, and clarify what action can actually be agreed.",
            "promptLanguage": "en",
            "context": "学校让毕业生给新来的同学写一点介绍。我写了很多课程名字，觉得看起来很专业。教师读完以后问，这些名字能帮助第一次来的人做什么，我一下子不知道怎么回答。\n\n她说不是不要课程名字，而是读者现在需要知道怎么选。我问是不是字要写少一点，她说：就是说，要让他看完以后知道自己下一步能做什么。\n\n我重新去问新同学。他说最想知道不会写字的人能不能参加，有没有晚上上的课。我发现这两个问题在自己写的介绍里都找不到，虽然写了很多课程名字。\n\n这次我先写哪种课可以从不会写开始，再写时间和怎么去问教师。专业的名字放在后面，让需要的人可以找到。新同学读完以后，马上知道要去问哪一位。\n\n教师问我为什么这样写，我说介绍还要帮助读者把自己的需要和课程放在一起看，不能只写学校有什么。她听完觉得可以，让我再请一个新同学读读。\n\n第二个同学想学口语，看完介绍，选了适合自己的课，和第一个人选的不一样。我没有让他们选同一种课，也明白了教师为什么问介绍能帮助别人做什么。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I acknowledged the concern without misrepresenting it."
              },
              {
                "id": "r2",
                "text": "My proposed agreement preserves the later evidence and remaining limitation."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
