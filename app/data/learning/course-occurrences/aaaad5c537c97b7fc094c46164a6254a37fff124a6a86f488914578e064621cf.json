  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U5-24-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "The intention was different · 1",
    "context": "Use the selected vocabulary and constructions to distinguish an expressed attitude from an assumption and repair a misunderstanding.",
    "steps": [
      {
        "id": "EX-CORE-U5-24-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U5-24-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "The intention was different · 1: Present a supported viewpoint about the decision in this account. Refer to a concrete source detail, acknowledge a plausible alternative, and qualify what the evidence cannot establish.",
            "promptLanguage": "en",
            "context": "朋友问我周末要不要去看一场演出。我回答说，最近有点累，想先看看星期五的工作安排。他听完以后，就没有再提这件事。\n\n星期六我问他几点出发，他却不理解，说自己以为我已经拒绝了。我才发现，自己只说了担心的地方，没有说清楚还想不想去。\n\n我解释，累是需要考虑的情况，不是已经做好的决定。如果星期五能早点完成工作，我仍然希望参加；如果太晚，才准备在家休息。\n\n朋友解释，他以为我不愿意去，怕再问会让我觉得必须答应，所以没有继续问。我这才知道他是在尊重我的选择，并不是故意把我留下。\n\n我们商量好，以后没有决定时就直接说还在考虑，再约一个回答的时间。这样，朋友可以等我想清楚，不用从一个不明确的回答里猜我的决定。\n\n那天我们还是一起去看了演出，也说清楚了先前的误会。下次我会说明自己想不想去、需要考虑什么，让朋友听懂我的态度和条件。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "A concrete source detail supports my position."
              },
              {
                "id": "r2",
                "text": "I represented the alternative fairly and retained an important qualification."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
