    "title": "Describe a scene",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk2-existence-teach",
        "kind": "teach",
        "title": "Describe a scene",
        "blocks": [
          {
            "text": "Place + verb + 着 + noun describes a continuing scene. 着 presents the state that remains, rather than merely announcing a completed event.",
            "examples": [
              {
                "text": "桌子上放着一本书。",
                "pinyin": "zhuōzi shàng fàng zhe yī běn shū 。",
                "meaning": "A book is lying on the table.",
                "audio": "61a609c22f39cfc6a2f885c93630c189d8b9f7c964200257e4a9425ea73ef61f"
              },
              {
                "text": "门开着。",
                "pinyin": "mén kāi zhe 。",
                "meaning": "The door is open.",
                "audio": "6d7e9cd7340bc8bbbf73b549604be3e59726e1ba8f6b2cc31adc293df8b06c00"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "着",
                "pinyin": "zhe",
                "meaning": "mark a continuing state",
                "singleWord": true,
                "audio": "37084cb2450410926b2db3350c5202a4c3d82afb9243f84b5c9e2e2d8adff93c"
              },
              {
                "text": "有",
                "pinyin": "yǒu",
                "meaning": "have; there is/are",
                "singleWord": true,
