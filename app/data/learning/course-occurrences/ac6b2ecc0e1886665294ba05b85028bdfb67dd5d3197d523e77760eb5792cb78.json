        "kind": "teach",
        "title": "一直 + predicate",
        "blocks": [
          {
            "text": "一直 presents an action or state as continuing through the relevant interval. It differs from repeating an action on separate occasions.",
            "examples": [
              {
                "text": "我一直在等你。",
                "pinyin": "wǒ yīzhí zài děng nǐ 。",
                "meaning": "I have been waiting for you the whole time.",
                "audio": "bf8b2af1a41d3bae7db11b4e498ef821cda314f5e9f170f7ea994b83b80131d6"
              },
              {
                "text": "这几天一直下雨。",
                "pinyin": "zhè jǐ tiān yīzhí xiàyǔ 。",
                "meaning": "It has been raining continuously these past few days.",
                "audio": "1febf1de13445aa9f5a67897c2ae8e42a11211f2e50eb61a285ba138c69fb13a"
