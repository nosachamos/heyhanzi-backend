    "steps": [
      {
        "id": "EX-CORE-U18-skill-K-HSK2-pragmatics-teach",
        "kind": "teach",
        "title": "HSK 2: pragmatics",
        "blocks": [
          {
            "text": "An invitation offers a choice; obligation removes a choice. State willingness or permission using the taught forms, and make an acceptance or refusal clear.",
            "examples": [
              {
                "text": "想",
                "pinyin": "xiǎng",
                "meaning": "want to; think",
                "singleWord": true,
                "audio": "0f7888a867fcf48892fc19934077db46ab08aef906f027d1d74d145f2b123d27"
              },
              {
                "text": "可以",
                "pinyin": "kěyǐ",
                "meaning": "may; can",
                "singleWord": true,
                "audio": "c35e930c1ba4cd1f23e25f38f1543c3a96ee8db1764dd6d4188bcf2c506fd3f8"
              },
              {
                "text": "不用",
                "pinyin": "bùyòng",
                "meaning": "need not",
                "singleWord": true,
                "audio": "c44fc1dabf0ee54e56eca03ee197a2693e9db3c79633eaf20846eb5ee76eebc1"
              },
              {
                "text": "对不起",
                "pinyin": "duìbuqǐ",
                "meaning": "sorry",
                "singleWord": true,
                "audio": "70793902a26c9a6674a77d286ad9de4025f3b0b0b7c66447408967470dd22456"
              }
            ]
          },
          {
            "text": "A friend invites you to eat together today and says it is permitted to come tomorrow instead. You would like to join tomorrow. No one has said attendance is compulsory. Reply with that preference and check permission rather than implying a duty.\nFamiliar meanings available: want to; think; may; can; need not; sorry."
          }
        ]
      },
      {
        "id": "EX-CORE-U18-skill-K-HSK2-pragmatics-perform",
        "kind": "check",
        "title": "Use the skill in context",
        "questions": [
          {
            "id": "EX-CORE-U18-skill-K-HSK2-pragmatics-perform",
            "kind": "production",
            "response": "spoken",
            "prompt": "A friend proposes a familiar plan. Give a suitable acceptance or refusal, and make clear whether you want to do it or are unable to do it.",
            "promptLanguage": "en",
            "context": "A friend invites you to eat together today and says it is permitted to come tomorrow instead. You would like to join tomorrow. No one has said attendance is compulsory. Reply with that preference and check permission rather than implying a duty.\nFamiliar meanings available: want to; think; may; can; need not; sorry.",
            "contextLanguage": "en",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My reply clearly accepts, refuses or asks for clarification."
              },
              {
                "id": "r2",
                "text": "I distinguished preference, permission and practical possibility."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
