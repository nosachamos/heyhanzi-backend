  "definition": {
    "id": "ACT-SKILL",
    "instanceId": "EX-CORE-U18-skill-K-HSK2-pragmatics",
    "revision": 1,
    "title": "Learn a communication strategy",
    "subtitle": "Plans, predictions and sequences",
