  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U3-19-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "A message changes meaning · 1",
    "context": "Use the selected vocabulary and constructions to compare messages and identify the wording that changes the interpretation.",
    "steps": [
      {
        "id": "EX-CORE-U3-19-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U3-19-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "A message changes meaning · 1: Write a practical explanation for someone joining the situation late. State the problem, a supported reason or constraint, and a clear proposed next step.",
            "promptLanguage": "en",
            "context": "朋友给我看了一封邮件，里面说“明天上午九点见”。他问我明天要不要一起去。我没有马上回答，先问这封邮件是什么时候来的。\n\n朋友说是昨天来的，他今天早上才看见。我说，昨天写的明天，就是今天。他看了看时间，现在八点半，去那儿要二十分钟。\n\n我们打电话给写邮件的人，再问一次是不是今天上午九点见。他说时间没有错，让我们去学校门口，朋友就把课本放进书包，和我一起出门。\n\n到学校的时候还没有九点，我们没有晚到。朋友说自己只看了里面写什么，没有看邮件的时间。我说看到邮件以后，这两个都要看。\n\n回家以后，朋友给同学写邮件，没有只写明天，还写了星期几。他说，朋友可能不会马上看见，写清楚是哪一天，可以少一次这样的着急。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The problem, constraint and next step connect coherently."
              },
              {
                "id": "r2",
                "text": "I distinguished the source facts from my proposal."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
