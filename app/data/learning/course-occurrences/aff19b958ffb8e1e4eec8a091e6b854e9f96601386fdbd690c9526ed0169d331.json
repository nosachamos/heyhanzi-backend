    "steps": [
      {
        "id": "EX-GRAM-G-hsk5-serial-teach",
        "kind": "teach",
        "title": "Infer relations between serial actions",
        "blocks": [
          {
            "text": "Adjacent predicates sharing a subject may describe an action and its result, complementary positive and negative aspects of one situation, or a condition that enables the following action. Do not interpret every pair as first this, then that.",
            "examples": [
              {
                "text": "他跑步受伤了。",
                "pinyin": "tā pǎobù shòushāng le 。",
                "meaning": "He got injured while running.",
                "audio": "24fcaea715a95789b41ec23389b9361e583b1b205db9a652ed7870768a7557ba"
              },
              {
                "text": "他坐着不动。",
                "pinyin": "tā zuò zhe bù dòng 。",
                "meaning": "He sits without moving.",
                "audio": "59ec00938805fff50d6ed4f9914cbc9a31571e3b4c4954ea54dd5bb0d8491589"
              },
              {
                "text": "他有机会发言。",
                "pinyin": "tā yǒu jīhuì fāyán 。",
                "meaning": "He has an opportunity to speak.",
                "audio": "209c1479498c9cd9767935c11b029d2a5c64dccc2dc46defdcd772a911c8a002"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
