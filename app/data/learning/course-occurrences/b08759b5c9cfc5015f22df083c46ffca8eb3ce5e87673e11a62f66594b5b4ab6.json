  "definition": {
    "id": "ACT-COMPOSE",
    "instanceId": "EX-CORE-U5-11-required-composition",
    "revision": 1,
    "title": "Write a practical message",
    "subtitle": "A mistaken order · 2",
    "context": "Use the selected vocabulary and constructions to identify a mismatch in an order and request a correction.",
    "steps": [
      {
        "id": "EX-CORE-U5-11-required-composition-produce",
        "kind": "check",
        "title": "Compose a purposeful message",
        "questions": [
          {
            "id": "EX-CORE-U5-11-required-composition-draft",
            "kind": "production",
            "response": "written",
            "prompt": "A mistaken order · 2: Write a structured recommendation for an absent decision-maker. Explain the issue, compare a plausible alternative, and support your conclusion with specific source evidence and a limitation.",
            "promptLanguage": "en",
            "context": "我们打算为这次活动的成员订购一批服装。商家正在促销，客户只要一次买够数量，就能得到便宜的价格。负责人因此准备把另外要用的服装也一起订上。\n\n货物送到后，我发现每一件的颜色都对，一共的数量却比我们写下的数量少。我先问负责人有没有改变安排，没有马上认为商家故意少送。\n\n负责人重新读了发给商家的信息，发现只写了参加活动的人数，没有写另外需要的几件。商家按这条信息送货，所以收到的数量比我们原来想的少。\n\n他联系商家说明错误，问能不能再订几件。工作人员说，另外订购的几件比原来的贵一些，不过可以和下一批服装一起送来。\n\n我们比较了两种办法，决定接受下一次配送，暂时让最早参加活动的人先拿衣服。其他成员下周才来，不会因此受到影响。\n\n负责人重新写清楚服装一共订购多少，每次配送多少。大家这才明白，只有把自己的计划告诉对方，对方才能知道实际需要，不能让对方去猜。",
            "contextLanguage": "zh",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "The issue, evidence and conclusion form a coherent argument."
              },
              {
                "id": "r2",
                "text": "I treated the alternative fairly and retained a limitation on my conclusion."
              }
            ],
            "minLength": 1
          }
        ],
        "sequential": true
      }
    ],
