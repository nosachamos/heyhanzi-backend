        "kind": "teach",
        "title": "时刻 + predicate",
        "blocks": [
          {
            "text": "时刻 means throughout the relevant time, often with attention or readiness. It differs from a single clock moment.",
            "examples": [
              {
                "text": "我们时刻准备着。",
                "pinyin": "wǒmen shíkè zhǔnbèi zhe 。",
                "meaning": "We are ready at all times.",
                "audio": "be8db78dfaa08de80aa8b4c8b60aeb87a8eddd123681847ed22a2a124da047a8"
              },
              {
                "text": "他时刻关心孩子。",
                "pinyin": "tā shíkè guānxīn háizi 。",
                "meaning": "He is always concerned about the child.",
                "audio": "1ea6126ff063d3a2151172e318f1cc24581c2dbc8dbcf87cf7107da2de353a8c"
              }
