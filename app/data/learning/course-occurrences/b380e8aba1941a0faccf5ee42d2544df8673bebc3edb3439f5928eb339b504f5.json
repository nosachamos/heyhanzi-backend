  "fingerprint": "d734c73eec07432ef17afe8b4924c145f5a2871d12f1ac4ed6bcf5ba1fbce536",
  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-15-P01-interact",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "The intention was different · 1 · preparation 1",
    "context": "Use this subset of the feelings vocabulary and constructions in a short self-contained situation, preparing for U3-15. Use the selected vocabulary and constructions to distinguish an expressed attitude from an assumption and repair a misunderstanding.",
    "steps": [
      {
        "id": "EX-CORE-U3-15-P01-interact-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-15-P01-interact-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "The intention was different · 1 · preparation 1: Explain the practical problem and your proposed response to an absent partner. State one constraint or condition and explain how it changes the plan.",
            "promptLanguage": "en",
            "context": "朋友的小猫不见了。我们在房间里找，床下、桌子下都没有。朋友很着急，说猫一定走到外面去了。我说先别急，门还关着。\n\n朋友说刚才有人来过，可能那时猫走出去了。我看见门边的书包在动，好像里面有东西。我让朋友过来，他还在看门外。\n\n我们打开书包，猫在里面睡觉，旁边还有朋友放进去的衣服。朋友终于放心了，说刚才差不多把房间都找了，就是没有看书包。\n\n我说猫可能觉得衣服很舒服，才到里面去。朋友把书包放在床旁边，没有把它拿出来。他不再生气，也没有一直问猫为什么不出来。\n\n回家前，我对朋友说，下次先把房间认真看一遍，再去外面找。猫睡在哪里可以看清楚，猫心里怎么想，我也不知道是不是这样。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My problem and proposed response follow the source."
              },
