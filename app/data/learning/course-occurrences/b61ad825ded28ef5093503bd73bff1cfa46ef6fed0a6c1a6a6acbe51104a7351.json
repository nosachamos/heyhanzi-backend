    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-connectors-p21-teach",
        "kind": "teach",
        "title": "嗯 + response",
        "blocks": [
          {
            "text": "嗯 can acknowledge a turn or give a brief affirmative response. It is a response sound, not a required word for every yes. 嗯 can also hold the turn while considering a reply. A following question can signal that the speaker is checking what was said; interpret the whole turn, not a fixed yes translation. The displayed citation reading does not prescribe a fixed conversational contour.",
            "examples": [
              {
                "text": "嗯，我知道了。",
                "pinyin": "ǹg ， wǒ zhīdào le 。",
                "meaning": "Mm, I understand.",
                "audio": "d60eefa410a4660f9e1d6f5f515978dd35b7c4dee69ea99061b429c3bcb315ee"
              },
              {
                "text": "嗯，可以。",
                "pinyin": "ǹg ， kěyǐ 。",
                "meaning": "Mm, that is fine.",
                "audio": "f67eb28f4f3cb7b1c77a599fae6bb656b6075f0509405d18a861cb6f593dc1a9"
              },
              {
                "text": "嗯，我想想。",
                "pinyin": "ǹg ， wǒ xiǎng xiǎng 。",
                "meaning": "Hmm, let me think.",
                "audio": "864c7e9849ca1351868e3686480908fc6e4c745fc9ade10904ee6f88c8da102b"
              },
              {
                "text": "嗯，你说什么？",
                "pinyin": "ǹg ， nǐ shuō shénme ？",
                "meaning": "Hmm, what did you say? The speaker checks what was said.",
                "audio": "69cb209b09adf22d133035fcb21614399b6f5751bd81d632c1d9fdfafc939a56"
              }
            ]
          },
