    "steps": [
      {
        "id": "EX-GRAM-G-hsk5-purpose-teach",
        "kind": "teach",
        "title": "Make purpose and dependence explicit",
        "blocks": [
          {
            "text": "为的是 makes a purpose explicit. 没有…就没有 and 不…不… express dependence; identify the required condition instead of simply canceling two negatives.",
            "examples": [
              {
                "text": "我来，为的是学习。",
                "pinyin": "wǒ lái ， wèi de shì xuéxí 。",
                "meaning": "I came in order to study.",
                "audio": "eb77844debf794d8b04e998a3a81d9a62dc7211c2503ddfe562c17f71f8cc1c9"
              },
              {
                "text": "没有你的帮助，就没有今天的成功。",
                "pinyin": "méiyǒu nǐ de bāngzhù ， jiù méiyǒu jīntiān de chénggōng 。",
                "meaning": "Without your help, there would not be today's success.",
                "audio": "a4de020f6dae56529edb8a2eeb8028d49bcbbcea1fc3188af9a9db42a3ae3694"
              },
              {
                "text": "不学习不能成功。",
                "pinyin": "bù xuéxí bù néng chénggōng 。",
                "meaning": "Without studying, you cannot succeed.",
                "audio": "60114119f93ce8e7c548b5f9bdfbe7391bfd04d17166292d5f5c963cad2a43af"
              }
            ]
          },
