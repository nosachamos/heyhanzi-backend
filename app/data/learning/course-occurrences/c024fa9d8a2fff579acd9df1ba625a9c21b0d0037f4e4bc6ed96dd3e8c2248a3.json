    "steps": [
      {
        "id": "EX-GRAM-G-hsk1-clauses-teach",
        "kind": "teach",
        "title": "Connect short statements",
        "blocks": [
          {
            "text": "Related short clauses can stand together when their connection is clear. Use 也 for a parallel fact and 还 to add another fact.",
            "examples": [
              {
                "text": "我喝茶，他喝水。",
                "pinyin": "wǒ hē chá ， tā hē shuǐ 。",
                "meaning": "I drink tea, and he drinks water.",
                "audio": "7c5595f2ff5d3a67a287aff7ab494527771f9bc6f292c42da448831d89d629e2"
              },
              {
                "text": "我喝茶，也喝水。",
                "pinyin": "wǒ hē chá ， yě hē shuǐ 。",
                "meaning": "I drink tea and also drink water.",
                "audio": "1011eba3436c80aae40eacae696aceb1b0389c3a1642ea0dfc88a79005b45b3f"
              },
              {
                "text": "他是老师，还是我的朋友。",
                "pinyin": "tā shì lǎoshī ， hái shì wǒ de péngyou 。",
                "meaning": "He is a teacher and also my friend.",
                "audio": "7979d9274f0243e9e2264f8b14f8009840e113652872a9f1f7c0aea0666b3a63"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
