    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-stance-p10-teach",
        "kind": "teach",
        "title": "才 + small quantity",
        "blocks": [
          {
            "text": "才 before a quantity evaluates it as small or insufficient. This is not the temporal use meaning only then.",
            "examples": [
              {
                "text": "才来了三个人。",
                "pinyin": "cái lái le sān gè rén 。",
                "meaning": "Only three people have come.",
                "audio": "32807de4b26c9ac14d9751e3ff56a3954f4a3c717fffb564943a067dd98bfb45"
              },
              {
                "text": "这本书才十元。",
                "pinyin": "zhè běn shū cái shí yuán 。",
                "meaning": "This book costs only ten yuan.",
                "audio": "faf646087cfe4e2552dfa16d485cac85740d03c7191d95c3e3bd33235d62c8f1"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "才",
                "pinyin": "cái",
                "meaning": "only; emphasizes that an amount is small",
