            "audioVoices": [
              "male",
              "female"
            ],
            "transcript": [
              {
                "text": "他是我的亲人，我认为他愿意帮助我。",
                "pinyin": "tā shì wǒ de qīnrén ， wǒ rènwéi tā yuànyì bāngzhù wǒ 。",
                "meaning": "",
                "audio": "b0edc7c08590b0cfa0056d25ac757c163969bbd0c600dbf70f20bdc3d4980ef7"
              },
              {
                "text": "我以为他是你的熟人。他昨天没有来。",
                "pinyin": "wǒ yǐwéi tā shì nǐ de shúrén 。 tā zuótiān méiyǒu lái 。",
                "meaning": "",
                "audio": "fa7ba0eff2ccd09d7ae8290ec89dc14b78d0c32dc92762c1058997a1bc967634"
              }
