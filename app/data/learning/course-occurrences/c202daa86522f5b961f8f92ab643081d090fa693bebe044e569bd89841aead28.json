    "steps": [
      {
        "id": "EX-CORE-U6-02-skill-K-HSK6-compose-teach",
        "kind": "teach",
        "title": "HSK 6: compose",
        "blocks": [
          {
            "text": "A synthesis attributes source statements and marks the writer’s interpretation. Preserve qualification and avoid combining two limited claims into a stronger unsupported conclusion.",
            "examples": [
              {
                "text": "求助",
                "pinyin": "qiúzhù",
                "meaning": "to request help; to appeal",
                "singleWord": true,
                "audio": "c8722da1c83727fd790db63dace64e39b2e233d1695dc096443d17ae46932a57"
              },
              {
                "text": "同伴",
                "pinyin": "tóngbàn",
                "meaning": "companion; comrade",
                "singleWord": true,
                "audio": "5bc3aebc0b00f5eef121e897d61d6bddf2a91cc4f8ac4b931055d44cd9c2c23e"
              },
              {
                "text": "据",
                "pinyin": "jù",
                "meaning": "according to; to act in accordance with",
                "singleWord": true,
                "audio": "d220b3ac13a3807b65aaf415828d920645389677aa9c0c0b32c52da422685843"
              },
              {
                "text": "认为",
                "pinyin": "rènwéi",
                "meaning": "to believe; to think",
                "singleWord": true,
                "audio": "cb6fec095e11769414fd90d687de1cd4adc5a3c7f78407502416584a9885e0a5"
              }
            ]
          },
          {
            "text": "Account A: a companion requested help and received no answer, so A thinks the recipient refused. Account B: the recipient may not have understood the request; B has no confirmation. Both accounts report no answer. Write a synthesis that attributes each interpretation and preserves the unknown intention and understanding.\nFamiliar meanings available: to request help; to appeal; companion; comrade; according to; to act in accordance with; to believe; to think."
          }
        ]
      },
