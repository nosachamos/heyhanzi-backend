  "definition": {
    "id": "ACT-SKILL",
    "instanceId": "EX-CORE-U5-02-skill-K-HSK5-interact",
    "revision": 1,
    "title": "Learn a communication strategy",
    "subtitle": "An invitation changes · 2",
    "context": "Use the selected vocabulary and constructions to negotiate an invitation and explain a tactful response.",
    "steps": [
      {
        "id": "EX-CORE-U5-02-skill-K-HSK5-interact-teach",
        "kind": "teach",
        "title": "HSK 5: interact",
        "blocks": [
          {
            "text": "Before objecting, clarify what the partner means and the constraint their proposal addresses. Respond to the clarified point rather than a stronger claim they did not make.",
            "examples": [
              {
                "text": "成员",
                "pinyin": "chéngyuán",
                "meaning": "member",
                "singleWord": true,
                "audio": "9cb9a6a445cda6b3f8c7e42d15baeb3c4de831d3cb9fc52e5bb5e621056e9076"
              },
              {
                "text": "伙伴",
                "pinyin": "huǒbàn",
                "meaning": "companion; pal",
                "singleWord": true,
                "audio": "c5236ac47f77eb8246a4c9c4a5034b2dd1e9220a6ac1ac8b81596537893be335"
              },
              {
                "text": "亲自",
                "pinyin": "qīnzì",
                "meaning": "personally; in person",
                "singleWord": true,
                "audio": "05c305ad228dcb09bffedec1234fb16ceedd805064caab412bfd976738f1cef9"
              },
              {
                "text": "解释",
                "pinyin": "jiěshì",
                "meaning": "explanation; to explain",
                "singleWord": true,
                "audio": "2d202d6139a0dbc55380c48084f1f620514247c225fa7f5e5117666a8af418ba"
              }
            ]
          },
          {
            "text": "Your group must choose a meeting today or tomorrow. Your partner prefers today so a new member can attend; you prefer tomorrow so another partner can attend. No date allows everyone to come. Ask which member can attend today, respond to that reason, and propose a next step without claiming full agreement.\nFamiliar meanings available: member; companion; pal; personally; in person; explanation; to explain."
          }
        ]
      },
      {
        "id": "EX-CORE-U5-02-skill-K-HSK5-interact-perform",
        "kind": "check",
        "title": "Use the skill in context",
        "questions": [
          {
            "id": "EX-CORE-U5-02-skill-K-HSK5-interact-perform",
            "kind": "production",
            "response": "spoken",
            "prompt": "A partner supports the other option in the familiar group decision. Ask one relevant clarification, then give your response to their actual reason.",
            "promptLanguage": "en",
            "context": "Your group must choose a meeting today or tomorrow. Your partner prefers today so a new member can attend; you prefer tomorrow so another partner can attend. No date allows everyone to come. Ask which member can attend today, respond to that reason, and propose a next step without claiming full agreement.\nFamiliar meanings available: member; companion; pal; personally; in person; explanation; to explain.",
            "contextLanguage": "en",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My clarification targets the partner’s stated reason."
              },
              {
                "id": "r2",
                "text": "My response addresses that reason without inventing a stronger claim."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
