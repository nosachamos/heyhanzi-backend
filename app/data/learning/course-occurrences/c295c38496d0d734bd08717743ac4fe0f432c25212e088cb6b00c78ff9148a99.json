  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U5-18-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "Making room for an interest · 1",
    "context": "Use the selected vocabulary and constructions to choose a shared leisure activity and explain a compromise.",
    "steps": [
      {
        "id": "EX-CORE-U5-18-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U5-18-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "Making room for an interest · 1: A partner favors a different response to this situation. Ask which source detail supports their view, acknowledge the relevant point, and explain your response without overstating the evidence.",
            "promptLanguage": "en",
            "context": "朋友们周末想一起活动，有人提出比赛跑步，还认真安排了比赛的顺序。一位刚加入的朋友听完以后，却说自己不想参加。\n\n大家问他是不是不爱运动，他说自己其实很喜欢跑步。他不愿意每次都比谁跑得快，还担心自己跑得慢，会让朋友受到影响。\n\n我们讨论以后，把活动分为两部分。愿意比赛的人先参加短距离比赛，其他人可以在跑道旁边慢慢走，在旁边为选手加油。\n\n比赛结束后，大家再一起走一段路，不比较时间，也不看谁赢谁输。那位朋友愿意参加这一部分，还答应带相机帮比赛的人拍照。\n\n那天，有人发挥得很好，也有人没有达到原来的目标。走路时，大家一边聊刚才的经历，一边看看周围，没有人总问谁赢了谁输了。\n\n照片发给大家以后，最受欢迎的不是冠军一个人的照片，而是所有人一起笑的样子。我们发现，活动的乐趣可以来自比赛，也可以来自和朋友在一起。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My clarification targets the partner’s reason."
              },
              {
                "id": "r2",
                "text": "My response addresses that reason and preserves the source’s limits."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
