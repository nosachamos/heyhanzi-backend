        "id": "EX-CORE-WU03-skill-K-WARMUP-pragmatics-teach",
        "kind": "teach",
        "title": "Warm-up: pragmatics",
        "blocks": [
          {
            "text": "A greeting addresses the person in front of you. I refers to the current speaker and you to the current listener; these roles change when the turn changes.",
            "examples": [
              {
                "text": "你好",
                "pinyin": "nǐhǎo",
                "meaning": "hello; hi",
                "singleWord": true,
                "audio": "ba138555ea5e79f104066baccd5d743c996b1b7f150a3101dfe0b2e3eefda145"
              },
              {
                "text": "我",
                "pinyin": "wǒ",
                "meaning": "I; me",
                "singleWord": true,
                "audio": "364fba3bd2447ba14bf6e73be5f61e90209a109abbfe24e2f287e738f69f1113"
              },
              {
                "text": "你",
                "pinyin": "nǐ",
                "meaning": "you",
                "singleWord": true,
                "audio": "b316ac0dd167bd8bef2048818a93b55be5371efb0af3024556cf9b5c93799d4d"
              }
            ]
          },
          {
            "text": "You and a familiar partner meet. First you speak to the partner; then the partner speaks to you. Identify the current speaker and listener each time. No third person is present.\nFamiliar meanings available: hello; hi; I; me; you."
          }
        ]
