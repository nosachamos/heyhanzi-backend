        "title": "多么 + gradable predicate",
        "blocks": [
          {
            "text": "多么 before an adjective expresses strong feeling about degree. An exclamatory 多么 sentence does not request a number.",
            "examples": [
              {
                "text": "这里多么安静啊！",
                "pinyin": "zhèlǐ duōme ānjìng a ！",
                "meaning": "How quiet it is here!",
