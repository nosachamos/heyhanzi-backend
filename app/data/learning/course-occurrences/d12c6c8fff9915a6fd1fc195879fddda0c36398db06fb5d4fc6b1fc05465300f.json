        "kind": "teach",
        "title": "第 + numeral",
        "blocks": [
          {
            "text": "Put 第 before a number to give its position in an ordered series. It is an order, not the number of things present.",
            "examples": [
              {
                "text": "我第一。",
                "pinyin": "wǒ dì yī 。",
                "meaning": "I am first.",
                "audio": "0b0b1d417f73ab02d4ddc426ada3db084c945bf040e3b46f91b304546457bd72"
