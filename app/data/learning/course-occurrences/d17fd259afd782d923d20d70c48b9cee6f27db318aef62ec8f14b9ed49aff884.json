  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U3-21-required-interaction",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A shared decision · 1",
    "context": "Use the selected vocabulary and constructions to compare proposals affecting a community and explain a supported preference.",
    "steps": [
      {
        "id": "EX-CORE-U3-21-required-interaction-produce",
        "kind": "check",
        "title": "Respond to the situation",
        "questions": [
          {
            "id": "EX-CORE-U3-21-required-interaction-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A shared decision · 1: A partner proposes acting immediately on the first part of this account. Explain the later information they need, ask one clarification, and negotiate a suitable next step.",
            "promptLanguage": "en",
            "context": "学校让我们选星期天去的地方。有人想爬山，有人想在公园走走。我喜欢爬山，先说大家都去山上，觉得从山上看城市一定很漂亮。\n\n一个同学说自己脚不舒服，不能走太远。一个同学说不太会爬山，有点儿害怕。校长问我们，这次是为了爬得高，还是为了大家一起出去。\n\n我们再看地图，发现公园里有一条不用走太远的路，旁边有树，也有可以坐下休息的地方。走累了就坐一会儿，不用一直往上爬。\n\n星期天大家去了公园，脚不舒服的同学走了一会儿，就坐在旁边休息。我们也在附近看树、照相，没有让他继续走，更没有让他一个人在家里等。\n\n回学校时，我觉得这次很好。下次我可以和想爬山的朋友再去山上。大家一起做的事，要问问别人能不能做，不能只看自己想不想做。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "My reply uses the later information instead of simply repeating the first claim."
              },
              {
                "id": "r2",
                "text": "My clarification and proposed next step address the practical constraint."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
