                "singleWord": true,
                "audio": "78ef0559a6db2b39d54945c55db8c45fdfbaeb2c6b7e23851b73337c5ba872d6"
              },
              {
                "text": "不管",
                "pinyin": "bùguǎn",
                "meaning": "not to be concerned; regardless of",
                "singleWord": true,
                "audio": "e028e1a32684d94e90f386cb7a0f5ddb77ffbe10dac0d0eaef1697597070eaf4"
              },
              {
                "text": "无论",
                "pinyin": "wúlùn",
                "meaning": "no matter what or how; regardless of whether...",
                "singleWord": true,
                "audio": "018cef31481635e3812f8879293983e949013d1011feca369260baf901d31d07"
              },
              {
                "text": "都",
                "pinyin": "dōu",
                "meaning": "all; both; even or already (emphatic adverb)",
                "singleWord": true,
