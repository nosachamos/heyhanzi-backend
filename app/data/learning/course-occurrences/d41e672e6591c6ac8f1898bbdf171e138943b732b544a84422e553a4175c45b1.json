        "title": "更 + gradable predicate",
        "blocks": [
          {
            "text": "更 marks a higher degree relative to an understood or stated standard. It needs a comparison context, not merely strong praise.",
            "examples": [
              {
                "text": "今天更热。",
                "pinyin": "jīntiān gèng rè 。",
                "meaning": "It is even hotter today.",
