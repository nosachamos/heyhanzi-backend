    "id": "ACT-GRAM",
    "revision": 8,
    "title": "Mark recipients, companions and joint participants",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk2-participants-teach",
        "kind": "teach",
        "title": "Mark recipients, companions and joint participants",
        "blocks": [
          {
            "text": "给 marks an intended recipient; 跟 marks a companion or links people. 一起 before the verb indicates their shared action, not merely simultaneous unrelated actions.",
            "examples": [
              {
                "text": "我给妈妈买书。",
                "pinyin": "wǒ gěi māma mǎi shū 。",
                "meaning": "I buy a book for Mom.",
                "audio": "652aaf6225bce05dc480350e1f9f78defbadca3ef04d9f99ab7716f82234f97b"
              },
              {
                "text": "我跟他一起去学校。",
                "pinyin": "wǒ gēn tā yīqǐ qù xuéxiào 。",
                "meaning": "I go to school together with him.",
                "audio": "b938bfa2eddffe81bb42f1ea7027bf74a6fc3380fdaae7d1da42188ee2a5fda2"
              },
              {
                "text": "我给他一本书。",
                "pinyin": "wǒ gěi tā yī běn shū 。",
                "meaning": "I give him a book.",
                "audio": "28d3974876073e85b34e2f8d18ada7feb5696bc06080e8923134778355eb6122"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
