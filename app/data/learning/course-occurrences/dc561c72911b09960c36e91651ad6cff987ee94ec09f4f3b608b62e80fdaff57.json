    "steps": [
      {
        "id": "EX-CORE-WU03-skill-K-WARMUP-form-teach",
        "kind": "teach",
        "title": "Warm-up: form",
        "blocks": [
          {
            "text": "Stroke direction and component position help you distinguish a written form. A shape resemblance is a form cue, not proof that two words share a meaning.",
            "examples": [
              {
                "text": "人",
                "pinyin": "rén",
                "meaning": "person; people",
                "singleWord": true,
                "audio": "8fe6eb551d60df945dbf1dcd0b8671d30b40f7768b980264c54d7f068c10fca9"
              },
              {
                "text": "一",
                "pinyin": "yī",
                "meaning": "one",
                "singleWord": true,
                "audio": "49935700473fdf4ca3617d5d0264dde10971df6ac18088e917fc29b268088207"
              },
              {
                "text": "你",
                "pinyin": "nǐ",
                "meaning": "you",
                "singleWord": true,
                "audio": "b316ac0dd167bd8bef2048818a93b55be5371efb0af3024556cf9b5c93799d4d"
              },
              {
                "text": "他",
                "pinyin": "tā",
                "meaning": "he; him",
                "singleWord": true,
                "audio": "9c480d8cc48ccb2685cdcd2cd9d3a655e1e37adacccf6718895488e301aae503"
              }
            ]
          },
          {
            "text": "The displayed forms are the familiar person and one, followed by you and he. Compare visible strokes and the person-shaped part on the left of the latter pair. This is recognition and explanation; no Warm-up handwriting pass is claimed.\nFamiliar meanings available: person; people; one; you; he; him."
          }
        ]
      },
