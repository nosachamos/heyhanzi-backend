        "questions": [
          {
            "id": "EX-CORE-WU03-skill-K-WARMUP-form-explain-form",
            "kind": "production",
            "response": "written",
            "prompt": "Compare the familiar written forms for person and one, then the left components of you and he. Describe their visible directions or positions; handwriting is a separate activity. Explain the visible comparison in English or already familiar Chinese; do not invent a new compound.",
            "promptLanguage": "en",
            "context": "The displayed forms are the familiar person and one, followed by you and he. Compare visible strokes and the person-shaped part on the left of the latter pair. This is recognition and explanation; no Warm-up handwriting pass is claimed.\nFamiliar meanings available: person; people; one; you; he; him.",
            "contextLanguage": "en",
            "label": "Write your own message",
            "resultDomain": "Self-reviewed writing practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I compared visible strokes or positions rather than guessing a word meaning."
              },
              {
                "id": "r2",
                "text": "I kept character recognition separate from handwriting success."
              },
              {
                "id": "r3",
                "text": "I described the two diagonal strokes versus one horizontal stroke and its direction."
              },
              {
                "id": "r4",
                "text": "I located the shared left component without claiming that the complete forms have the same meaning."
              }
            ],
            "minLength": 1,
            "display": {
              "text": "人 一 你 他",
              "meaning": ""
            }
          }
        ],
        "sequential": true
      }
