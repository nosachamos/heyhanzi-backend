            "kind": "choice",
            "prompt": "Where is the shared person-shaped component in the two displayed forms?",
            "promptLanguage": "en",
            "context": "The displayed forms are the familiar person and one, followed by you and he. Compare visible strokes and the person-shaped part on the left of the latter pair. This is recognition and explanation; no Warm-up handwriting pass is claimed.\nFamiliar meanings available: person; people; one; you; he; him.",
            "contextLanguage": "en",
            "label": "Compare the actual written forms",
            "display": {
              "text": "你 他",
              "meaning": ""
            },
            "resultDomain": "Scoped written-form and context discrimination",
            "choices": [
              {
                "id": "EX-CORE-WU03-skill-K-WARMUP-form-component-position-c1",
                "label": "On the left of both forms.",
                "labelLanguage": "en",
                "correct": true,
                "feedback": "Both forms contain a narrow person-shaped component on the left. That visual cue does not make their whole-word meanings identical."
              },
              {
                "id": "EX-CORE-WU03-skill-K-WARMUP-form-component-position-c2",
                "label": "On the right of both forms.",
