    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-reference-teach",
        "kind": "teach",
        "title": "Refer to groups and possibilities precisely",
        "blocks": [
          {
            "text": "各 distributes across members; 任何 leaves the choice unrestricted. 各位 politely addresses a group, 此 is written this, and 敢 expresses courage or willingness to risk action. Formal 此 can stand for this matter or point, with an explicit antecedent; it is not a casual replacement for every 这.",
            "examples": [
              {
                "text": "各位老师，大家好。",
                "pinyin": "gèwèi lǎoshī ， dàjiā hǎo 。",
                "meaning": "Hello, teachers.",
                "audio": "4d6cdd673a58c746a80507b49e762c548f33a271d6ca91e290efad60dd24f166"
              },
              {
                "text": "各种书都有。",
                "pinyin": "gè zhǒng shū dōu yǒu 。",
                "meaning": "All kinds of books are available.",
                "audio": "f49cccb507dda081c1c4438e599ee78d5b30267fe197b4fc404962b1157b6f19"
              },
              {
                "text": "任何人都可以来。",
                "pinyin": "rènhé rén dōu kěyǐ lái 。",
                "meaning": "Anyone may come.",
                "audio": "a91c5e09261701ddad12d8b93d1461cf712cb91a650399d8281a543e9334277c"
              },
              {
                "text": "我不敢说。",
                "pinyin": "wǒ bù gǎn shuō 。",
                "meaning": "I dare not say.",
                "audio": "6676c9ed2e73f701865e086bbd05c22bf39cecd13477f6f6b524c2a57c5756a6"
              },
              {
                "text": "关于此，我们已经讨论过。",
                "pinyin": "guānyú cǐ ， wǒmen yǐjīng tǎolùn guo 。",
                "meaning": "We have already discussed this matter. A formal reference to the matter just mentioned.",
                "audio": "3aac3e54354bf5c0716aa5fc10c3802f49779aa1b64d6cd95a00f573062309aa"
              }
            ]
          },
