    "id": "ACT-GRAM",
    "revision": 7,
    "title": "Request, prohibit, invite and suggest",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-requests-teach",
        "kind": "teach",
        "title": "Request, prohibit, invite and suggest",
        "blocks": [
          {
            "text": "Put 请 before a request. Use 别 or 不要 before an action to tell someone not to do it. This is a prohibition, not a statement that the action is unnecessary. 我们…吧 proposes an action for the speaker and listener together. A suggestion differs from a request directed only at the listener.",
            "examples": [
              {
                "text": "请喝水。",
                "pinyin": "qǐng hē shuǐ 。",
                "meaning": "Please drink some water.",
                "audio": "7059b4d60ee2594bf86339ffd4f5e2babfa86c16edbeb545a8d16bdf5115ef43"
              },
              {
                "text": "不要说话。",
                "pinyin": "bùyào shuōhuà 。",
                "meaning": "Do not talk.",
                "audio": "ffaa499d60dd7b2d24568f5a6dc386a263e2214498fb454fb4206fd9de765741"
              },
              {
                "text": "我们去学校吧。",
                "pinyin": "wǒmen qù xuéxiào ba 。",
                "meaning": "Let us go to school.",
                "audio": "57acfbc470d080579ac41111a015f0b2e2321089387a9fb5a9a32ce6d6359c90"
              },
              {
                "text": "别说话。",
                "pinyin": "bié shuōhuà 。",
                "meaning": "Do not talk.",
                "audio": "dfe6b57fbbb69b1294b2d698f730bcef92b1340e9bf384bbd996eb88acda087f"
              }
            ]
          },
