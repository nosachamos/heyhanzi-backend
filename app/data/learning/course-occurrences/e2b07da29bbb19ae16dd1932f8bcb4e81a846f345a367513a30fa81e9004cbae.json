    "title": "Say what someone has",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-have-teach",
        "kind": "teach",
        "title": "Say what someone has",
        "blocks": [
          {
            "text": "Use person + 有 + thing for possession. 是 identifies someone or something; it does not mean have.",
            "examples": [
              {
                "text": "我有书。",
                "pinyin": "wǒ yǒu shū 。",
                "meaning": "I have a book.",
                "audio": "f4361bc3bd43151ad7c6d50bfe1a70662b0d2106b8766521587b94afe29c46e1"
              },
              {
                "text": "朋友也有书。",
                "pinyin": "péngyou yě yǒu shū 。",
                "meaning": "My friend has a book too.",
                "audio": "547ed263159d855549b726ef75a64a092bd4c073ad2da22aefecb7dcc0bfb3bb"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
