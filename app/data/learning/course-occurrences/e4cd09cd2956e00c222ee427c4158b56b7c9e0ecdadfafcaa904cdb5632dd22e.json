        "kind": "teach",
        "title": "早已 + predicate",
        "blocks": [
          {
            "text": "早已 places an attained situation well before the reference time. It is not an imminent future action.",
            "examples": [
              {
                "text": "他早已回家了。",
                "pinyin": "tā zǎoyǐ huí jiā le 。",
                "meaning": "He went home long ago.",
                "audio": "39bde002881abb74e254e8bddf4a0bce640fab26d418220c5369ffa8c8e8b18a"
              },
              {
                "text": "我早已知道这件事。",
                "pinyin": "wǒ zǎoyǐ zhīdào zhè jiàn shì 。",
                "meaning": "I have known about this for a long time.",
                "audio": "80e9a261c78e6ab5e9e9b0c8a799a8cb070cfdc7ace662692205bdbed2aea757"
