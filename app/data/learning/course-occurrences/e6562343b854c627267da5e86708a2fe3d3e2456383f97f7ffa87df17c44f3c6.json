    "steps": [
      {
        "id": "EX-GRAM-G-tone-particles-teach",
        "kind": "teach",
        "title": "Manage tone and shared expectations",
        "blocks": [
          {
            "text": "Sentence particles work with context and intonation. 吧 can soften an invitation or a tentative decision; 呀 can make an agreement warm; 啊 can mark surprise in a question. None is a fixed English word for politeness, agreement or hesitation.",
            "examples": [
              {
                "text": "请坐吧。",
                "pinyin": "qǐng zuò ba 。",
                "meaning": "Please have a seat, as a softened invitation.",
                "audio": "f450280eba14ebd4d1f07661c350cc15aa3b30a20dc917d6b84134a00e0bb7f8"
              },
              {
                "text": "好呀，我们一起去。",
                "pinyin": "hǎo ya ， wǒmen yīqǐ qù 。",
                "meaning": "Yes, let us go together, warmly.",
                "audio": "debb990aa658068fceda9bf2f3c58a25b37df8f23ced723a7d87bf69d8e8a1d4"
              },
              {
                "text": "那我再想一下吧。",
                "pinyin": "nà wǒ zài xiǎng yīxià ba 。",
                "meaning": "Then I will think about it a little more, as a tentative decision.",
                "audio": "ddd203e489064356c8ba9d43eba0cbbd31acb75f9bf8404b67328c4f96248e59"
              },
              {
                "text": "十个人都没听懂啊？",
                "pinyin": "shí gè rén dōu méi tīngdǒng a ？",
                "meaning": "None of the ten people understood, surprisingly?",
                "audio": "8696f3051c7a614fba78c201166d61a25c5ea5f6f8b382d24cdecfe7f36325c7"
              }
            ]
          },
          {
