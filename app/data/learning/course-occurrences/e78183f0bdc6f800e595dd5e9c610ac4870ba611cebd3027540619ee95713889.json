    "title": "Describe a continuing state",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-state-zhe-teach",
        "kind": "teach",
        "title": "Describe a continuing state",
        "blocks": [
          {
            "text": "着 after a verb can present a continuing state. It differs from 正在 presenting an action as currently unfolding.",
            "examples": [
              {
                "text": "门开着。",
                "pinyin": "mén kāi zhe 。",
                "meaning": "The door is open.",
                "audio": "6d7e9cd7340bc8bbbf73b549604be3e59726e1ba8f6b2cc31adc293df8b06c00"
              },
              {
                "text": "他拿着书。",
                "pinyin": "tā ná zhe shū 。",
                "meaning": "He is holding a book.",
                "audio": "24f4ffac7777c857c0cff8ea3ab831e74129b0ebef3e98539bcf45755b0294a5"
              }
            ]
          },
