        "kind": "teach",
        "title": "朝 + direction or target",
        "blocks": [
          {
            "text": "朝 introduces the direction or target of an action. It names orientation, not necessarily successful arrival.",
            "examples": [
              {
                "text": "他朝我笑。",
                "pinyin": "tā cháo wǒ xiào 。",
                "meaning": "He smiles at me.",
                "audio": "62c89b726e35e453fe92ccb31d369e7e6c59e1baf1034953917dbac498bd39f3"
              },
              {
                "text": "我们朝前走。",
                "pinyin": "wǒmen cháo qián zǒu 。",
                "meaning": "We walk forward.",
                "audio": "3302f28a295523c8a8eefaac77c4247fbeb72e9c96b0cce44d7f414edbee7da9"
              }
