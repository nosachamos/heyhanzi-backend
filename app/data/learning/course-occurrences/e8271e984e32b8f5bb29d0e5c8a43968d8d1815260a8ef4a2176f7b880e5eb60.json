        "blocks": [
          {
            "text": "仅仅 emphasizes a narrow limit. Identify the restricted fact or amount rather than reading it as a general intensifier.",
            "examples": [
              {
                "text": "我仅仅看了一页。",
                "pinyin": "wǒ jǐnjǐn kàn le yī yè 。",
                "meaning": "I read only one page.",
                "audio": "bf48e09d94045f34cce48da34264e056848e04733be8fda7c4706c68db0aa1fb"
              },
              {
                "text": "这仅仅是开始。",
                "pinyin": "zhè jǐnjǐn shì kāishǐ 。",
