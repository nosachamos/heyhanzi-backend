    "steps": [
      {
        "id": "EX-GRAM-G-past-negative-teach",
        "kind": "teach",
        "title": "Say it has not happened",
        "blocks": [
          {
            "text": "Use 没有 before an action that did not happen; normally leave out perfective 了. 还没 means not yet, with an expected or relevant later change.",
            "examples": [
              {
                "text": "昨天我没有去。",
                "pinyin": "zuótiān wǒ méiyǒu qù 。",
                "meaning": "I did not go yesterday.",
                "audio": "0577d534f22f69c16fa44d271da0eaf12a67944d88547906562c176a4e651255"
              },
              {
                "text": "朋友还没下班。",
                "pinyin": "péngyou háiméi xiàbān 。",
                "meaning": "My friend has not finished work yet.",
                "audio": "338bd2495cb5e3c6241faa05f50506830622c97dd098c72dad31e29f14ec468f"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "没",
                "pinyin": "méi",
                "meaning": "not; have not",
