    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-rhetorical-teach",
        "kind": "teach",
        "title": "Interpret rhetorical questions with question words",
        "blocks": [
          {
            "text": "Context can turn a question word into a challenge rather than a request for missing information. Identify the claim being rejected instead of automatically supplying a literal answer. 什么 and 怎么 can challenge a proposed action or judgement rather than request information; context distinguishes them from ordinary questions.",
            "examples": [
              {
                "text": "谁说年轻人不能把工作做好？",
                "pinyin": "shéi shuō niánqīng rén bùnéng bǎ gōngzuò zuò hǎo ？",
                "meaning": "Who says young people cannot do the job well?",
                "audio": "fe7e1c19e1a0a29b5377d07dfc40a392465d2e039f6bb2987e6e39d6df8b3f3b"
              },
              {
                "text": "这是什么办法！",
                "pinyin": "zhè shì shénme bànfǎ ！",
                "meaning": "What kind of solution is that! Said to reject an ineffective suggestion.",
                "audio": "82ddd4801fc0f9c72ce97a0b3840f7b18abc214d9d6b8b3cc05f854b8c7b7e49"
              },
              {
                "text": "这怎么行！",
                "pinyin": "zhè zěnme xíng ！",
                "meaning": "How could that be acceptable! Said to reject a proposal.",
                "audio": "43af054255b5f976351f88d94d708ec3aa6bdf7edcafa4cbbc911ceb5bb1bd74"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "什么",
                "pinyin": "shénme",
                "meaning": "what",
                "singleWord": true,
                "audio": "9d31346be013eed9f756f307fa24aa47175f41b795657e6634418c4c318a885a"
              },
              {
                "text": "怎么",
                "pinyin": "zěnme",
                "meaning": "how",
                "singleWord": true,
                "audio": "d43c4d972ba28faab0cce215b4aeb7656409b3eee5ae8d747919400121db614c"
