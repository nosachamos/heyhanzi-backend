              },
              {
                "text": "也",
                "pinyin": "yě",
                "meaning": "also; too",
                "singleWord": true,
                "audio": "9a59164d8b6244d9b464800c7e8dcf4aaa00958e9a9d52a3193a026a07853bcd"
              }
            ]
          }
