  "definition": {
    "id": "ACT-GRAM",
    "revision": 5,
    "title": "Join alternatives with 或",
    "subtitle": "Learn, understand, and use a Mandarin pattern.",
    "context": "Use the introduced pattern in a bounded sentence. Other wording may be valid Chinese; this task checks this pattern and these words.",
    "steps": [
      {
        "id": "EX-GRAM-G-hsk3-alternatives-huo-teach",
        "kind": "teach",
        "title": "Join alternatives with 或",
        "blocks": [
          {
            "text": "或 joins alternatives in a statement, often in concise written language. Use 还是 for an explicit alternative question instead of treating 或 as and.",
            "examples": [
              {
                "text": "你可以喝茶或水。",
                "pinyin": "nǐ kěyǐ hē chá huò shuǐ 。",
                "meaning": "You may drink tea or water.",
                "audio": "2b876bb18247d2dfcd433a28ac869cb45c7f797809ae58b4c1cd77da2cf77138"
              },
              {
                "text": "今天或明天都可以。",
                "pinyin": "jīntiān huò míngtiān dōu kěyǐ 。",
                "meaning": "Today or tomorrow is fine.",
                "audio": "9f42366d0cc7fe2d02f55958037f4b8379a14496db53def39c333c98b33208e9"
              }
            ]
          },
          {
            "title": "Words used in this pattern",
            "examples": [
              {
                "text": "或",
                "pinyin": "huò",
                "meaning": "or",
                "singleWord": true,
                "audio": "ec9a67bb407f151e90b54dc3685b84f61d356be25d92300ff8f8945608dd678b"
              },
              {
                "text": "或者",
                "pinyin": "huòzhě",
                "meaning": "or",
                "singleWord": true,
                "audio": "5a2e8800baf8105589f85df840655d136eb97e4a5bf1078ebf8353b18591660c"
              },
              {
                "text": "还是",
                "pinyin": "háishi",
                "meaning": "or (in alternative questions); had better (preference); still (despite an alternative)",
                "singleWord": true,
                "audio": "3c2edca87b1a73acbf9b0e2f2c7009544425f420845b75508abd1e4f1f1359b3"
              }
            ]
          }
        ]
      },
