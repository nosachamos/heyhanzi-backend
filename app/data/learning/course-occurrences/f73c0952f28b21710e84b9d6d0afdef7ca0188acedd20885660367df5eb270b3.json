    "steps": [
      {
        "id": "EX-CORE-WU03-skill-K-SOUND-connected-teach",
        "kind": "teach",
        "title": "Sound foundation: connected",
        "blocks": [
          {
            "text": "Dictionary pinyin records citation tones. Before another third tone, the first third tone is normally realized as rising; an ordinary low third tone need not rise fully inside a phrase. Outside counting or emphatic citation, 一 normally rises before a fourth-tone syllable and falls before a first-, second- or third-tone syllable; alone it keeps its high citation tone. 不 normally rises before a fourth tone and otherwise keeps its falling tone. These changes do not change the dictionary spelling.",
            "examples": [
              {
                "text": "一",
                "pinyin": "yī",
                "meaning": "one",
                "singleWord": true,
                "audio": "49935700473fdf4ca3617d5d0264dde10971df6ac18088e917fc29b268088207"
              },
              {
                "text": "不",
                "pinyin": "bù",
                "meaning": "not",
                "singleWord": true,
                "audio": "50ba7522835181a848c6884bdca0d6078d74020fda5cf5ddb4a238c7e44d2b93"
              },
              {
                "text": "你好",
                "pinyin": "nǐhǎo",
                "meaning": "hello; hi",
                "singleWord": true,
                "audio": "ba138555ea5e79f104066baccd5d743c996b1b7f150a3101dfe0b2e3eefda145"
              },
              {
                "text": "他",
                "pinyin": "tā",
                "meaning": "he; him",
                "singleWord": true,
                "audio": "9c480d8cc48ccb2685cdcd2cd9d3a655e1e37adacccf6718895488e301aae503"
              },
              {
                "text": "是",
                "pinyin": "shì",
                "meaning": "be",
                "singleWord": true,
                "audio": "7940c81ffb1e91957744588fa3aeea82d09d9d422020f67f6e9d7f3b4ed610b8"
              },
              {
                "text": "好人",
                "pinyin": "hǎorén",
                "meaning": "good person",
                "singleWord": true,
                "audio": "8b7f0c7eba6485f4668e2fbc5199e773c07c937266c02df831e4b4f1ae072a7e"
              }
            ]
          },
          {
            "text": "Use the familiar greeting and the statement that he is not a good person. The word for one is a citation-tone comparison only: no connected phrase with it has yet been taught.\nFamiliar meanings available: one; not; hello; hi; he; him; be; good person."
          }
        ]
      },
