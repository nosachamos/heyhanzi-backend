        "blocks": [
          {
            "text": "老是 describes repeated recurrence, often with dissatisfaction. It is not the age adjective old.",
            "examples": [
              {
                "text": "他老是迟到。",
                "pinyin": "tā lǎoshì chídào 。",
                "meaning": "He is always late.",
