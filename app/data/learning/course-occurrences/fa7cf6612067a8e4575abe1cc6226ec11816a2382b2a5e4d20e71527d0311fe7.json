              },
              {
                "text": "终于",
                "pinyin": "zhōngyú",
                "meaning": "finally; at last",
                "singleWord": true,
                "audio": "f6f53758b1830e7f71182e81b8d0ab5e60814709afcdcd08e823842c3d35662e"
