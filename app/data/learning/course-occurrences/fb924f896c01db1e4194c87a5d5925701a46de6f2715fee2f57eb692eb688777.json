  "fingerprint": "d8d8135171c4bb30f1b9f8ba4f796841e1ee153567b97e42c096a2d620479593",
  "definition": {
    "id": "ACT-SPEAK",
    "instanceId": "EX-CORE-U4-12-required-speaking",
    "revision": 1,
    "title": "Speaking and interaction practice",
    "subtitle": "A service decision · 3",
    "context": "Use the selected vocabulary and constructions to explain a practical need and compare available options.",
    "steps": [
      {
        "id": "EX-CORE-U4-12-required-speaking-produce",
        "kind": "check",
        "title": "Explain the situation",
        "questions": [
          {
            "id": "EX-CORE-U4-12-required-speaking-draft",
            "kind": "production",
            "response": "spoken",
            "prompt": "A service decision · 3: Explain the situation to someone who heard only the initial account. Clarify what changed, give a supported reason, and distinguish the participants’ stated intentions from assumptions.",
            "promptLanguage": "en",
            "context": "老师让我给四个同学准备练习，每个人一份。我看见桌子上有很多纸，就拿了四张，觉得四个人一人一张，不多不少。拿到教室时，同学问后面的题在哪里。\n\n我回去问老师。他说一份练习有三张纸，第一张读课文，第二张回答问题，第三张写自己的句子。四份需要十二张，不是四张，我听见份，却以为是张。\n\n老师没有让我只拿十二张纸就走。他让我先看每张上面写什么，把读课文、回答问题、写句子的放在一起，再做第二份。\n\n我用老师的方法准备四份，每份都检查是不是有三种练习。只看纸有多少，可能拿的都是一样的课文，一份一份看才知道有没有少东西。\n\n回到教室，我给每个同学一份，告诉他们先读，再回答，最后写。每个人都拿到了需要的纸，这次没有人问少了哪一张。\n\n下次老师说准备几份，我会先问一份里面有什么，再看要多少份。准备练习不是只要记住多少，还要明白一份是什么、里面要放哪些纸。",
            "contextLanguage": "zh",
            "label": "Take your speaking turn",
            "resultDomain": "Self-reviewed speaking practice",
            "rubric": [
              {
                "id": "r1",
                "text": "I retained the change or contrast that matters to the outcome."
              },
              {
                "id": "r2",
                "text": "I kept stated intentions separate from my assumptions."
              }
            ]
          }
        ],
        "sequential": true
      }
    ],
