    "steps": [
      {
        "id": "EX-GRAM-G-hsk4-connectors-p13-teach",
        "kind": "teach",
        "title": "cause, 因此 + consequence",
        "blocks": [
          {
            "text": "因此 introduces a consequence justified by the preceding cause. Keep cause before consequence in this frame.",
            "examples": [
              {
                "text": "下雨了，因此比赛取消了。",
                "pinyin": "xiàyǔ le ， yīncǐ bǐsài qǔxiāo le 。",
                "meaning": "It rained; therefore, the match was canceled.",
                "audio": "24cf68afb1a4446cb0f936dc02bf6b183fc5cdd53dba8e3267b9b646029fac4d"
              },
              {
                "text": "他很忙，因此没来。",
                "pinyin": "tā hěn máng ， yīncǐ méi lái 。",
                "meaning": "He was busy; therefore, he did not come.",
                "audio": "a0a3c6d1f9d9a7efe67743f1288a5aa966f0989005ff6842ced1b024b75601cd"
              }
            ]
          },
          {
