          ],
          "transcript": [
            {
              "text": "我认为互助很重要，诚信也很重要。",
              "pinyin": "wǒ rènwéi hùzhù hěn zhòngyào ， chéngxìn yě hěn zhòngyào 。",
              "meaning": "",
              "audio": "2f5917bd3a857c42dec26b1bdd3adc3ab0635205bb1f240a7759983013c97c4f"
            },
            {
              "text": "我也认为互助很重要，可是他可能没有听懂我们的请求。",
              "pinyin": "wǒ yě rènwéi hùzhù hěn zhòngyào ， kěshì tā kěnéng méiyǒu tīngdǒng wǒmen de qǐngqiú 。",
              "meaning": "",
              "audio": "703b1da6660a8129e3616dd724c88170172c4f5f6a649c3f30fcfa52382a1ffa"
            }
          ],
          "listeningRequired": true,
          "choices": [
            {
              "id": "BANK-K-HSK6-listen-K-HSK6-listen-listen-meaning-1-c1",
              "label": "Mutual help is important.",
              "labelLanguage": "en",
              "correct": true,
              "feedback": "Compare the participants, stated event and qualification in the complete exchange."
            },
            {
              "id": "BANK-K-HSK6-listen-K-HSK6-listen-listen-meaning-1-c2",
              "label": "The request was certainly understood.",
              "labelLanguage": "en",
