            },
            {
              "text": "我以为他是你的熟人。他昨天没有来。",
              "pinyin": "wǒ yǐwéi tā shì nǐ de shúrén 。 tā zuótiān méiyǒu lái 。",
              "meaning": "",
              "audio": "fa7ba0eff2ccd09d7ae8290ec89dc14b78d0c32dc92762c1058997a1bc967634"
            }
          ],
          "listeningRequired": true,
          "choices": [
            {
              "id": "BANK-K-HSK5-listen-K-HSK5-listen-listen-meaning-1-c1",
              "label": "He did not come yesterday.",
              "labelLanguage": "en",
              "correct": true,
              "feedback": "Compare the participants, stated event and qualification in the complete exchange."
