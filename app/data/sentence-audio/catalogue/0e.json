{
  "0ee68d87314349e197252bce5ae116e940530589eba41d716c28e19f90256377": {
    "text": "我看到你了。",
    "pinyin": "wǒ kàn dào nǐ le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0ef62865e6ef768ba82c490b3cde90938261ef1956ac62c588da8288edff6d6b": {
    "text": "我在公司工作，你也在这里吗？",
    "pinyin": "wǒ zài gōng sī gōng zuò ， nǐ yě zài zhè lǐ ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0e79ff42367f0de9f4eb78b06c3284a106755d0f4a999a9dea57205c2ff79912": {
    "text": "我不知道是不是他。",
    "pinyin": "wǒ bù zhī dào shì bu shì tā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0e52499a60db3d0bd137c8dce9bf181efdf5829ad3b32c03a502a4b9fdaba694": {
    "text": "请张开嘴。",
    "pinyin": "qǐng zhāng kāi zuǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0e17fad8b2822d7d8d04723efbafbcac87ee0fae5dfd39067ced37aa91d9acbf": {
    "text": "我可以打开电灯吗？",
    "pinyin": "wǒ kě yǐ dǎ kāi diàn dēng ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0ec14dceeb830f98e286db1d6780e6c8e7739e44801c804bf6519721dd387a1b": {
    "text": "这儿的饭店很卫生。",
