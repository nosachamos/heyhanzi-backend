    "kind": "sentence",
    "quotedReadings": []
  },
  "0ead5201a6225b2377de8e8dcb450172e64eee43621294d7928ed80a5733a0ab": {
    "text": "会计方法很重要。",
    "pinyin": "kuài jì fāng fǎ hěn zhòng yào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0efca565ecc4003fd8ffbae218de4fbc250f1e7d02006f8b8c306738024ab5e7": {
    "text": "旧照片可能很值钱。",
    "pinyin": "jiù zhào piàn kě néng hěn zhí qián 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0ec8e9d865206215f7c137ce997e8d8d2ea05cf68d47f381ddd1322a17097e75": {
    "text": "他们想竞赛吗？",
    "pinyin": "tā men xiǎng jìng sài ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "0e0ca33254cdb38456602266af8e3674d8db71924fcbea1ceb75c45c8e81af25": {
    "text": "网络终于接通了。",
    "pinyin": "wǎng luò zhōng yú jiē tōng le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
