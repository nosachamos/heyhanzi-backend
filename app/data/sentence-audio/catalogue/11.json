{
  "1157461147f997db8d5ce097596dec81702496b6ba049c301369414033982356": {
    "text": "我们要去那里玩。",
    "pinyin": "wǒ men yào qù nà li wán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11844c6793fcc0eb213d51df6a4f740f909fcd69feb6bdd72fd4b41a4f17dc1f": {
    "text": "他的哥哥在中学读书。",
    "pinyin": "tā de gē ge zài zhōng xué dú shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "1157d9c2fa55c9810c5406bd8af522b820e1a09f4879f48879cf3bcc3bd38f31": {
    "text": "大地妈妈爱我们。",
    "pinyin": "dà dì mā ma ài wǒ men 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11e12ff939e49fe222d19dc1fefc8fce010828b3c0bbd3d72d1e35bee40325e4": {
    "text": "我需要你的帮助。",
    "pinyin": "wǒ xū yào nǐ de bāng zhù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "1158307a70458684942ca06986d7314cc11a4982ad3d4242d848f54206a13919": {
    "text": "我说：“全村的大事开始了。”",
    "pinyin": "wǒ shuō ： “ quán cūn de dà shì kāi shǐ le 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11bb042f6c3693f60341f57d988e1f7d285e6aac240212e708b230918f88642c": {
    "text": "整个过程很快。",
    "pinyin": "zhěng gè guò chéng hěn kuài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "111298928f78d4c4c1cdaaa3c26d6e748236a6ff9c06355ccaca670fdf442e9f": {
    "text": "我们欢聚为了节日。",
    "pinyin": "wǒ men huān jù wèi le jié rì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11c849231abfafe9ac786f99fa75c70ac5407f4c51aa0ab09c33b381fd3cbd60": {
    "text": "大家在一起庆贺生日。",
    "pinyin": "dà jiā zài yī qǐ qìng hè shēng rì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11ccfa69f9afe1b22df4ea542896959d62619207863ce54b6ce827e207979334": {
    "text": "旅游大巴很舒服。",
    "pinyin": "lǚ yóu dà bā hěn shū fu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "1160572e80da318e39c079870b6fbaf04a75c1a89ff7e3ea4f56e408acf75b40": {
    "text": "他也喜欢猪。",
    "pinyin": "tā yě xǐhuan zhū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "1170ab75d11263c17ebe029c7105ea2b0a426348731cf85bb3a9029d3a5c9b77": {
    "text": "搜救队已经出发了。",
    "pinyin": "sōu jiù duì yǐ jīng chū fā le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "1189d7549dbfa34a31f95ca4200fb42743dd2e556a6025e96f389ea52f692c0c": {
    "text": "前面要转弯了，请你开慢一点。",
    "pinyin": "qián miàn yào zhuǎn wān le ， qǐng nǐ kāi màn yī diǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "119f713c923805555d5c48820fb7b9eeed54acc7734afb2a419ae2c32fa1bbd9": {
    "text": "傍晚，路灯亮了起来。",
    "pinyin": "bàng wǎn ， lù dēng liàng le qǐ lai 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11d4cf7eba409293ec68e21149064aa55de6a27ec7c126571eefd4b2c168d134": {
    "text": "应付诸实际行动。",
    "pinyin": "yìng fu zhū shí jì xíng dòng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "11ab48f180aeaa9597a460b37f901992bc1578d815caa4fcaf420ce2f14b8340": {
    "text": "他总是习惯性地歪曲我的原意。",
    "pinyin": "tā zǒng shì xí guàn xìng de wāi qū wǒ de yuán yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
