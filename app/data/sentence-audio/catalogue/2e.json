{
  "2e3b5e3f97f9d18ae4dabd1e49e791c7197a4f2444735e0feda54bab4c25d3e8": {
    "text": "他问了一个问题。",
    "pinyin": "tā wèn le yí gè wèn tí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e981d6a19cd3c4ab44f5e84351b89a8062e4661cf9389b2e2aa9777fc14e7cc": {
    "text": "我学习两个小时。",
    "pinyin": "wǒ xué xí liǎng gè xiǎo shí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ebcbd7df9b6eab45efc78a760ff5e84d197726f9a0aace3a8966d8113e37aca": {
    "text": "他是我头号朋友。",
    "pinyin": "tā shì wǒ tóu hào péng you 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2efeef6a8584e15dda71c3a2fddcec03248cd137369a0768e4ef632a0c9b8f15": {
    "text": "她说：“他被那家公司面试了。”",
    "pinyin": "tā shuō ： “ tā bèi nà jiā gōng sī miàn shì le 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e84e7ba1b127b8f870193cf66fd447d46bf5f8de69e34498fde01c657c8633a": {
    "text": "他给老人让座。",
    "pinyin": "tā gěi lǎo rén ràng zuò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ee932e0a761199a5aaa1d627d99a8cfb9c5f8d71519922a09069138fd2b45b4": {
    "text": "公园的花非常可观。",
    "pinyin": "gōng yuán de huā fēi cháng kě guān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e4b844953fe9367a4301312dfd985ba8f0dd45c658a942101fcef64396d7183": {
    "text": "他赶往机场接朋友。",
    "pinyin": "tā gǎn wǎng jī chǎng jiē péng you 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2eb73ee81b66a4003423ad493119e5b69e4361947ac2a502d055105f6cafcdf1": {
    "text": "他用印章写名字。",
    "pinyin": "tā yòng yìn zhāng xiě míng zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ef40e86ae4b0c1b37b7198559d47191d0d743cdcdebac11abe2eb4910667c7d": {
    "text": "大学正在招收学生。",
    "pinyin": "dà xué zhèng zài zhāo shōu xué sheng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ebb6bbe292bfea0aaf7b25d0461f537a418a1bd9ae59ffd26bea4a015624a77": {
    "text": "周末我们去郊外玩儿吧。",
    "pinyin": "zhōu mò wǒ men qù jiāo wài wán r ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e9e3b252fabd9fe62dea1d3fc7457b5c0499ab9b1d02dd3fb8884c30271df5a": {
    "text": "深呼吸，慢慢出息。",
    "pinyin": "shēn hū xī ， màn màn chū xī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e79aa7d9c334d7a55e3459b8af74908d56489d8548a0568ae7f101b7b8f2150": {
    "text": "大家一起照相留念。",
    "pinyin": "dà jiā yī qǐ zhào xiàng liú niàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e5e21e7c10fb444131a04ab986c661d6a1f05d5cb7123dd6dfe61489e3afe61": {
    "text": "理智比感情重要。",
    "pinyin": "lǐ zhì bǐ gǎn qíng zhòng yào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e9b7261ef4270c0b67427093e6761951fa776ddac3e3eecc91f8af7bc2e1316": {
    "text": "他的呼吸变得微弱。",
    "pinyin": "tā de hū xī biàn de wēi ruò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ec8d1afbd96d3e2d066f33a7a19e616de76c14ad229b662aa8af5003bddc553": {
    "text": "开发商正在盖新的房子。",
    "pinyin": "kāi fā shāng zhèng zài gài xīn de fáng zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e09104140ef131e3d78ecc7eb38740b23b4172b950ebb5d4d909110dbeeb308": {
    "text": "我们必须保证粮食供应。",
    "pinyin": "wǒ men bì xū bǎo zhèng liáng shi gōng yìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e0fe93911af50689da6c776e743ad0174e5a507c14ed8310985e79c01bb1ff7": {
    "text": "他写的书很对我的胃口。",
    "pinyin": "tā xiě de shū hěn duì wǒ de wèi kǒu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e2d6a5df02abef11816d457ac30cbbe2f722bfba1b5aa5e6f86dfdad4312051": {
    "text": "他做了一道豆腐菜。",
    "pinyin": "tā zuò le yī dào dòu fu cài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e090a1f89ebc69957028e73a22aa0821f85dfa0d274cdd121de045bfe77e025": {
    "text": "他们的进攻很突然。",
    "pinyin": "tā men de jìn gōng hěn tū rán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2ef8179751c0b1c49d7c0a49170702e89562e7c05b55bfb4be1ef6390405a697": {
    "text": "孩子们在喷泉旁边玩儿。",
    "pinyin": "hái zi men zài pēn quán páng biān wán r 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e6573e0768243e234d10e236e3389f9d4e9a986154d50823b5b53e5e19e1e70": {
    "text": "工人把大石头吊了起来。",
    "pinyin": "gōng rén bǎ dà shí tou diào le qǐ lái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e8deee9d9a84708c86c88dda80cbae5f44eb5f6cb2ef5920ac14c77910a8bc8": {
    "text": "这种现象在社会上极为罕见。",
    "pinyin": "zhè zhǒng xiàn xiàng zài shè huì shàng jí wéi hǎn jiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2e23ed075d4670cc6c8ad5e88a9c6d1ede442f25bb83d86241e736a0c46ee208": {
    "text": "大家撤离那个地方。",
    "pinyin": "dà jiā chè lí nà ge dì fāng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "2eb22edb637f134f4a08eb56550dbf283da4c45c2ded17b0099093512c24eda3": {
    "text": "为了安全，我们都要戒备。",
    "pinyin": "wèi le ān quán ， wǒ men dōu yào jiè bèi 。",
    "kind": "sentence",
    "quotedReadings": []
