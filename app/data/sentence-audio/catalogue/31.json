{
  "31c35e6ef9ed47350b7e5df8c3d024b5874a2454d68a238795b52f00ee8b367c": {
    "text": "你要来公司吗？",
    "pinyin": "nǐ yào lái gōngsī ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31ecacb17743132e35393b8be3878d8b974552089873e5f13e55a125e41ea24c": {
    "text": "没想到，他真的有两下子。",
    "pinyin": "méi xiǎng dào ， tā zhēn de yǒu liǎng xià zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3167151f804904d0e4dcc2b6d1ff35cf54f6a8892773262b42c1f020fd5bcb30": {
    "text": "我们是朋友。",
    "pinyin": "wǒmen shì péngyou 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3160df59998f301f28b2c8b6a5493c9e386d174193d17e8a09babc10e3f8a9dd": {
    "text": "她有两个姐妹。",
    "pinyin": "tā yǒu liǎng gè jiě mèi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "312c94f0df07e92f8acaf246f03f3da1a5e84359084628482baef08cd5f72320": {
    "text": "他为了问题前来。",
    "pinyin": "tā wèi le wèn tí qián lái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3184ed72d18bcb8fdcbafd23d05e4bec3151743528f0ad873b1076468199fdd0": {
    "text": "下周一你有时间吗？",
    "pinyin": "xià zhōu yī nǐ yǒu shí jiān ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31b94c150dd397f537aa922b493004f572f80a50ecb813c1cf1e7202dc4849cd": {
    "text": "这个家面目全非。",
    "pinyin": "zhè ge jiā miàn mù quán fēi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31f13e89d2d67763815e22bf64e70ce2414904d924e57cc31c19a42bb2b79d0a": {
    "text": "他想去看看那条运河。",
    "pinyin": "tā xiǎng qù kàn kān nà tiáo yùn hé 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31dd3bd6dfa297d75dba98a39f4028fb2993a72404d772194626e50318d9d03f": {
    "text": "树上的苹果看起来很饱满。",
    "pinyin": "shù shàng de píng guǒ kàn qǐ lai hěn bǎo mǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3156cff89952fa5229f8b1418e787e2aa2bbbfffd00fa63817a61e8ec75b814a": {
    "text": "这些衣服合格吗？",
    "pinyin": "zhè xiē yī fu hé gé ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31e7a22154d6371de06d9005509910d4ed05196b90fa6a5f9fb2a42c7ba77764": {
    "text": "老师得出结论。",
    "pinyin": "lǎo shī dé chū jié lùn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3188aa1cadabc756a2e2941caf2fcf176925bb7f6c90c6c788c281f9c34ac793": {
    "text": "不幸的是，飞机晚点了。",
    "pinyin": "bù xìng de shì ， fēi jī wǎn diǎn le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31011c71ddca6820c74d3e9d6acd3ef316d4122562a583426c1393ec961dc5ce": {
    "text": "这封信需要挂号吗？",
    "pinyin": "zhè fēng xìn xū yào guà hào ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31c4ebb3486ea18845854998b4b1e40dccf53e7c77116828930f764dd6f31b3d": {
    "text": "他开始流浪的生活。",
    "pinyin": "tā kāi shǐ liú làng de shēng huó 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31047ae503d5b832c66e9729f91169e49253fd81806a7f02d52a5764a620f14a": {
    "text": "他用刀切除了这一块。",
    "pinyin": "tā yòng dāo qiē chú le zhè yī kuài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "31c406eb34e557eaa7b79cce40daaddafb18cac397e8c715365345757bb25420": {
    "text": "快把垃圾拿走。",
    "pinyin": "kuài bǎ lā jī ná zǒu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "316ce4c77b75fb481ef05b63bb6bd3a5bba7476150fef3eda7ec979b87ccfe72": {
    "text": "现在市场上的水果供应过剩。",
