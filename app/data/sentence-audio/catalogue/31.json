    "kind": "sentence",
    "quotedReadings": []
  },
  "31068f650e569e3cfb64336515cb560f80b7f0b2af17f54fa09d5976c5e04e1b": {
    "text": "汤有点咸。",
    "pinyin": "tāng yǒu diǎn xián 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "317aeff9c6b51805a4cd4e487b33a2ee443515176e8bde048a7fa1eb01ee9d3f": {
    "text": "软件工程非常重要。",
    "pinyin": "ruǎn jiàn gōng chéng fēi cháng zhòng yào 。",
    "kind": "sentence",
    "quotedReadings": []
