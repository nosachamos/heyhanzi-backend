{
  "3589ad0291729b0d8795932a1e65f24620e3eb6cbce9cb8c9a61466b5c5ab71c": {
    "text": "她说：“他现在没有知觉。”",
    "pinyin": "tā shuō ： “ tā xiànzài méiyǒu zhī jué 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35c08a255ecd81447c6842b2367a026e7f9a95c509b1a884b484460395a16ef1": {
    "text": "她说：“老师是哪些人？”",
    "pinyin": "tā shuō ： “ lǎo shī shì nǎ xiē rén ？ ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35021753e886587be59f9702f56124869d19f6ec987c7bb49781113df164e55e": {
    "text": "他不来，第我也去。",
    "pinyin": "tā bù lái ， dì wǒ yě qù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35d83c47ae555a439808a62ac0d3fe905289507408224b651cfcda51d447803a": {
    "text": "你喂了狗吗？",
    "pinyin": "nǐ wèi le gǒu ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35f08b5a2cc49ce6678474c931f8adda6d353aaedcc7d130646d824b56d2e56c": {
    "text": "你和他一样高。",
    "pinyin": "nǐ hé tā yī yàng gāo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3588480cfb8300f87c7c55513b6c7b75284b96f156d239bb4220b0045ffed8a3": {
    "text": "今天天气好极了。",
    "pinyin": "jīn tiān tiān qì hǎo jí le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35cae14115f82cac56d8098fc897b3906753ddf7dc57519ed028f0b6fba8c31c": {
    "text": "明天我们去打羽毛球双打吧。",
    "pinyin": "míng tiān wǒ men qù dǎ yǔ máo qiú shuāng dǎ ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35131b7ff73f2f3d79950823ca7b327a17b8ca104634befde1d3c6f8e276da30": {
    "text": "他哭也无济于事。",
    "pinyin": "tā kū yě wú jì yú shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35b3ef937f106f67e82c8f60ff5462d08e3934c75a4535b54f4138560ceb26dc": {
    "text": "你肯定听错了吧？",
    "pinyin": "nǐ kěn dìng tīng cuò le ba ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35bc4a6207e4d5654da570f30880e905f0861a66b78efdadc6e387c4b133c85f": {
    "text": "我们要消除误会。",
    "pinyin": "wǒ men yào xiāo chú wù huì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35b7ec34517f69a6c99c9bc754351c5dd39e821c92cf2780a07cf29d90f6413f": {
    "text": "这家餐馆的味道不亚于市中心的那家。",
    "pinyin": "zhè jiā cān guǎn de wèi dao bù yà yú shì zhōng xīn de nà jiā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "355fa2d8c42b7fd3a57a9489d02f9f846ad2e42bf178c91f6c5541bf50a4b324": {
    "text": "做饭是她的绝招。",
    "pinyin": "zuò fàn shì tā de jué zhāo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "359f46264e9a89e65cae99dba2c923551fe0a71a0951b90099dd111c7a34bba3": {
    "text": "她说：“我们周末一起去逛夜市吧。”",
    "pinyin": "tā shuō ： “ wǒ men zhōu mò yī qǐ qù guàng yè shì ba 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3507ed914d8ce7c63bc3c838d2dec92f9205e74095c4e73e3cd4e97c8acf360f": {
    "text": "看到照片，她流下了泪水。",
    "pinyin": "kàn dào zhào piàn ， tā liú xià le lèi shuǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3598b3bd9ed2e1e5c3db6ace0deefaf03ebadbf89c268cb1e48cfd15f30cd6ab": {
    "text": "这辆出租车在夜间行驶。",
    "pinyin": "zhè liàng chū zū chē zài yè jiān xíng shǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35b60f4e319f8db80a0631752d67460c784a16f461ca9396e42a15592c9f0320": {
    "text": "老师请我们搜集一些资料。",
    "pinyin": "lǎo shī qǐng wǒ men sōu jí yī xiē zī liào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35ee1a0d4b87237ac95164ebfd8b28b5b6acf54580be4c1db26d4414463acf00": {
    "text": "正版软件在店里。",
    "pinyin": "zhèng bǎn ruǎn jiàn zài diàn lǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35fadafc74ab253288c5433e13e25c4e578d28cd7c2ec1bac9c4dd65edc7c981": {
    "text": "这件事的逻辑很严密。",
    "pinyin": "zhè jiàn shì de luó ji hěn yán mì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "359c7dd279c2c1640b5476ab64207810d5de87c20550c63585b9ef80ca90ff3c": {
    "text": "多边谈判涉及很多利益。",
    "pinyin": "duō biān tán pàn shè jí hěn duō lì yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35c6817585334e20aacef948c42826950df054000e5d5daa04d65341003706b6": {
    "text": "爸爸去买煤气。",
    "pinyin": "bà ba qù mǎi méi qì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "352f956b6c51e76598480460ddb41c39d72ad03e35f79f2775a7ca6a6f79fa78": {
    "text": "这封信是在恐吓他。",
    "pinyin": "zhè fēng xìn shì zài kǒng hè tā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35cfd04145dd0e614918e6d65c9cdc51cec22dab233613b34e0bd43a8f62dfc7": {
    "text": "乡村的夜晚总是充满了一种原始的寂静。",
    "pinyin": "xiāng cūn de yè wǎn zǒng shì chōng mǎn le yī zhǒng yuán shǐ de jì jìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "356d18af6e4bb4cb608885625d65e4b5e1ec9752110c40e1a315af480a670de5": {
    "text": "运动可以促进血液循环。",
    "pinyin": "yùn dòng kě yǐ cù jìn xuè yè xún huán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35bbcd216cf99eda3978a5af775a863f342ed7574e90018d899a8dcb1f403b8d": {
    "text": "孩子们在草地上跳跃，玩得很开心。",
    "pinyin": "hái zi men zài cǎo dì shàng tiào yuè ， wán de hěn kāi xīn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "35553c1fc0eeaf0ba7885c265898edcc0994d45d63f9cfbe1ca60f1cf4c0561e": {
    "text": "她长得酷似她的母亲。",
    "pinyin": "tā zhǎng de kù sì tā de mǔ qīn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "358699ec039d0989244a211130d291797fb540b42c8fd894371b307b8170e464": {
    "text": "报刊介绍了这个地方，我想亲自去看看。",
    "pinyin": "bào kān jiè shào le zhè ge dì fang ， wǒ xiǎng qīn zì qù kàn kan 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "352fb40a01257b6004b0185c404ac47593c9c8bbc2b5f1ec169ff7c6d2b54be5": {
    "text": "这个枕头太软了，我不喜欢。",
    "pinyin": "zhè ge zhěn tou tài ruǎn le ， wǒ bù xǐ huan 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3571968af4ed0c57594ba43f9f64d8f5e468725f2f35cb35fd6de8d36f09e8c5": {
    "text": "五星红旗是国家的象征。",
