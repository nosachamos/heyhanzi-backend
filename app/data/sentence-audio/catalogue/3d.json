{
  "3d8af3e56c7518019e2d8e3a365e4586b16a9501935876e40ff87872a29685d9": {
    "text": "这个在下面。",
    "pinyin": "zhège zài xiàmiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d149d8d3911eb0bf1aa080fb91a107ab44bf2df4bf96549b8c238ed94b372dc": {
    "text": "买票是必须的。",
    "pinyin": "mǎi piào shì bì xū de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3def1a85704d651fe6d7be64e2b78289466113e5fa843cc459f2b06588a09e3f": {
    "text": "我说：“妈妈买了新卡子。”",
    "pinyin": "wǒ shuō ： “ mā ma mǎi le xīn qiǎ zi 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d5590240897a58c1fb038a41ac9d1a5a5dda1eaace01d57e4c9309620712887": {
    "text": "妹妹低头看花。",
    "pinyin": "mèi mei dī tóu kàn huā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d9911a1273fe900db4172fc773e9fefb632a1e697926cb841e2187b7b64557d": {
    "text": "运动员竞相跑步。",
    "pinyin": "yùn dòng yuán jìng xiāng pǎo bù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d39c62d29372f3b2ca2d0a25ce61e487ed524ab49ea0a73b34cb15a14d4c6ce": {
    "text": "你应该尽快表态。",
    "pinyin": "nǐ yīng gāi jǐn kuài biǎo tài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d307488c7275e226ac80c6c6cf33de022527b3a62701443eeb735b66e58702e": {
    "text": "既然那时无法改变，何必后悔？",
    "pinyin": "jì rán nà shí wú fǎ gǎi biàn ， hé bì hòu huǐ ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d587869025e45a7ea472d5ccf1c78a06ad25ed97006a73a78c99a23ae034e03": {
    "text": "身体组织很健康。",
    "pinyin": "shēn tǐ zǔ zhī hěn jiàn kāng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3de43724bacd73e5ed69f0cadd72e761e6834ba1d09845648afab5c0a85ef9f6": {
    "text": "他在商店推销手机。",
    "pinyin": "tā zài shāng diàn tuī xiāo shǒu jī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3d65e8e52d8f249ce4fdc0703837c0786f02096c110489ab2d7d824b140e92e9": {
    "text": "公司调控市场方向。",
    "pinyin": "gōng sī tiáo kòng shì chǎng fāng xiàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "3db2b7702f9fa95c9a13eba011fe8dc94e5fc841a39987bfdf7b65726854e172": {
    "text": "你有几个同学缺席？",
    "pinyin": "nǐ yǒu jǐ gè tóng xué quē xí ？",
    "kind": "sentence",
    "quotedReadings": []
