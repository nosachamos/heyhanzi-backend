{
  "41671d2a43e48080cbaef9838390e75c3f51682f4376a209864e182ec4df3cfe": {
    "text": "我！",
    "pinyin": "wǒ ！",
    "kind": "sentence",
    "quotedReadings": []
  },
  "41212a1d764bc2efd81f5290b4d1f7c0cb4c263d1b6ee5a907a79a0099960f47": {
    "text": "我们的老师很好。",
    "pinyin": "wǒmen de lǎo shī hěn hǎo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "411707cfe68776a5f04a18779d83762b8a71e5866fac6a56aa4c9aa3508e92c4": {
    "text": "他在我后面。",
    "pinyin": "tā zài wǒ hòumiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "41ec4a66bef2e803e0d97e28852e2198f32bcf4685e0a3b4010716bc35c1aa3a": {
    "text": "请你去那边坐。",
    "pinyin": "qǐng nǐ qù nà bian zuò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "412330be8251b3d14474fe940a3d076ae018bd0c8ac9763bf2777452d645bca1": {
    "text": "那个漂亮的少女正在看书。",
    "pinyin": "nà ge piào liang de shào nǚ zhèng zài kàn shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4122e34f6bfc22bce21210b9ac9e9c241236a6b7ab2c4bb89bbf5682226709c9": {
    "text": "这样做会让大家没面子。",
    "pinyin": "zhè yàng zuò huì ràng dà jiā méi miàn zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "41da6e4325a7e56184f246ab3f7873571490c5c7c06d99e49099f89d29bb8c8e": {
    "text": "她说：“我已经是学生了。”",
    "pinyin": "tā shuō ： “ wǒ yǐ jīng shì xué sheng le 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "419c854d8fbeba0cd9318a641525b159c2624f00e032b8bfc85782479b88f191": {
    "text": "为了健身，他开始早起。",
    "pinyin": "wèi le jiàn shēn ， tā kāi shǐ zǎo qǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4189fc93f6e65f5925b22a46702ed438d984b1176ecb69dfc9841875166be6eb": {
    "text": "了解运作不容易。",
    "pinyin": "liǎo jiě yùn zuò bù róng yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "41c3a851d6e591ec963e13fd936a09f9a18cf08539b2dba7757cc9f4266e4921": {
    "text": "路边有很多车辆。",
    "pinyin": "lù biān yǒu hěn duō chē liàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "417b6c9d74cf88b32b6c651e79bc0b36f3972a8ce17ee7e2f2b62e9e763d282e": {
    "text": "他像个孩子似的。",
    "pinyin": "tā xiàng gè hái zi shì de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4148c4cca83151b55bcfb82b04c3cca7127ea2f88454b5e60a24a31af2dfb1db": {
    "text": "船快要撞到冰山了。",
