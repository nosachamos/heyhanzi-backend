    "kind": "sentence",
    "quotedReadings": []
  },
  "413fde182558dce603fe7ddbdf527e8ff65c82c8289fc786293cdc932abf06b4": {
    "text": "大厦左边有一个公园。",
    "pinyin": "dà shà zuǒ bian yǒu yī gè gōng yuán 。",
    "kind": "sentence",
    "quotedReadings": []
