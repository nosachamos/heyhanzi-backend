{
  "4d44ed0b96e9f5467797effea7687a6d439d8530eed5df6ae29d0d9f3bcefcbb": {
    "text": "她说：“这个很小。”",
    "pinyin": "tā shuō ： “ zhège hěn xiǎo 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4db377598575be1a529d8df6873613b9ce702d010eb89fd0ae78b021c4744d29": {
    "text": "她说：“这是有关人士。”",
    "pinyin": "tā shuō ： “ zhè shì yǒu guān rén shì 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d033e0662fce0eb109b2aca866be1b57cf378308e7131eeb9228191bf94eb15": {
    "text": "这里有千个人。",
    "pinyin": "zhèlǐ yǒu qiān gè rén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4db44d926ea12a25b389a2b570cb9d4d80f169a56b108f415ff7614350471f8b": {
    "text": "你能学会游泳真是了不起。",
    "pinyin": "nǐ néng xué huì yóu yǒng zhēn shì liǎo bu qǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d40aa9e1e6848ab42f7f7d8b6a296dab7c593b0e91efb60c5694783e985f258": {
    "text": "他想超越那个老师。",
    "pinyin": "tā xiǎng chāo yuè nà ge lǎo shī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d39eebe82c2664c6d6988d79f6492fe1e0a7ee92a53a0d911d260729f39e52e": {
    "text": "我发生事故了。",
    "pinyin": "wǒ fā shēng shì gù le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4db5cc23c60bd9b8f09a03ff017ae04fcf6460e28bf3f5c4c6ed20659f77e824": {
    "text": "这是个有趣的发现。",
    "pinyin": "zhè shì gè yǒu qù de fā xiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d0fa5e0aa65cf19a29dd46da9176e9dd7280e3699aa67a7efdec6f78eea277e": {
    "text": "你应该下决心锻炼身体。",
    "pinyin": "nǐ yīng gāi xià jué xīn duàn liàn shēn tǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d0b836ee9f36b539db8c9ed6e6f701c9b3dcae9d06ae4b0119d5cb0b357b474": {
    "text": "他否定自己去过那里。",
    "pinyin": "tā fǒu dìng zì jǐ qù guò nà li 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d16a603a3e1a06a9bdde8d51ca9d9839ab8c1054630bd1e9272a5c8710818b9": {
    "text": "我要修理手机。",
    "pinyin": "wǒ yào xiū lǐ shǒu jī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d5e29894563cda2ce9f5e16c431ce960e3e3aa8e83eb0747f8764fdb2aed52d": {
    "text": "镜子里有一个人。",
    "pinyin": "jìng zi lǐ yǒu yī gè rén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "4d61429fc6abadedf4873b21811bfae8864185650b8861bbb3f9437b766cb792": {
    "text": "政府发布了天气预报。",
