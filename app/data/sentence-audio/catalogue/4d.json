    "quotedReadings": []
  },
  "4dc600bbf020a8595788ac53c8ba4fb55a3835e9910cfbfecbccc879a9166309": {
    "text": "我们要依法做。",
    "pinyin": "wǒ men yào yī fǎ zuò 。",
