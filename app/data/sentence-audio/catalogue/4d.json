    "quotedReadings": []
  },
  "4de3993b4255f3f9b6959eaa2182e70d60880ec123370d619407d7541e3c427d": {
    "text": "我们写一个协议。",
    "pinyin": "wǒ men xiě yī gè xié yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
