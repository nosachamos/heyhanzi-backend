  "5915fcfaefd288d8e80d4b482af3238860ae37aeec328639c983d32974f72ef3": {
    "text": "我们要复习课文。",
    "pinyin": "wǒ men yào fù xí kè wén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59e0c6b2fb02eb111f6ebebc497fce489e1d37980883c58917f46d3978d6f4a5": {
    "text": "他想要很多自由。",
    "pinyin": "tā xiǎng yào hěn duō zì yóu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "598e8e10abbd40a789274f29dd445ddc16abc68c7c9ba49f1c062722412eb82a": {
    "text": "他学习这个学科。",
    "pinyin": "tā xué xí zhè ge xué kē 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59ad8d190ac91a97076e6d31789287b9f42de1e8eec33c9011ce9d5154b5762d": {
    "text": "外语是她的强项。",
    "pinyin": "wài yǔ shì tā de qiáng xiàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5937d78554d204c3650ef50c87bcc3f57a50afdbedb6fb234276cc9a155afab8": {
    "text": "我要去看亲戚。",
    "pinyin": "wǒ yào qù kàn qīnqi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "593b6e974c9134a1be5847774eefd1849d51ae25d6bf5876fa840c9a3bf9293e": {
    "text": "他的床非常坚硬。",
    "pinyin": "tā de chuáng fēi cháng jiān yìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5907431953b3c7c6596b97e35a5c74ff7d4bfbc00d26715319f542eb51c4c79c": {
    "text": "冬天是这里的淡季。",
    "pinyin": "dōng tiān shì zhè lǐ de dàn jì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59956dd7cc2d154293dc8c591133949026351fde804ded1338afb2ca32ef35d1": {
    "text": "他看到医生很震惊。",
