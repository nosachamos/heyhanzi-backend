    "kind": "sentence",
    "quotedReadings": []
  },
  "5909b92a57e0758a5f623e021cb50535102ba91d1f740cf645d67212a59779dc": {
    "text": "你看得懂繁体字吗？",
    "pinyin": "nǐ kàn de dǒng fán tǐ zì ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "591c969e4efa168b9116d3f3fcebc58894c79708d1353ef0a1bd2de01ec1d3de": {
    "text": "我买了这个乐队的新专辑，里面有很多我喜欢的歌。",
    "pinyin": "wǒ mǎi le zhège yuè duì de xīn zhuān jí ， lǐ miàn yǒu hěn duō wǒ xǐ huan de gē 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5919c12d37e27a46ec27d87ebb8f5dd82e71578e55c4af55656412f763b8963d": {
    "text": "医生倡导早点睡觉。",
    "pinyin": "yī shēng chàng dǎo zǎo diǎn shuì jiào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59caa8f5abf7aa360256fa2dd9dfa3dce67e85c045f7ddfd73af713353f8dd3e": {
    "text": "我看见一只蝴蝶。",
    "pinyin": "wǒ kànjiàn yī zhī húdié 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59094bd6f4699d2983b7078c36f7b74c96aa6e7d8c45df718e2a3d4ab377bb9a": {
    "text": "不要在尾气里运动。",
    "pinyin": "bù yào zài wěi qì lǐ yùn dòng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "59a61942f962cdcf6596720edf35d0a018ac3f3f5a7dac02665f1316b210fe05": {
    "text": "花园中央有一个喷泉。",
    "pinyin": "huā yuán zhōng yāng yǒu yí gè pēn quán 。",
    "kind": "sentence",
    "quotedReadings": []
