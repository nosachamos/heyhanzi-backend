{
  "5947f266182b0ea9a517dc78ae100ae0fe6f89b835b6fcc52d0dd8e4f413f348": {
    "text": "我不是他。",
    "pinyin": "wǒ bù shì tā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "590faa81e235c2261c305a769d6f6078cfe71b3b93a06250af5008f319d84b7e": {
    "text": "我们一起唱国歌。",
    "pinyin": "wǒ men yī qǐ chàng guó gē 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "593f439f8edb68ad22b60dabac99fb10174230e869c849d166f228dd286253a1": {
    "text": "你有没有中文名字？",
    "pinyin": "nǐ yǒu méi yǒu zhōng wén míng zi ？",
    "kind": "sentence",
    "quotedReadings": []
  },
