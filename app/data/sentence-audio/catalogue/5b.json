{
  "5bcbf6a0b4a76c8b372953e890c732b7161cb6d7a71535d5fd41e61206a38db4": {
    "text": "不，是我。",
    "pinyin": "bù ， shì wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b3e33bf4dde8ece287375958f485bc55defe548e50583ff2461f51a7fc2603d": {
    "text": "我没有。",
    "pinyin": "wǒ méiyǒu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b0d5977e73909500dd8106b9080f7aebb970b56b312b099462f13605695eb88": {
    "text": "我可以看看吗？",
    "pinyin": "wǒ kěyǐ kàn kan ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bf1dcb84e883f8101b20f81c7344dc0b2e6a94ea3a41db08a2397ad0e0f300f": {
    "text": "那只新生的小猫很可爱。",
    "pinyin": "nà zhǐ xīn shēng de xiǎo māo hěn kě ài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b578f965902aff53d3a3353aa6b52f0b8f114a43d9069e0d6d550235cf943a0": {
    "text": "大家都看他的所作所为。",
    "pinyin": "dà jiā dōu kàn tā de suǒ zuò suǒ wéi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b208c19e395a9ec8a70c62bde27c4088dea4db5a063f83474e1d6183ff39441": {
    "text": "他工作有出路。",
    "pinyin": "tā gōng zuò yǒu chū lù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5ba289fd95521dd04f4a5a06fb82d14043af008b7438eee60723f49ac91cadd5": {
    "text": "你休想拿到我的书。",
    "pinyin": "nǐ xiū xiǎng ná dào wǒ de shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b324f9cd3ffedb433314457483aae07095e9263cacdd2bda2d0ff3460f50128": {
    "text": "他不容别人说话。",
    "pinyin": "tā bù róng bié ren shuō huà 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bff73aa34daf5e2401ff5c40e8fb2b708d611b3f2b6d4fac90cd2458f2be132": {
    "text": "这次考试的成绩比上次好，我很高兴。",
    "pinyin": "zhè cì kǎo shì de chéng jì bǐ shàng cì hǎo ， wǒ hěn gāo xìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bd3cc085645a64d5681c8b9da26fcc91b931191a1bab34c8d23cd7fcc37ecc1": {
    "text": "邻居们在一起很和气。",
    "pinyin": "lín jū men zài yī qǐ hěn hé qi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b56bc6ebd0029e4a3fee5ec7b519f5f0b4206fe7e9c79a7187900baa785fdd3": {
    "text": "你会用筷子吃饭吗？",
    "pinyin": "nǐ huì yòng kuài zi chī fàn ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b2b4ba21d83a37a38e94925584f6f078945f7b35ff71cf3f0041c25910c7a68": {
    "text": "他决定研究医学。",
    "pinyin": "tā jué dìng yán jiū yī xué 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bd7559d3af9e03e18f4d5fc0985a4e40c24f0e329ed4bff2fd8462e128a9b4c": {
    "text": "她负责行政工作，有什么问题可以先问她。",
    "pinyin": "tā fù zé xíng zhèng gōng zuò ， yǒu shén me wèn tí kě yǐ xiān wèn tā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b77c1ec4d933242a5c78d71284afd249c88549d4502951bd2cbe2e8df9323da": {
    "text": "这个种类很少见。",
    "pinyin": "zhè ge zhǒng lèi hěn shǎo jiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5be82776eb8e1ef1c26189072beb252ffaa752bfcb944144af417e3b84810402": {
    "text": "那个商场正在促销。",
    "pinyin": "nà ge shāng chǎng zhèng zài cù xiāo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b94cbcc46565407e84c7afdabda1b830531c04f78c2808f5c1a918a81a19255": {
    "text": "我们在布置家。",
    "pinyin": "wǒ men zài bù zhì jiā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b27449518f610a7affcce9c74ff110543e6b55cb34f074e2c5a77983558da9f": {
    "text": "哈哈，没想到你会在这里遇见我。",
    "pinyin": "hā hā ， méi xiǎng dào nǐ huì zài zhè lǐ yù jiàn wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b77f6b00737b163b34897239909e92c26cf0dea03da2a7e36e0d8245bd62760": {
    "text": "我的汉语很生硬。",
    "pinyin": "wǒ de hàn yǔ hěn shēng yìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b541247e247816b8a794aa9578c257c556ff73ebca445595319e760622ee84f": {
    "text": "语言是交流的载体。",
    "pinyin": "yǔ yán shì jiāo liú de zài tǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bd031e741c4847e1a05032300a33e02a9a1269f3e91e451caf1b95aca0f5c9f": {
    "text": "那个小丑有红鼻子。",
    "pinyin": "nà ge xiǎo chǒu yǒu hóng bí zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b37403c24158bb5093a4c5a9845aa2e83eb925b94c1e44e08e787d5369a7139": {
    "text": "我们要淘汰表现差的人。",
    "pinyin": "wǒ men yào táo tài biǎo xiàn chà de rén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5bd2fc611cac3568b0c52ca48497b91ac77a62db6342013276012e9575fd79fa": {
    "text": "他发愤图强，学习汉语。",
    "pinyin": "tā fā fèn tú qiáng ， xué xí hàn yǔ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "5b344ab49fc2fb5bd173aaf1f95a2e283d72c4f52ac8a7f7830fe5d7f620f098": {
    "text": "我们先检查这里的土壤，再决定种什么。",
    "pinyin": "wǒ men xiān jiǎn chá zhè lǐ de tǔ rǎng ， zài jué dìng zhòng shén me 。",
    "kind": "sentence",
    "quotedReadings": []
  },
