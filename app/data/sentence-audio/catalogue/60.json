{
  "60bcde81a18a7160c871cfa4370bfc250e1667a74464e7364093a2a43f696456": {
    "text": "你？",
    "pinyin": "nǐ ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60ebeb6a747a14c479bde70acc6d08d3383e184540e545c7a9b27a1087446bb7": {
    "text": "那是我的。",
    "pinyin": "nà shì wǒ de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60579d976cbb090f797276864bdc1950df1b91989140cac242898f67e7da7612": {
    "text": "我在这里。",
    "pinyin": "wǒ zài zhèlǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6025b82d292e7255939af3ee638260a361d1042d3cd7964ddc7918ef87d1f487": {
    "text": "你什么时间来？",
    "pinyin": "nǐ shénme shíjiān lái ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60920fac830fff542c7eacd53fc685ba48fe49d2aad4444e16ae221ab5a45522": {
    "text": "她说：“这里的学生不少。”",
    "pinyin": "tā shuō ： “ zhèlǐ de xuéshēng bù shǎo 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60d3b73900b55876914af35242eb03a91ec61bb2443e704e5828120cb5496d45": {
    "text": "你自己来吗？",
    "pinyin": "nǐ zìjǐ lái ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "602e9fac96c3ef61a83e8696c43fbfd88b41cd331a7fcf076f9b2d24fc991c0e": {
    "text": "虽说这件衣服很贵，但我喜欢。",
    "pinyin": "suī shuō zhè jiàn yī fu hěn guì ， dàn wǒ xǐ huan 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "603ae43fbccc627bdbfd140ef512d881ed61016b4e6c871a2541d763cd40a221": {
    "text": "她说：“姐姐是个懂事的学生。”",
    "pinyin": "tā shuō ： “ jiě jie shì gè dǒng shì de xué sheng 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "604e60b0401301c158482b37e9335ead9e51f4ea61470e2ea6ddbcf8042bb656": {
    "text": "桌上的喜酒是朋友送的。",
    "pinyin": "zhuō shàng de xǐ jiǔ shì péng you sòng de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6099815aa0999c40ac2e84c69cee9e2b2b8c8546ec8d7f07e811793f0da26fef": {
    "text": "这件衣服几乎是新的。",
    "pinyin": "zhè jiàn yī fu jī hū shì xīn de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "606133fd0dc9d64adaa79a478f07277e68b21321bf35ebb1c2b305dc644a7bfe": {
    "text": "这个地图一目了然。",
    "pinyin": "zhè ge dì tú yī mù liǎo rán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60d0c9831538d98f82a63792c4d52669ea6c36ee9fb63ae8c62af1d33b5e1d4a": {
    "text": "我们性格不一样。",
    "pinyin": "wǒ men xìng gé bù yī yàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60a177da304169ad8ebd18c3b3d9d2936cca87400f28ffaf40c43114d236f8df": {
    "text": "医生指引我挂号。",
    "pinyin": "yī shēng zhǐ yǐn wǒ guà hào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60a9cd0f10558007ba42219d30b2f06ce9128c034093647de1c59961e730747a": {
    "text": "我们尊重爸爸妈妈。",
    "pinyin": "wǒ men zūn zhòng bà ba mā ma 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "609de3f65e347e9cbee2a5838f847a5ebd630834089ad4cd85626a9beb34d9b5": {
    "text": "这个孩子很活泼，一到公园就想和大家一起玩。",
    "pinyin": "zhè ge hái zi hěn huó pō ， yī dào gōng yuán jiù xiǎng hé dà jiā yī qǐ wán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60ecf44a0fa735b0bdb6c13768f1f46fc93ab3e44bdfec6061fff8bcd431e7b5": {
    "text": "你应该把计划投入实践。",
    "pinyin": "nǐ yīng gāi bǎ jì huà tóu rù shí jiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "602634a7bdcf158d851825b352469d627a48d8ebd4fb9337f0514d7216be078b": {
    "text": "大家都觉得他是个傻瓜。",
    "pinyin": "dà jiā dōu jué de tā shì gè shǎ guā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60f31efe33de365b4cc426d35c265cd37806292d69163bd56d4157c858882d40": {
    "text": "我们坐下来喝茶说闲话吧。",
    "pinyin": "wǒ men zuò xia lái hē chá shuō xián huà ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6038af162d5b31b6688ba40381785d216e8361e6c47c9c3897fbf6612c99f752": {
    "text": "老师赞扬了他的进步，他准备继续努力。",
    "pinyin": "lǎo shī zàn yáng le tā de jìn bù ， tā zhǔn bèi jì xù nǔ lì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60818257de6f43195f3a17a52134797f6ab170231ee1a11367af3b7b884b419d": {
    "text": "跳舞时要注意姿态。",
    "pinyin": "tiào wǔ shí yào zhù yì zī tài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60cda4fc2d2f43c777cb08e56741fcc1233f559228d22bac1e4afbe4506522e4": {
    "text": "她跑得如同兔子一样快。",
    "pinyin": "tā pǎo de rú tóng tù zi yī yàng kuài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60932b408f1ee966fc924af5b373e896259eca06517527b097917f9a2724c759": {
    "text": "河边长着修长的竹子。",
    "pinyin": "hé biān zhǎng zhe xiū cháng de zhú zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60efde1dee68d612520e2170019861f2bae6a0e2f14b0e090136863ce05d8623": {
    "text": "他在大学攻读汉语。",
    "pinyin": "tā zài dà xué gōng dú hàn yǔ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60738b7838bcc82d4572c2babee38545bf47285f606f21a54ee9effd3cae6173": {
    "text": "他是这行的前辈。",
    "pinyin": "tā shì zhè háng de qián bèi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60ecaaa4ba7be20ca0396f80f55e58dea618c5197fc954fe1bfc8a626d23241a": {
    "text": "小宝宝诞生了。",
    "pinyin": "xiǎo bǎo bao dàn shēng le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60b12df92e1a35e3dcb5308ae4b4acbabb0b94ed4fc3775354008ae5cd8d7103": {
    "text": "父母准备的嫁妆不多，但她很珍惜。",
    "pinyin": "fù mǔ zhǔn bèi de jià zhuang bù duō ， dàn tā hěn zhēn xī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "60c5a79cb2f1a09306c3ea7ef25de3133444e1d4c6422210b19ace7bb702d223": {
    "text": "这个做法合乎规矩。",
    "pinyin": "zhè gè zuò fǎ hé hū guī ju 。",
    "kind": "sentence",
    "quotedReadings": []
  },
