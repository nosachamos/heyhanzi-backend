{
  "6c11ebddd2ab4bf4ff8237250998204dc09a983818895ec7c60bf8c55a3626b7": {
    "text": "是。",
    "pinyin": "shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c7c214082c155c622ff1541348ed75457b272df57fe05bf030d2baa6ce84f31": {
    "text": "你和他好吗？",
    "pinyin": "nǐ hé tā hǎo ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cf1e5d7a871d47c4b4737cc40c737ef63d79d7e0c2b3e6524bb0c3dec4ff7d0": {
    "text": "他特意去学校看我。",
    "pinyin": "tā tè yì qù xué xiào kàn wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c5b762c03b20763a9c0928629ce404b637961adf49696338accbf42fce3c063": {
    "text": "他从东南方向走过来了。",
    "pinyin": "tā cóng dōng nán fāng xiàng zǒu guò lái le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6ceb170dde3817a337307d140953f629cc8b302fb4b623c1eb45143a1cc9b2c6": {
    "text": "我们要演练跳舞。",
    "pinyin": "wǒ men yào yǎn liàn tiào wǔ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c5cc61b462de7278399789cbb817c82e24e45017c81e06b309de1e7b3a2dab3": {
    "text": "请照顾好自己。",
    "pinyin": "qǐng zhào gu hǎo zì jǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c345a67f24c2edb5522eca26b11eeeb5bf9ed86bb5e7f135cac733d0b910420": {
    "text": "我想尝试做这个菜，你能告诉我怎么做吗？",
    "pinyin": "wǒ xiǎng cháng shì zuò zhè ge cài ， nǐ néng gào su wǒ zěn me zuò ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cd3c212292323c88fe48b270726c585d48af303b25ccfed5f797aa23799f9c7": {
    "text": "他们正在参加国际会议。",
    "pinyin": "tā men zhèng zài cān jiā guó jì huì yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c172786872afeeab4e8534fa023052d1ab120d68cee348a241a12dec82ff621": {
    "text": "他甚至不喝水。",
    "pinyin": "tā shèn zhì bù hē shuǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c79537f47b0a03f9d38a863348e83dc3c2902b531cab6c4c7bb17b8bf05cb63": {
    "text": "她头发上戴着一个卡子。",
    "pinyin": "tā tóu fa shàng dài zhe yī gè qiǎ zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c171f253f10dc615d73ee784959180718775a32ba3498095ada5fb97bb4d2dd": {
    "text": "白领生活很忙。",
    "pinyin": "bái lǐng shēng huó hěn máng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cc527a3ac66b9705a624db28dd66fa33b02f1414afcf585695fac72b5900a34": {
    "text": "妈妈培养我的兴趣。",
    "pinyin": "mā ma péi yǎng wǒ de xìng qù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cecda2e1270a352d03ba4090f2dc384f3e4d45177ed74ff3ba5903ac3c10148": {
    "text": "这附近的房价涨了。",
    "pinyin": "zhè fù jìn de fáng jià zhǎng le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cd3eeb7362326c3120d0af58ae2cae8e934561cfe7f862ad9acaaa7221c2b64": {
    "text": "妈妈处置了午饭。",
    "pinyin": "mā ma chǔ zhì le wǔ fàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cf949dfcb293089bd566f9490e4ef1cb0b17e8cce009ec2dee8ea8bc4e9cf56": {
    "text": "家是每个人最好的后盾。",
    "pinyin": "jiā shì měi gè rén zuì hǎo de hòu dùn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6ccc465619cba3b752fd20ef14ca4830277c48232e1f88017c335d2784a0942c": {
    "text": "他把衣服拿去晒太阳。",
    "pinyin": "tā bǎ yī fu ná qù shài tài yáng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c7f7b89256cb4a8dc93bce5a4a76fe74a85390f316e6089580bddbdbb0dbac6": {
    "text": "她笑起来犹如花儿。",
    "pinyin": "tā xiào qǐ lai yóu rú huā r 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6ce7e658906db30ee4daaeccfa1d37e36a3a402637449bfbf15452439273600f": {
    "text": "他在桃树下看书。",
    "pinyin": "tā zài táo shù xià kàn shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6cf0a127694140c1a8cdf8c49fccd9cdb34e15c490c53d48fa21877cb9a515ad": {
    "text": "他们启动了新项目。",
    "pinyin": "tā men qǐ dòng le xīn xiàng mù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c9368b97d1f14a816230275f8e38231f3905742b5d0b3c6a5ddf87ac0bde5b3": {
    "text": "别摆动你的腿。",
    "pinyin": "bié bǎi dòng nǐ de tuǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "6c2b4a4a0a46bb88b6be44793b7000a1d9d571d6b156adf1f7f7408d127ac1da": {
    "text": "这个画蛇添足了。",
