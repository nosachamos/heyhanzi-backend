  "76aec992f9198ef832e17ff2e4dfd8d06b8b86a6b2cc1d0a57c3c8d083c10604": {
    "text": "飞机开始航行了。",
    "pinyin": "fēi jī kāi shǐ háng xíng le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76d2b4b9230257b586b25933b644d0be6833df191921fd821e57549627d2e29f": {
    "text": "我们公司主要出口茶叶。",
    "pinyin": "wǒ men gōng sī zhǔ yào chū kǒu chá yè 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76d9162898ee496e0ecec648e9bea16f94f0efca1e90a9cf92e20116015ca66d": {
    "text": "妹妹看到小猫受伤，伤心地流泪了。",
    "pinyin": "mèi mei kàn dào xiǎo māo shòu shāng ， shāng xīn de liú lèi le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "769bae41edd7ce0de0422753a6ccb87b71166b79e2688a9fc1a5dedbdc36058f": {
    "text": "听到消息他冷战。",
    "pinyin": "tīng dào xiāo xi tā lěng zhàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76da12902079e6ec869727c4f9be0766c0d60c1bb6f6597cbd07aaca4ca9d8bc": {
    "text": "他对汉语有浓厚的兴趣。",
    "pinyin": "tā duì hàn yǔ yǒu nóng hòu de xìng qù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76cd1f0603012e80b1f02a0d53a696028e21f386f2663c3e6c4bce650228f963": {
    "text": "医生无偿为我们看病。",
