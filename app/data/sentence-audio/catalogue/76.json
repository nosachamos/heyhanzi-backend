{
  "769e038cda8c15467e7d442532d7d83b8fdf3b8233c1431d9d48ac198f799958": {
    "text": "我再看看。",
    "pinyin": "wǒ zài kàn kan 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "769acb149c4f810dd11aab1cdb6d7fbe52b80721600e974f9e60f8419f5081a7": {
    "text": "她是我的姐姐。",
    "pinyin": "tā shì wǒ de jiějie 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76774638d6e14dd09913e506fed04f579d6d2b37b35985c5375847821a770ea7": {
    "text": "请按时到学校，我在门口等你。",
    "pinyin": "qǐng àn shí dào xué xiào ， wǒ zài mén kǒu děng nǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "76dc6d275e57b65ae0da763666040aa5b6d467da30c27ad9ca0c083a2339c822": {
    "text": "她的存在很重要。",
    "pinyin": "tā de cún zài hěn zhòng yào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "768319514bec58748d48a30e6af24599471780b48821ccc0114a93f93a18eff5": {
    "text": "他一直鼓动我参加比赛。",
    "pinyin": "tā yī zhí gǔ dòng wǒ cān jiā bǐ sài 。",
    "kind": "sentence",
