{
  "77941943d02bd84355f301f99d192f90cb49fcfe4e4917f089ba76345cca82cc": {
    "text": "他不在。",
    "pinyin": "tā bù zài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77f86f611796c98336176a68f7eb5545f64a2b86997173ab562edfedd7c8c03b": {
    "text": "他去外边学习了。",
    "pinyin": "tā qù wàibian xuéxí le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "7715ffbc7afdff213dc169b0916d132c982175e3e4bce8cdb12e874094cdac0c": {
    "text": "妈妈现在上班。",
    "pinyin": "mā ma xiàn zài shàng bān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77ae54e08fa06effec1a29e61a4611e42a16901e13e627d973be7ebe48a699cf": {
    "text": "她说：“我想吃火腿和面包。”",
    "pinyin": "tā shuō ： “ wǒ xiǎng chī huǒ tuǐ hé miàn bāo 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "773226f236743a716b0ad55c2c948e6f8bdf24c21baf32b1050c7fb864fdc9ab": {
    "text": "请把网址发给我。",
    "pinyin": "qǐng bǎ wǎng zhǐ fā gěi wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "7739709febddd33e42f902d6d7179669ac220121c00c0912217d2efece260875": {
    "text": "请把名字反过来写。",
    "pinyin": "qǐng bǎ míng zi fǎn guo lái xiě 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "770c24caf2a2670924de3ae635fa735c295a6291564682cf5a5293ea3aa127a4": {
    "text": "我家距离学校不远。",
    "pinyin": "wǒ jiā jù lí xué xiào bù yuǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "773cc22d7b8a6e32d2d0b8df92748ae4fa02bd21f66816cfffd3518164cd3df4": {
    "text": "我的家杂乱无章。",
    "pinyin": "wǒ de jiā zá luàn wú zhāng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77f4fc7f2880e8bcade2fbc50814fcd6243e48f581398afd165bc8224f7719b4": {
    "text": "我对这本书很熟悉。",
    "pinyin": "wǒ duì zhè běn shū hěn shú xī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77bdb5b7dcc5a2b25d325b8820baf4604981782ad86b97c07f2c0a574cd9ffa0": {
    "text": "我想订购这个苹果。",
    "pinyin": "wǒ xiǎng dìng gòu zhè ge píng guǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77c83d9dfd7ea4ec77b9d3ed568c456a373956f1409363cbe4a63bbbb4f9df3c": {
    "text": "他看到细微的字。",
    "pinyin": "tā kàn dào xì wēi de zì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77067cf5ed1ed703831b3bfc684aa894dc87e0172622e59ac2465c3fc6a49a9c": {
    "text": "他在打乒乓球。",
    "pinyin": "tā zài dǎ pīngpāngqiú 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "770769c7d6c7e2db46ab4534e8ebe22f8e20a9b8020c11fa8e933fddfc26fee2": {
    "text": "水是茶的要素。",
    "pinyin": "shuǐ shì chá de yào sù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77824d2d62e649eccbbeb37f321ad1cdd9070a794d3fab3e047eeb574295585f": {
    "text": "由于他在比赛中表现抢眼，很快被教练选中了。",
    "pinyin": "yóu yú tā zài bǐ sài zhōng biǎo xiàn qiǎng yǎn ， hěn kuài bèi jiào liàn xuǎn zhòng le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77c3dd6d8879595168d9d1cc9b5a629ca81da32da74dde2004e9968492b632d0": {
    "text": "盘子里有一些豆子。",
    "pinyin": "pán zi lǐ yǒu yī xiē dòu zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "77b50814a68d63e3b828da2373ab9332368b3c0e1e1245189705a551dd5d6f4c": {
    "text": "不要轻易相信陌生人的话。",
