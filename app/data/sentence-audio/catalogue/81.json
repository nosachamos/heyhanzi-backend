{
  "81f9f0c0fee9e115f07f0365491910e7ea218d67e74c96b3d0a86c2d7124a678": {
    "text": "他在叫我。",
    "pinyin": "tā zài jiào wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "813c6623f7089929feb3f0bdb3d59ed0f2567b4433d3a1b42132936281cbb9a9": {
    "text": "她说：“他是认真的吗？”",
    "pinyin": "tā shuō ： “ tā shì rèn zhēn de ma ？ ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "819a85532289614a05bdfcc6c8c53d7682f860e886394ff5babd96bd345722e8": {
    "text": "他卖书。",
    "pinyin": "tā mài shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "8179c71cb578a5d038702d63c4ed8189f10573d745527163c69ee1d73e558e7a": {
    "text": "我说：“他的哥哥在中学读书。”",
    "pinyin": "wǒ shuō ： “ tā de gē ge zài zhōng xué dú shū 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81c0b11730cc4ecb269c42446d822a474fac7e9c506c29ccf5fc855a2b650c97": {
    "text": "你的手不要运动。",
    "pinyin": "nǐ de shǒu bù yào yùn dòng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "8102838fc7d45218834ffaf37d41874d1229fce07d23d68b625b8bc2b5d9ed70": {
    "text": "杯子在桌子右边。",
    "pinyin": "bēi zi zài zhuō zi yòu bian 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "812c011bb21c0120434e3a4700979ee5e470edd9e5a4013179d5b78540a42de1": {
    "text": "他很好，不用说。",
    "pinyin": "tā hěn hǎo ， bù yòng shuō 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81b58a0a4da24cd15200f0def5ca66d5f17d1b479c32ac9d1ca56f31e1dd6676": {
    "text": "我还不太清楚这件事的影响，想听你的看法。",
    "pinyin": "wǒ hái bù tài qīng chu zhè jiàn shì de yǐng xiǎng ， xiǎng tīng nǐ de kàn fǎ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81dd666e7640f8056d0e31b007bb4b6f26a637cc13c1234d3c870f9f75e364e6": {
    "text": "这样做可以节能。",
    "pinyin": "zhè yàng zuò kě yǐ jié néng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "8178eec1b5aa924a8ebeb9b1900d0d95c37a36f40a2688d6e119f0005e3b24bb": {
    "text": "这里的山路非常不平。",
    "pinyin": "zhè lǐ de shān lù fēi cháng bù píng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "815de805d974eb549075ed1765ec0ac86c8e41e67fbb97ab5a625664b537e37f": {
    "text": "这个角色到故事最后才出场，可是大家都很喜欢他。",
    "pinyin": "zhège jué sè dào gù shi zuì hòu cái chū chǎng ， kěshì dàjiā dōu hěn xǐ huan tā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81f130b0a79c5e88310be417843e78213f47b7123db22188a00e835a035e35c6": {
    "text": "论文写完了吗？",
    "pinyin": "lùn wén xiě wán le ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "8187121a33292e84bfa57b2d6d9f48ed5f2095a7a6d38ce770afd219e50d4d33": {
    "text": "妈妈用南瓜做了一些汤。",
    "pinyin": "mā ma yòng nán guā zuò le yī xiē tāng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81773ae89a7e54cea5871dad9cdd4f7b8c80330299eba1461dfd3411fbb34047": {
    "text": "嗯，你说吧。",
    "pinyin": "ǹg ， nǐ shuō ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81ea358a4bff996cf9e305601853b82470bf85c4bdb47fa48a3c30e92157786e": {
    "text": "医生表扬他身体好。",
    "pinyin": "yī shēng biǎo yáng tā shēn tǐ hǎo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "816435950b862b0a1e16de1884a4aeb0025932e59e24b41ce43902ea4e130266": {
    "text": "我们的方法稳健。",
    "pinyin": "wǒ men de fāng fǎ wěn jiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "8195ead31a82b761d7fbc284d86138375f0b43979c7f7707377a2a910c1f5000": {
    "text": "他在门口张贴通知。",
    "pinyin": "tā zài mén kǒu zhāng tiē tōng zhī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81e3ab9260024bee1bc4f4c7fff4d746abed1c74b2c27997c183a33404c978b8": {
    "text": "你的劝说没意思。",
    "pinyin": "nǐ de quàn shuō méi yì si 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "816bf309d3f8de58d8a0c2cab182aef945fa9b0f4920cd6f6755d6b6a1a17190": {
    "text": "请用苹果替代梨。",
    "pinyin": "qǐng yòng píng guǒ tì dài lí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "815294cc6a330aa4026f0785a0dceff4928a913617c31a7140bbf1952b5ae988": {
    "text": "这种液体需要浓缩。",
    "pinyin": "zhè zhǒng yè tǐ xū yào nóng suō 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "81b0e217bc01322017316ab4140e2452fa318e1893cfdb524628d6478d5afc8a": {
    "text": "黑暗让他感到恐惧。",
    "pinyin": "hēi àn ràng tā gǎn dào kǒng jù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
