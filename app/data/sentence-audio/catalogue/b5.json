{
  "b5425eaebd677eec853d9bb46970e99e0f1e7e69675e4c89acac50dd165e7ad4": {
    "text": "他是老人。",
    "pinyin": "tā shì lǎo rén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b55f3ea8ae64d35dbe824c5e7cd50e023af93f6b82e20a4334295d6633b0e0aa": {
    "text": "你有车吗？",
    "pinyin": "nǐ yǒu chē ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b5962ad101f2e6b12f9460f3c983b890f2a55ea7ad8c713619be512ba9443a40": {
    "text": "老师叫我来。",
    "pinyin": "lǎo shī jiào wǒ lái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b558efcde574fe665063da4de59569cb65e86f26661c12625e23f090f41ca87a": {
    "text": "我明天要告别了。",
    "pinyin": "wǒ míng tiān yào gào bié le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b56d489e8b34012fb3da3e78d46589abc4f60cd96cd4a87909a6a57eadecc198": {
    "text": "爸爸在书房看报纸。",
    "pinyin": "bà ba zài shū fáng kàn bào zhǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b5a681aad90a1880220a3a34fa53bbf83001eed38ddedfbedf3734b25780e9b9": {
    "text": "听说明天那两口子要搬家。",
    "pinyin": "tīng shuō míng tiān nà liǎng kǒu zi yào bān jiā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b5bdbcc4f025e0b3e2e7a7945410837f92518ac2e5878aa81fc7b568a2f2a065": {
    "text": "把这两张桌子拉开。",
    "pinyin": "bǎ zhè liǎng zhāng zhuō zi lā kāi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b52e25819596fdc84bc9ff6a214dc299dd5b6e0bb0ea72f267b2f8676329c2f3": {
    "text": "我们要改正过失。",
    "pinyin": "wǒ men yào gǎi zhèng guò shī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b518fa3c7735508561caec81ecb11b0e9ab62401612799b60cdb1c1ea5f6dc74": {
    "text": "科学家研究杂交技术。",
