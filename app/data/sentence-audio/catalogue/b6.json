{
  "b67041c87fc6195feedf80aa6db6d119bfd9f0badfea998fb18c9f06f29b429c": {
    "text": "我和你都学中文。",
    "pinyin": "wǒ hé nǐ dōu xué Zhōngwén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b61dc0048ebaefbe4c488f1bcb18645f822108087b2185153237fc23a2cb3dc0": {
    "text": "他住在我家。",
    "pinyin": "tā zhù zài wǒ jiā 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b63e83475b27d04751416d3ab427822d06a07e5092bf9930a88dc0abf3805455": {
    "text": "给我一块。",
    "pinyin": "gěi wǒ yī kuài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b63d5fc4936fc8d06830dfc135f3beaa20c68e002ee8184959a4a1f9d1bb764c": {
    "text": "你还认识我吗？",
    "pinyin": "nǐ hái rèn shi wǒ ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b67b27f1f70c443e0b713615d3a3c3ae150e8e960f6441b66e6db3a79f3d8031": {
    "text": "她说：“妈妈去买鸡蛋了。”",
    "pinyin": "tā shuō ： “ mā ma qù mǎi jī dàn le 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6aa8ba22ef115255a625235572262b6ea002adef29cb52b09330b0213dca007": {
    "text": "他在楼头看书。",
    "pinyin": "tā zài lóu tóu kàn shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6d6f775d4abb14917bb339b8844a2ee5037c82656ac5b0bb3d737885177ba9a": {
    "text": "她关上书，开始思考问题。",
    "pinyin": "tā guān shàng shū ， kāi shǐ sī kǎo wèn tí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6f9368bd47c62909fbcb255f452d056ac07d6b4134c876718d82f0a3439f43c": {
    "text": "我一边听歌一边看歌词。",
    "pinyin": "wǒ yī biān tīng gē yī biān kàn gē cí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b65bfcf658f5f27d6a1844512b4d03e398115fc7c66036d3c53b8ba558120624": {
    "text": "谁假冒了我的名字？",
    "pinyin": "shéi jiǎ mào le wǒ de míng zi ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b643a6514666ffcb115fdd20be5ffc5f6980347780971777952491cc7df7833c": {
    "text": "这是一对父女。",
    "pinyin": "zhè shì yī duì fù nǚ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6aff13d9dc199fdd400594b9a5f2116683cdc1dc98d054b668ee202c0da2343": {
    "text": "他感受到了亲情。",
    "pinyin": "tā gǎn shòu dào le qīn qíng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b639ee57fa79fdb21c4c00878cf0d13f957a36fcc53d09698d67c054224f3bd3": {
    "text": "老师帮助我走出困境。",
    "pinyin": "lǎo shī bāng zhù wǒ zǒu chū kùn jìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6e2e00c2aaeee21eb349b768d553b98bcdf16964a51a40cf276f0e1577d7ac1": {
    "text": "妈妈陪同我去看医生。",
    "pinyin": "mā ma péi tóng wǒ qù kàn yī shēng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b64e663771ff2d6a7c4934c7321348808ef87333d130166c713a3f444510d8e2": {
    "text": "我用望远镜看月亮。",
    "pinyin": "wǒ yòng wàng yuǎn jìng kàn yuè liang 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b615b9d502450423cabc464e83203bc98f0e28634a88353a5c039de18785c2b0": {
    "text": "要不是堵车，我们就准时到了。",
    "pinyin": "yào bu shì dǔ chē ， wǒ men jiù zhǔn shí dào le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6e187c91fb041aba4598e1c3eee2350d0d5840278d20d67e0040f18589a859f": {
    "text": "简单词语构成句子。",
    "pinyin": "jiǎn dān cí yǔ gòu chéng jù zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6d5fee12ab87f1a53790d1ca4b5106ed21a8f3cb85549476df0105f8cee2317": {
    "text": "谁承办这个工作？",
    "pinyin": "shéi chéng bàn zhè ge gōng zuò ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b69009e04ea4a4aa5d65b68f2479b4f4b75cb3e872f3469bb106e485c83c1cad": {
    "text": "建筑的结构非常复杂。",
    "pinyin": "jiàn zhù de jié gòu fēi cháng fù zá 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b63aaa1a1ac1227e168541b75b6eab7d92e8ab88e1f3c0682139bb243426221b": {
    "text": "你可以上网查询时间。",
    "pinyin": "nǐ kě yǐ shàng wǎng chá xún shí jiān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b643acfbe15799fc9298a5ea8f76a4135e46a88d65f597b7ffc37829dbbfab0c": {
    "text": "他们准备进行会诊。",
    "pinyin": "tā men zhǔn bèi jìn xíng huì zhěn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6718119a22d98b55f2da7841f56c1dd93a8b6c63c77c83d47a199c33efe8e56": {
    "text": "这本书可以转载吗？",
    "pinyin": "zhè běn shū kě yǐ zhuǎn zǎi ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b666f65a3fec66e2b036185905c1d00e6b84d7fa81cecd0def3f5644f077ac76": {
    "text": "我可以买两个茄子吗？",
    "pinyin": "wǒ kě yǐ mǎi liǎng gè qié zi ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b68673d7489043d8e09b40e07185472c3edaddd0020f5b3bf123f40bb2deeef0": {
    "text": "银行上调了贷款利率。",
    "pinyin": "yín háng shàng tiáo le dài kuǎn lì lǜ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b68f098a390ba047a8513ebc2bae88bfe54ff92d589e0d9fd9193d3fbe73b455": {
    "text": "我们的比赛到此截止。",
    "pinyin": "wǒ men de bǐ sài dào cǐ jié zhǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6f5408b5cf8f7d47a29d49ddacb60d78a02b39b8b8a3143e691b2128cf9b258": {
    "text": "他成功扭转了失败。",
    "pinyin": "tā chéng gōng niǔ zhuǎn le shī bài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "b6eccf098fe61c1edf3050e9c292ace3a798b72d343d181fcbcdf134617e3254": {
    "text": "大批观众涌入体育馆。",
    "pinyin": "dà pī guān zhòng yǒng rù tǐ yù guǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
