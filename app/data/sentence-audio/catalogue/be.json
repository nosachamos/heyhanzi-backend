    "kind": "sentence",
    "quotedReadings": []
  },
  "beff0a56f9fc3eb0b2e7bdd0712df06a5645742defd1b60163c2965ba5748c38": {
    "text": "警察向路人敬礼。",
    "pinyin": "jǐng chá xiàng lù rén jìng lǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be279bd54ad5dabbee54957ef6e2f37987556ca0f411b84834913d845b6427bc": {
