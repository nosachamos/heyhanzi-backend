{
  "beff565fe371601803e4c77475e7b1d7ed5f28c1c728e6c4751656866fdcd05b": {
    "text": "你能给我看吗？",
    "pinyin": "nǐ néng gěi wǒ kàn ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "becc225aed793b12fc6b6d740270b1d5ff882a418d45fa2da1f3206ef53a402a": {
    "text": "这些工人都在工作。",
    "pinyin": "zhè xiē gōng rén dōu zài gōng zuò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be4e42496332f804afcfb8b4ad48d8290ec9d7da01bb51791987e8df78cbc7a4": {
    "text": "你怎么这么早来？",
    "pinyin": "nǐ zěn me zhè me zǎo lái ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be4b3d8aa2a2c49aa8cf0dbf0364cc2d8d74aa37d38790539df281043e23ba81": {
    "text": "这个孩子唱歌有天分。",
    "pinyin": "zhè ge hái zi chàng gē yǒu tiān fèn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be92745655f15e8a4a24127eeb951511213364dbfa8efd827596f2005b27134c": {
    "text": "那个男士在买电影票。",
    "pinyin": "nà ge nán shì zài mǎi diàn yǐng piào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be08827fc882488df8fb291aa043de09c531dbc7416857441719d2c440803fc8": {
    "text": "慢车虽然慢，但是很便宜。",
    "pinyin": "màn chē suī rán màn ， dàn shì hěn pián yi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be1e0d5b3f6fbeb5a486f652013b5b5bf082dd932351fbf970e94a065cb4c60e": {
    "text": "他从小就是个天才。",
    "pinyin": "tā cóng xiǎo jiù shì gè tiān cái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be9e573f6c14822eb1af2a529da24365bf7aa59a6afac3fd04b98ab2ac3a9213": {
    "text": "你要去哪里健美？",
    "pinyin": "nǐ yào qù nǎ lǐ jiàn měi ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "bed46ce050600556a477875bbf864192bbdba446380a76362a5ff81ad91bf68d": {
    "text": "我们队的五个人都想参加比赛，现在一起准备。",
    "pinyin": "wǒ men duì de wǔ ge rén dōu xiǎng cān jiā bǐ sài ， xiànzài yìqǐ zhǔnbèi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "beca83c3e23b18d3c61c31306d5638097d4bca635bdeeb9a2e1f7a06eb7811a5": {
    "text": "公司要求提高指标。",
    "pinyin": "gōng sī yāo qiú tí gāo zhǐ biāo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be95a4f6a6c84def62b21edc295c4dcc48a7a23c1fdedec01b5a65a79a98b4d3": {
    "text": "我的头痛得厉害。",
    "pinyin": "wǒ de tóu tòng de lì hai 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be3dbdd377a34067e121d59d16cfb1430341e7f0447f89d65f30503f22466620": {
    "text": "她说：“为了确保安全，请戴上帽子。”",
    "pinyin": "tā shuō ： “ wèi le què bǎo ān quán ， qǐng dài shàng mào zi 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be7171ab202605b12b0241ce078dfee3666aa2431dc6483490ba950dce8a728c": {
    "text": "做人要讲诚信。",
    "pinyin": "zuò rén yào jiǎng chéng xìn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "be536fa6a5246ab55eb2f1fbc64965080e346d02d903ef583c1398993b6ed7f4": {
    "text": "天文课说巨星很热。",
