{
  "d93a972296180f412b505c23bd44fa33f0cef187f4351ecbf6b44e717260f2c0": {
    "text": "她还有知觉。",
    "pinyin": "tā hái yǒu zhī jué 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9a4d16d044e9cafccba8669bb6ccc246589e249aa70e247d386959dbbcf5550": {
    "text": "他几点回来？",
    "pinyin": "tā jǐ diǎn huí lai ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d987fe8963b1548ef02ee31e5661a401ded73026fa11d18d6b14c0bb2c2ca2ec": {
    "text": "他生气地走开了。",
    "pinyin": "tā shēng qì de zǒu kāi le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9efb1e0e6afb908709e007fc18af5529078f49713104c401e62dfa5f5dec3d6": {
    "text": "飞机在机场吗？",
    "pinyin": "fēi jī zài jī chǎng ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d93e113d3beb1afd631802402f91bc0cecb996b914dbf0854bf59912f46206af": {
    "text": "他不想跟他交朋友。",
    "pinyin": "tā bù xiǎng gēn tā jiāo péng you 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d98d79d911513f0ceb2e46f41dfd6a033a7d13a9bd10a646175c8ebacaa805ca": {
    "text": "天气有很大的影响。",
    "pinyin": "tiān qì yǒu hěn dà de yǐng xiǎng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9ddb299fa969e38775eb6b5bb04e731926bde4a797c5a19b105b2d7aa484141": {
    "text": "这个声音很响亮。",
    "pinyin": "zhè ge shēng yīn hěn xiǎng liàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d98947df2c1bfed88d696eb8f20253f3dcab29cec3db5ce9be77c13c6e055ace": {
    "text": "他在学校很高调。",
    "pinyin": "tā zài xué xiào hěn gāo diào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d955a75e186843f2c7e65d49822cf7c57635110235b9f96e7eb414b6a31dbee9": {
    "text": "他每天都无所事事。",
    "pinyin": "tā měi tiān dōu wú suǒ shì shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9301c5433014687c752838fcdebb82dcfb0aead9f4d0dd4bbbd8c3dde1175e8": {
    "text": "心情取决于天气。",
    "pinyin": "xīn qíng qǔ jué yú tiān qì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9be2e3648baa49940e9b8ed2b53d26fad9938ef1d657f948f5b3e68769fbdbf": {
    "text": "不要低估这件小事。",
    "pinyin": "bù yào dī gū zhè jiàn xiǎo shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d97b106eaef513bd4b09aceff5bc26c3c27ebb6f77add7b70cd7c8caed48af25": {
    "text": "他站在门的背面。",
    "pinyin": "tā zhàn zài mén de bèi miàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9347d90c20a0470dc517eeea1555b42ab44cc6f6d3c67b40d241ec3c924a7b0": {
    "text": "这位翻译听得很认真，然后用中文向我们解释。",
    "pinyin": "zhè wèi fān yì tīng de hěn rèn zhēn ， rán hòu yòng zhōng wén xiàng wǒ men jiě shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9a907bb800145d49944005058905f79ff3bda7f24666218fbd6e80a9e51f0b7": {
    "text": "外面太阳很大，出去以前记得戴帽子。",
    "pinyin": "wài miàn tài yáng hěn dà ， chū qù yǐ qián jì de dài mào zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d942fd7f42d054ba678d123159b5a407d2c240bd7e8a6eb958f422d4e4bcc239": {
    "text": "她说：“这层楼的楼梯非常窄。”",
    "pinyin": "tā shuō ： “ zhè céng lóu de lóu tī fēi cháng zhǎi 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9a1d4c4d6c4f476d46c2f31064a2f8a5edee109e1af9bcea57e79b936a31bb6": {
    "text": "看，他在中央。",
    "pinyin": "kàn ， tā zài zhōng yāng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9b45ba27ef57c8d62f02151644a37deca1dce13f284d3a8ca4baaff256b6c62": {
    "text": "该品牌拥有庞大的连锁网络。",
    "pinyin": "gāi pǐn pái yōng yǒu páng dà de lián suǒ wǎng luò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d99628d7ba6056b2086bdbcd709e365ce594affa3406ad54a94cd5a6de463120": {
    "text": "我们走过那座桥梁。",
    "pinyin": "wǒ men zǒu guò nà zuò qiáo liáng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9c4e623219eaeaa32da888e469d986b2974010a0c3c40573f165515d3682c63": {
    "text": "早晨的阳光非常明朗。",
    "pinyin": "zǎo chén de yáng guāng fēi cháng míng lǎng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "d9280079e663eb75dc0a18bfe9dd99d45ab35ed9c858ea257ba229e1db79e24f": {
    "text": "每天做同样的事情太枯燥了。",
    "pinyin": "měi tiān zuò tóng yàng de shì qing tài kū zào le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
