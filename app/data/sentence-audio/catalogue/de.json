    "kind": "word-practice"
  },
  "de8b3b09604c4edfd997b9497bfe2728f54e50827d63e70535b00039a035449a": {
    "text": "勉强。",
    "pinyin": "miǎnqiǎng",
    "kind": "word-practice"
  },
  "de6c7d6fcb404272fe71bb890e44aac9a2ffa7c32543a4e2a60af1b94fb14e43": {
    "text": "报刊。",
    "pinyin": "bàokān",
    "kind": "word-practice"
  },
  "de0b3ce9bbcee36af6c652221fa7f73f7ee25812bb79129de82e0492dd88a23c": {
    "text": "产出。",
    "pinyin": "chǎnchū",
    "kind": "word-practice"
  },
  "de81c163348cb1491340e5c58228c34a85b4ff4506af2e4a0ee7f6add45a7285": {
    "text": "急诊。",
    "pinyin": "jízhěn",
    "kind": "word-practice"
  },
  "de5e74fcdece54598ad3d0fa8a1b4b8e57c2e00934371afb258ee0fbe62c0b12": {
    "text": "影星。",
    "pinyin": "yǐng xīng",
    "kind": "word-practice"
  },
  "de6fec01912533a867dc493929c86a866b8a49520887706b846c63ff53079ed0": {
    "text": "早就。",
