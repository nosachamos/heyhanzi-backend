    "kind": "word-practice"
  },
  "def4534d4565781f4f7f083bf09b2e8bd7df0655d3af886bbe4339be97a06faa": {
    "text": "冲刺。",
    "pinyin": "chōng cì",
    "kind": "word-practice"
  },
  "de339d9c23870df48bc488d19024658fc20040613f97be1cc656323e4741665b": {
    "text": "并行。",
    "pinyin": "bìng xíng",
    "kind": "word-practice"
  }
