    "pinyin": "huáng dì fēng tā wèi gōng chén 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de2eeefcb20abadd2cd24f6de1823ce19a0b537f2720e467eac4f1f84c1dee0a": {
