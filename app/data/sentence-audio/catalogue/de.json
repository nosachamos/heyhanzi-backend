{
  "de3014040972769d714877fd732500254d55c4508dbf5d95db762ce45f211b97": {
    "text": "我给你。",
    "pinyin": "wǒ gěi nǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de03534a748dd6117cf05571752fe06c35692b1e607f7838ab01fd6ccb968b70": {
    "text": "你看一下。",
    "pinyin": "nǐ kàn yíxià 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de9a46576cfb27545aff93ef4a3a1809430a4da4eb662ed79a73333bb5a6edb7": {
    "text": "他现在会说中文了。",
    "pinyin": "tā xiànzài huì shuō Zhōngwén le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de6a7755e863c897d7a6d02f4e960e4dd2ba7000d7aaa2b904fa7c33bd10a0aa": {
    "text": "这只狗很可爱。",
    "pinyin": "zhè zhī gǒu hěn kě'ài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de58ec7aa7a0654c1ff00a2c63e4cbf07ba85a26479fff1ca62ac1757232c4a8": {
    "text": "你喜欢吃什么水果？",
    "pinyin": "nǐ xǐ huan chī shén me shuǐ guǒ ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de3abe82be53046676f0c9bd9317447b714e006b8db9be6a7f9b08653106c0a4": {
    "text": "他从前是我的同学。",
    "pinyin": "tā cóng qián shì wǒ de tóng xué 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de29fd6209e13fa9b7473de7e6b99139703746039d6c7f0cde9efa57650cf808": {
    "text": "他笑起来了。",
    "pinyin": "tā xiào qǐ lai le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de6dc3b7be041abf57a36aebc6461ac539a9cfd5addff546b59ec84f1f653be0": {
    "text": "你怎么能这样跟老师说话？这太不像话了。",
    "pinyin": "nǐ zěn me néng zhè yàng gēn lǎo shī shuō huà ？ zhè tài bù xiàng huà le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de4dff01273bf45b83532a463b5c045f03e5dcba41073f250c200016fb361d86": {
    "text": "大家决议明天休息。",
    "pinyin": "dà jiā jué yì míng tiān xiū xi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "decf77401fa1210676b6f9cda64a5c629e5c5dd17b35b2f64aaf8f6680b79e34": {
    "text": "我说：“他讲的冷笑话真让人哭笑不得。”",
    "pinyin": "wǒ shuō ： “ tā jiǎng de lěng xiào huà zhēn ràng rén kū xiào bù dé 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deff0720447a5ba58bc68f538692711858c1bf694c05f001b6b48ceb4d2a102c": {
    "text": "她说：“他手脚动得很快。”",
    "pinyin": "tā shuō ： “ tā shǒu jiǎo dòng de hěn kuài 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de92e1569467430fb872742654fcebc12dda261519ed9da9901335ccfb96b17a": {
    "text": "我有东西应急。",
    "pinyin": "wǒ yǒu dōng xi yìng jí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "dec912d84347ad90a489e3fc853143d000b371c2342f69cec70db663f9b0aff3": {
    "text": "我们共同学习汉语。",
    "pinyin": "wǒ men gòng tóng xué xí hàn yǔ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deb3305e76965997a3b3d2b9568002b855cbe3d1febdd703ba45a1f09b0af812": {
    "text": "我说：“你会用筷子吃饭吗？”",
    "pinyin": "wǒ shuō ： “ nǐ huì yòng kuài zi chī fàn ma ？ ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de43e5eacf5f455863d63c358920d76a7257f95266d70053c027bcbe1e4fbb48": {
    "text": "时间约束工作。",
    "pinyin": "shí jiān yuē shù gōng zuò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "defb0337a1f79b101e00055ac091062f343cd81ffd01ae73eee770e4d3681a2b": {
    "text": "这些东西没有实质。",
    "pinyin": "zhè xiē dōng xi méi yǒu shí zhì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de299eb946fcc9226605e6f37da53b25dafec4edf9bd23690b7fe88349aa5c2f": {
    "text": "调皮的学生在笑。",
    "pinyin": "tiáo pí de xué sheng zài xiào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deb8f240f5743959faac0b68b6b475cc20c4fb1e9475823d2de23d8bbfbc3972": {
    "text": "他已经是聘任员工。",
    "pinyin": "tā yǐ jīng shì pìn rèn yuán gōng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ded4838f00b95360271ea324f1dc74a1938201179d01879a66d480c7fd056b0d": {
    "text": "乡村的生活简单。",
    "pinyin": "xiāng cūn de shēng huó jiǎn dān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de6cc487a59f355a3793e3c5a4a317099acf70b730a088a6d3cad67fc56bee54": {
    "text": "门外传来声音。",
    "pinyin": "mén wài chuán lái shēng yīn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de5e89f2649faf9c6cc384767d26523927ec61a60ee36b467faa801cf5a627e1": {
    "text": "这位主妇管理家务。",
    "pinyin": "zhè wèi zhǔ fù guǎn lǐ jiā wù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de043c10b9cc76851af9c5ffd1a10ff80dde81b3e0494147c96410366facbb95": {
    "text": "她说：“我想咨询一下去火车站怎么走。”",
    "pinyin": "tā shuō ： “ wǒ xiǎng zī xún yī xià qù huǒ chē zhàn zěn me zǒu 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deff25c116d5638003aa02b1991fda8985eb08b8d8431e33a8ac564694ae53b9": {
    "text": "桌子上有一条虫子。",
    "pinyin": "zhuō zi shàng yǒu yī tiáo chóng zi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de181c6ed94f611fdc2e99ee19847b6560458a04c72fbbe3ec9f78cbf84a05c1": {
    "text": "请到柜台办理付款。",
    "pinyin": "qǐng dào guì tái bàn lǐ fù kuǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "def3202b9e3bdc5e27e98e64b78c60029630be66b60845ba5442e7c933f45c02": {
    "text": "这些箱子阻碍了交通。",
    "pinyin": "zhè xiē xiāng zi zǔ ài le jiāo tōng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de0fcef82a570c86040657a9f7c2cca5b53d6057016bfa97f70930d4abc657f1": {
    "text": "他们搬进了新的住宅。",
    "pinyin": "tā men bān jìn le xīn de zhù zhái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deccea130676aefbf29c67c617d7db9155dc40d6953a3bbfefec2945e8ad9f50": {
    "text": "一瞬间，我感到非常快乐。",
    "pinyin": "yī shùn jiān ， wǒ gǎn dào fēi cháng kuài lè 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de2b808d55c7437024750c5a9fbbc57c3b0ff4e7a8064dc120f94766adaf58ff": {
    "text": "优化物流供应链可以显著降低成本。",
    "pinyin": "yōu huà wù liú gōng yìng liàn kě yǐ xiǎn zhù jiàng dī chéng běn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "deb9241cb7cacd0ea83889c240347eabf1b15d16a44c4a93e1c8c3b1c5ac8196": {
    "text": "我们要储备很多水。",
    "pinyin": "wǒ men yào chǔ bèi hěn duō shuǐ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de89979079edabf7858994d93f324d281f1674e4583d4a68e9c75647cd0652bd": {
    "text": "我选拔好朋友。",
    "pinyin": "wǒ xuǎn bá hǎo péng you 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "de2136aa5fc572618971b8b3083935b50ec3e5a49cfac4373b5d97cfb2efa543": {
