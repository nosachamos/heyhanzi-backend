{
  "df54d57aadcbf665c472aa823c3014173de98e00f01ea38d07e6e2c19d19f268": {
    "text": "你下午想吃什么？",
    "pinyin": "nǐ xià wǔ xiǎng chī shén me ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df89c51453ff1ee55d43ab2aaff848870272dcaa37a827396b3bfe3b9fff6412": {
    "text": "她喜欢吃菜。",
    "pinyin": "tā xǐhuan chī cài 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df42528c107375424e1aacdebee5125ee5f8c93bb6893daffb0b983851322201": {
    "text": "我平常在家吃饭。",
    "pinyin": "wǒ píng cháng zài jiā chī fàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df21d55ab76eaa8c0cf9e7b9d8477d33a97b39c369d17b7c3713d4d473387777": {
    "text": "老师严格管教学生。",
    "pinyin": "lǎo shī yán gé guǎn jiào xué sheng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df8687838c6c9b8e6673e8c84f4cfac3f3c5d2ec4b87ce90853174288efb9d95": {
    "text": "我很肯定他能把工作做好，所以愿意请他来帮忙。",
    "pinyin": "wǒ hěn kěn dìng tā néng bǎ gōng zuò zuò hǎo ， suǒyǐ yuànyì qǐng tā lái bāngmáng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df0d0f4e4d0325d642b0ed2173d7301517e78f6f00931fab2deba737b982c4fe": {
    "text": "还是回家最保险。",
    "pinyin": "hái shi huí jiā zuì bǎo xiǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "dfdca7ce6815cb6502a0d973cc4b8fe0fe00f686a91e05614fad47d63e8cc256": {
    "text": "中国输出很多东西。",
    "pinyin": "zhōng guó shū chū hěn duō dōng xi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df3bff2ed85c510a4a103cac3840e99ef31733b773e93112347ae8c430de71b1": {
    "text": "香烟的味道很重。",
    "pinyin": "xiāng yān de wèi dao hěn zhòng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "dffd7d299681e0bb96297ad9e5dc6a9bd74d6198b2775b45276da1e641f32eb0": {
    "text": "桌子上剩下了一本书。",
    "pinyin": "zhuō zi shàng shèng xià le yī běn shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df734ad1f392d7c4efba8d5e554553f4fc5945bfede81c5a95a2fde564cddfb8": {
    "text": "那片水域非常安静。",
    "pinyin": "nà piàn shuǐ yù fēi cháng ān jìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "df3597a904a563ee4ec7fe45640a6ca75b4cd62fa4e19cda9f8b96fd07783f8d": {
    "text": "大家在遗址拍照。",
    "pinyin": "dà jiā zài yí zhǐ pāi zhào 。",
    "kind": "sentence",
    "quotedReadings": []
