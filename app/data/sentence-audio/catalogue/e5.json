{
  "e5ba67d5b360a12d840bf5f4846ebe1b665d714d565249cf448bb5fd4d8d48b4": {
    "text": "这时，他来了。",
    "pinyin": "zhè shí ， tā lái le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5992bfb0fbb8f74b780208fe40dea8e3a213e000a8cbd8cc9036e449cd6ad26": {
    "text": "你听见了吗？",
    "pinyin": "nǐ tīngjiàn le ma ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e58116dd87de6a0f4ebe2f2f83a826ba5ce5919d9171552617c4131b168863d1": {
    "text": "大家先后进来了。",
    "pinyin": "dà jiā xiān hòu jìn lái le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5c6e5f9cbde9de8c91df64523000636ceaa40e1f97a76b9488e426548a55c2b": {
    "text": "外界对我们很好奇。",
    "pinyin": "wài jiè duì wǒ men hěn hào qí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e593d059ddc39622c71cbb8be7b4a0d012e4d9e92c618ee5206a0fd700375684": {
    "text": "他在处理商务。",
    "pinyin": "tā zài chǔ lǐ shāng wù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5b28ef2a47083221ea39ca07ea8bf272046d9f57f371386b8d20885334317c9": {
    "text": "他们有共同的梦想。",
    "pinyin": "tā men yǒu gòng tóng de mèng xiǎng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e55aac735c5bae14d1fa1cfb1cedfa75b566b9c0c1596a86c41ad699b8511c85": {
    "text": "我们的想法完全符合。",
    "pinyin": "wǒ men de xiǎng fǎ wán quán fú hé 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5a9972fc8c7d46215b7ecc7e1c605d44339ddeb53df87e06db5ca38512b8171": {
    "text": "他处在危险之中。",
    "pinyin": "tā chǔ zài wēi xiǎn zhī zhōng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e58a4ae6edf25af892a3845699564cb785ce275c7771c29675363622063ea816": {
    "text": "他们两个是对象。",
    "pinyin": "tā men liǎng gè shì duì xiàng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5f9aec146cb0c3dd2ddf3d3c8281fc6b8f9e34706e8d4e7ff4d614969bf0232": {
    "text": "自由往往伴随着责任。",
    "pinyin": "zì yóu wǎng wǎng bàn suí zhe zé rèn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e51898f0fad1251b0c77a3fde48d21405aaaa9f25b002caa02049f941c591178": {
    "text": "他拥有狂热的兴趣。",
    "pinyin": "tā yōng yǒu kuáng rè de xìng qù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5ccc7664f50685ae35ef45629921f5682ef3626b5b0208f1ee2c0912ece0bdd": {
    "text": "这本书的魅力是什么？",
    "pinyin": "zhè běn shū de mèi lì shì shén me ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e546ee5c621f62537de798cc4c41d3504fea148c24223a1344f8e5ab4d530365": {
    "text": "他正在院子里烧烤鸡翅。",
    "pinyin": "tā zhèng zài yuàn zi lǐ shāo kǎo jī chì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e588197847ad2441f8e762022a084f087af0ddb76c107a4abeded963b8c2fe7b": {
    "text": "这个病症需要吃药。",
    "pinyin": "zhè gè bìng zhèng xū yào chī yào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e5367ea2a488603e62cb2a5c27a0574a66ab2e0c81cc939d8c68cb400b248ee1": {
    "text": "他们通过各种渠道收集情报。",
    "pinyin": "tā men tōng guò gè zhǒng qú dào shōu jí qíng bào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "e524ed6aca515ed068e2633bd435ba38b38b593f40ab5a6dc67e55408c46f132": {
    "text": "爷爷一辈子都爱好京剧。",
    "pinyin": "yé ye yī bèi zi dōu ài hào jīng jù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
