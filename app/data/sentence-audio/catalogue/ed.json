{
  "edc5629609c63e362613c5d727eda32c9e4f2edb9c36266e49ba2be4c32cfcf9": {
    "text": "你怎么样？",
    "pinyin": "nǐ zěnmeyàng ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edcc72661dba5bdc5dc3182a2da84f53b29dea09699e4219a83d01e8d1d79fdc": {
    "text": "他在我前面。",
    "pinyin": "tā zài wǒ qiánmiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edfba96e783504dfacc08b272d034984ca4162a36b3d4e703686285e39b29ac8": {
    "text": "他还在病房休息。",
    "pinyin": "tā hái zài bìng fáng xiū xi 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ede06fb02081656483e00ae656a3ca33715a376275fdea0b732734028c802a53": {
    "text": "你留下来帮我吧。",
    "pinyin": "nǐ liú xià lái bāng wǒ ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edd0676d175ca23b54936db9e9f89390ef60da70ece9ac40c2986ad19ad34931": {
    "text": "请你比较这两本书。",
    "pinyin": "qǐng nǐ bǐ jiào zhè liǎng běn shū 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edd282e04a7d4df88c76bf9e0d4651f76bd2e0dc17bf77cbd598fa37685a0bad": {
    "text": "这是什么的来历？",
    "pinyin": "zhè shì shén me de lái lì ？",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed72f839dc8e83ffd7d6e25dac19ce1e67263d5c2432090611da3354b8e1140b": {
    "text": "我看得很清楚。",
    "pinyin": "wǒ kàn de hěn qīngchu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed3ab0d068f4397f82c7e4eabc6f75a0caee30dd8704dd140c9789935564a882": {
    "text": "学校今天迎来很多老师。",
    "pinyin": "xué xiào jīn tiān yíng lái hěn duō lǎo shī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edbf3e0a271490fb98ccee36070f170f59ad2113b96bea8ea86f85ee2d81a338": {
    "text": "我不要了，算了。",
    "pinyin": "wǒ bù yào le ， suàn le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed246595c2b8603e032b00fd757d0776888bd959eceb44ad535cdf1e63fb7715": {
    "text": "这个办法不行，我们再尝试别的办法吧。",
    "pinyin": "zhè ge bàn fǎ bù xíng ， wǒ men zài cháng shì bié de bàn fǎ ba 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed637bd64d65010d9d8544fe3468799f821db9ef67a3587e671d83a87952914b": {
    "text": "我喜欢吃香蕉。",
    "pinyin": "wǒ xǐhuan chī xiāngjiāo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ede79175cf1c6247c1510a4e0cb39555d8aeac3c51be0fc7cca84bdd864d4f2e": {
    "text": "我的车在停车场。",
    "pinyin": "wǒ de chē zài tíng chē chǎng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed9b5738c85db40bdc921195339449045b773e5bcbf6b5833e1eb7ade9d4301a": {
    "text": "我在观看电视。",
    "pinyin": "wǒ zài guān kàn diàn shì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed59bcb444cce62955ff0dc8a819bf7a6745cc9239fc7f326b7c61d22eb56535": {
    "text": "手机支付非常方便。",
    "pinyin": "shǒu jī zhī fù fēi cháng fāng biàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed40032b9400101d6d703f46dce5b730e3500f7a0e5657e7883b967fb8001429": {
    "text": "寒流突如其来。",
    "pinyin": "hán liú tū rú qí lái 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed0f163bb6f9259d1dbe9df1a3d154deaa5616487ec82ef3e9ee86a5defdcf4e": {
    "text": "老师促成我们一起学习。",
    "pinyin": "lǎo shī cù chéng wǒ men yī qǐ xué xí 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed531b3a4b1aa65c956646a2774edfb8cab0d640159d251b4487b1c6e912efa4": {
    "text": "他接到了命令。",
    "pinyin": "tā jiē dào le mìng lìng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed80549f867f8518bcdbcfecf7b44c87bf6a15138e16741e0099509794622776": {
    "text": "学校恢复了上课。",
    "pinyin": "xué xiào huī fù le shàng kè 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed768f63369a900a4561ced0d235542da1579ba436a3078ffc3b21f927cfd7e2": {
    "text": "衣服当日被晒干。",
    "pinyin": "yī fu dàng rì bèi shài gān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ede45d0bd793d7cdab0e16b19b5021a03e1bfa590886bf86eae7f3182ca87653": {
    "text": "这次活动因为天气原因被删除了。",
    "pinyin": "zhè cì huó dòng yīn wèi tiān qì yuán yīn bèi shān chú le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed189ed276e775910f1bb4008e8044a163c0c42f615e6a6225474d2b0b4623f8": {
    "text": "这家店的东西档次很高，价格也不低。",
    "pinyin": "zhè jiā diàn de dōng xi dàng cì hěn gāo ， jià gé yě bù dī 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edc122e0e9c236218502140eb539990b4b25681f8141c8136dda3eff919cdb5d": {
    "text": "路上碰到下雨了。",
    "pinyin": "lù shang pèng dào xià yǔ le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed20e34ffb841c307160f45253f14c8ff46eefd11bf07914a6cdef302f87e2a2": {
    "text": "唯独这本书很好看。",
    "pinyin": "wéi dú zhè běn shū hěn hǎo kàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ede96d9746a13088b99d9f395cc268ac324b05217c0a56e88294fc008fb4b67c": {
    "text": "他把房子抵押了。",
    "pinyin": "tā bǎ fáng zi dǐ yā le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "edb8d81c0a2efac8f6ca11e7e5f996ffb9819310c1d0b4047121cf8a5a97526a": {
    "text": "她有一个善良的心肠。",
    "pinyin": "tā yǒu yī gè shàn liáng de xīn cháng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ed54c110d0c10cfaff5eb2b999329ab6a533b2fdde99ad8f8a20e307dcb24285": {
    "text": "他刚煮好咖啡，客厅里就弥漫着咖啡的气味。",
    "pinyin": "tā gāng zhǔ hǎo kā fēi ， kè tīng lǐ jiù mí màn zhe kā fēi de qì wèi 。",
    "kind": "sentence",
    "quotedReadings": []
