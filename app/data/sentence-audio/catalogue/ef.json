    "kind": "sentence",
    "quotedReadings": []
  },
  "ef552c398731a329c1d75d6cc75625cf2672234f366e37a1a5c92886c481220f": {
    "text": "请睁开眼睛。",
    "pinyin": "qǐng zhēng kāi yǎnjing 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efe440248a3a91afed49442b14d51c3fb2ec090833e7296b6dab9f424ae112f1": {
    "text": "大家认为这个名字很吉祥，都愿意用它。",
