    "quotedReadings": []
  },
  "ef02dededc3c1d3d9b6183d3d2c398ab8f52cbf4e85b44f2ed63a5064a92a46a": {
    "text": "为了过冬，蚂蚁储存了食物。",
    "pinyin": "wèi le guò dōng ， mǎ yǐ chǔ cún le shí wù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
