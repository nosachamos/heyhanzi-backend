{
  "efacfb3e4f5815d4286aead2e6fc23ccd458ebce5c40d046418620fd1fcff566": {
    "text": "她说：“这些是我的。”",
    "pinyin": "tā shuō ： “ zhèxiē shì wǒ de 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efa5e6011604f3c0f038d72c175750508031723140652be09ca3af72abbd0f5e": {
    "text": "她说：“他几岁？”",
    "pinyin": "tā shuō ： “ tā jǐ suì ？ ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef41c825519d7234228f78fe78becc2959b0f5881f77c2696dc6120e76b1d703": {
    "text": "请休息一会儿。",
    "pinyin": "qǐng xiū xi yī huì r 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef184d9c4d6e72053c1c5a3729a705699d6da489a38e90b16fdee80878112a19": {
    "text": "我说：“我六点回家。”",
    "pinyin": "wǒ shuō ： “ wǒ liù diǎn huí jiā 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef442e1eeb4a93549190ba79270aa8cd345f5407a8b6fccf16bf690161496ba4": {
    "text": "她经常看中文小说。",
    "pinyin": "tā jīng cháng kàn zhòng wén xiǎo shuō 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efce2fec2b29234848ec64b64c49d359a2d9f2ab770d5cde620cce826e77927c": {
    "text": "我很知足，有家就好。",
    "pinyin": "wǒ hěn zhī zú ， yǒu jiā jiù hǎo 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "effbf8dd0eeac3dc0cb9f2e26fd30965c9e5eda41ec28cc277dd642d4b5eace4": {
    "text": "这个工作需要两个人，我想请你来帮我。",
    "pinyin": "zhè ge gōng zuò xū yào liǎng gè rén ， wǒ xiǎng qǐng nǐ lái bāng wǒ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "effd51fda028a11dce8fd6fd861474f269ead165561ee34b2d81c80c61463b2a": {
    "text": "睡觉以前要刷牙。",
    "pinyin": "shuì jiào yǐ qián yào shuā yá 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef9862c636bfe24760cec55a69406393b24fcf9db11bab908fb94bba51a29a1a": {
    "text": "夏天的天气很热。",
    "pinyin": "xià tiān de tiān qì hěn rè 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef6768c44aaea2690a9c5e9a5ee932011cff3b38d41a8e1dba9aa40bb563a80b": {
    "text": "我不料妈妈在学校。",
    "pinyin": "wǒ bù liào mā ma zài xué xiào 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef6bc5b64b6a352b4a839f1a4c34fda23dbab3e61f381a8db8dddbf57988f78e": {
    "text": "外面迟迟没有声音。",
    "pinyin": "wài miàn chí chí méi yǒu shēng yīn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efb4e07c1e29f71a8b2236b05fd76d9199a751a16be3da8a9f3d5ecc00403e67": {
    "text": "她说：“爷爷的心脏病突然发作了。”",
    "pinyin": "tā shuō ： “ yé ye de xīn zàng bìng tū rán fā zuò le 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef6b03e6ce3b015f0109cf7cbbcf342daa68cc81731111ffaa3eaa3ca51024a7": {
    "text": "这种电脑技能很难。",
    "pinyin": "zhè zhǒng diàn nǎo jì néng hěn nán 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef672809876a5dd51da5bb70f84608cdec6c6f05c00a3803e14fba83666a2bab": {
    "text": "保持你的动作。",
    "pinyin": "bǎo chí nǐ de dòng zuò 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef133c94e25f239421373df5fd17249aca4f3864c078d259523cedd1166803a0": {
    "text": "我的工作压力很大。",
    "pinyin": "wǒ de gōng zuò yā lì hěn dà 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef081dda33292dc76369f1b890fe50112094d74b5dd92ad85a21911f414804d9": {
    "text": "他总是表现出优越感。",
    "pinyin": "tā zǒng shì biǎo xiàn chū yōu yuè gǎn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef0c3262a1cbb2f8e9af4e3b9625b679b41ebe5737fbb9ff734f26321906bf98": {
    "text": "他在写一本专著。",
    "pinyin": "tā zài xiě yī běn zhuān zhù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efe8b96e37a7eccb9241d8fc04e40f9cb485a2b1a997491147083dc2c8ddd5e2": {
    "text": "你不要浪费时间。",
    "pinyin": "nǐ bù yào làng fèi shí jiān 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efb66dfaceecf8d0816d88ec06c07157fe26ca246752859e5f890d060b1dea93": {
    "text": "听说他家里有背景。",
    "pinyin": "tīng shuō tā jiā lǐ yǒu bèi jǐng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efc10f4fe38ddca449cb51a100b89d59579dc186c20bba944952e3d048b44574": {
    "text": "会议请了专业的翻译。",
    "pinyin": "huì yì qǐng le zhuān yè de fān yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef0ea40e1ff4125891febe2fca033eb4a2bf6772bec34af6cc56f1dbea50673b": {
    "text": "我们去公园观赏风景。",
    "pinyin": "wǒ men qù gōng yuán guān shǎng fēng jǐng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef4831c97e9edba577eff1c926e39b817bfc97e458ca2c790dbd0044155e0c58": {
    "text": "桌子之间的间隔太小了。",
    "pinyin": "zhuō zi zhī jiān de jiàn gé tài xiǎo le 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef8f8af1ac26da1a9874b4fbfc36ab6e26a3b7c70fdedf0b69ad3897d397ea7e": {
    "text": "我删除了昨天的文件。",
    "pinyin": "wǒ shān chú le zuótiān de wénjiàn 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef0f2215abb58efdc454e6e825f945063ccefd106f7371a31b7816df5ebf5a1f": {
    "text": "我下载了一个应用。",
    "pinyin": "wǒ xià zǎi le yī gè yìng yòng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef2a62ffa2e0487138e6d2046af65ae9f4304dc5030058c963fe934225013265": {
    "text": "这双鞋是用橡皮做的。",
    "pinyin": "zhè shuāng xié shì yòng xiàng pí zuò de 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef1e3a808409645e41f61627ecf48fb6e9a3456183a8c5013abab9e5052ebc0c": {
    "text": "这是解决问题的唯一办法。",
    "pinyin": "zhè shì jiě jué wèn tí de wéi yī bàn fǎ 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "efa4fb4992e6c64467dfb2056fffd9734892b2a29139b708c97e53bdfff92e02": {
    "text": "这双运动鞋非常透气。",
    "pinyin": "zhè shuāng yùn dòng xié fēi cháng tòu qì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef305ab252145664fda733702de0e1840cdcc8ba5f11be3f2da89bed43ee4e9d": {
    "text": "互联网技术日新月异。",
    "pinyin": "hù lián wǎng jì shù rì xīn yuè yì 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef37fbf2ceef504920a868df05e9fae4a2bf8f3461da07cfdb87d4a6d757086b": {
    "text": "公司决定贷款给员工。",
    "pinyin": "gōng sī jué dìng dài kuǎn gěi yuán gōng 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef6b65d9b4b4e7d34f9b857511722574cbdf4215d6c7b16a324c3e8fb9f7c219": {
    "text": "我们要遵守职业道德准则。",
    "pinyin": "wǒ men yào zūn shǒu zhí yè dào dé zhǔn zé 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef3034e0d10d4bed90e0baae975e462be46a6d60bbde6031f6e11b1d49318a27": {
    "text": "她说：“我们去参观故宫。”",
    "pinyin": "tā shuō ： “ wǒmen qù cānguān gù gōng 。 ”",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef9cc325bc44cc1ff6ba8bab8a0d2af9869b00f2457a50bf14a34e3b57e7383c": {
    "text": "他经常出入这栋大楼。",
    "pinyin": "tā jīng cháng chū rù zhè dòng dà lóu 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef60c08893962b12b96c49d158ad9d2a56cad1f46b1cdcbb2fd59de8e23b80a6": {
    "text": "老师有好的声誉。",
    "pinyin": "lǎo shī yǒu hǎo de shēng yù 。",
    "kind": "sentence",
    "quotedReadings": []
  },
  "ef11c942520c51ad21f6707d3f54ca6733637fc156b63c95339380391c730858": {
    "text": "细菌能分解垃圾。",
